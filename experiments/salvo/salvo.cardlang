// Salvo — the base game of DESIGN.md (staged-alternating encoding).
//
// Two players fight over three location cards dealt face up. Each location's
// rank is a target (a committed card is worth 13 minus its distance to the
// target) and its suit is an affinity (+3 per matching card). Six rounds:
// both players draw, then each in turn stages up to two cards face down at
// locations of their choice; all staged cards flip together at round end.
// A player may never hold more than FOUR cards at one location (staged plus
// flipped — Snap's per-side cap; the guard on the commit vocabulary), and a
// player who commits FEWER THAN TWO cards in a round draws one extra card at
// round end (the recon draw — restraint buys card advantage; REPORT.md
// section 8 is the evidence this rule is what makes the count a decision).
// An army also scores for its own structure — pairs, runs, flushes. Highest
// army total takes a location; most locations wins, grand total breaks ties
// (encoded as final = locations * 1000 + total).
//
// Deliberate encoding choices (per DESIGN.md):
//
// - STAGED-ALTERNATING COMMITS, not pure-sealed simultaneity. The sealed
//   `each player simultaneously:` body is one fixed-destination chosen
//   movement (decisions.md, "Simultaneous moves and atomic effect"), which
//   cannot carry a per-card destination choice, so the commit runs on the
//   sequential offer machinery in Cheat's per-option-move_type pattern.
//   Within a round the second committer sees the first's staging COUNTS
//   (where and how many, never what) — the existence-only channel Marvel
//   Snap itself shows as face-down card-backs at locations. Initiative
//   alternates each round to balance the information edge.
// - COMBO SCORING IS A DECLARED PRIMITIVE. The bonus an army's own structure
//   earns (of-a-kind, run, flush — DESIGN.md's table) is a combination count
//   the DSL has no combinator for, so it is the Primitive `salvo_combos`,
//   declared in this game's own `primitives { }` block and implemented in
//   `cardlang/runtime/salvo.py`. It migrates into the language when the
//   `combinations` construct lands (docs/design-notes/combination-scoring.md).
// - JOKERS RIDE THE DECK. `standard54` carries two; a joker is a flat perfect
//   hit at any location (the `loc_value` branch), matches no affinity suit,
//   and joins no combo.
//
// The staged piles are HiddenPile<player> — identity to the owner, a bare
// count to the opponent — so the flip is just a movement to the public
// armies; no reveal choreography is needed.

game Salvo {

  players: 2
  direction: clockwise
  max_length: 300

  cards: standard54
  // The natural ranks are the linear aces-low scale `dist` reads: A=1 .. K=13
  // by index delta, and only deltas matter, so Joker at the head shifts
  // nothing. Joker sits outside the scale — `loc_value` branches on the joker
  // suit before `dist` ever sees it — and is listed because every rank the
  // deck holds must be ranked to be strength-read at all.
  ranking: Joker K Q J 10 9 8 7 6 5 4 3 2 A

  // `salvo_combos(p, loc)` is the bonus `p`'s army at `loc` earns for its own
  // structure. `loc` is 0/1/2 for locations a/b/c — the mapping the Integer
  // type cannot show. The reads are the three army families and nothing else:
  // a combo is pure army structure, and the rank order the runs need arrives
  // as an engine fact, which a `reads` clause does not spell.
  primitives {
    salvo_combos(p : Player, loc : Integer) : Integer
        reads army_a[p], army_b[p], army_c[p]
  }

  zones {
    deck             : Deck
    location_a       : Discard             // the three location cards, face up
    location_b       : Discard
    location_c       : Discard
    hand[player]     : Hand<player>
    staged_a[player] : HiddenPile<player>  // this round's commits: owner sees
    staged_b[player] : HiddenPile<player>  //   identity, the opponent a count —
    staged_c[player] : HiddenPile<player>  //   Snap's card-backs at a location
    army_a[player]   : PlayerPile<player>  // flipped commits, public forever
    army_b[player]   : PlayerPile<player>
    army_c[player]   : PlayerPile<player>
  }

  state {
    round_no          : Integer = 0
    first_mover       : Player  = 0     // round initiative, alternates
    committer         : Player  = 0     // whose commit window is open
    committed         : Integer = 0     // commits made in the open window
    commit_open       : Boolean = false
    commits_r[player] : Integer = 0     // this round's commit count, for recon
    pts_a[player]     : Integer = 0     // army totals, computed at settle
    pts_b[player]     : Integer = 0
    pts_c[player]     : Integer = 0
    locs_won[player]  : Integer = 0
    final[player]     : Integer = 0
  }

  phase setup {
    shuffle deck
    // Locations are joker-free: a joker broadcasts no target rank and no
    // affinity suit, so it can set no location. This filtered draw IS
    // DESIGN.md's set-aside-replace-reshuffle rule — both leave the locations
    // joker-free and the residual deck a uniform shuffle of everything else.
    move one card from deck where card.suit is not joker to location_a
    move one card from deck where card.suit is not joker to location_b
    move one card from deck where card.suit is not joker to location_c
    deal 5 cards from deck to hand[0]
    deal 5 cards from deck to hand[1]
  }

  phase play {
    repeat until round_no is 6 {
      // Both draw at round start.
      draw 1 card from deck to hand[first_mover]
      draw 1 card from deck to hand[the player where player is not first_mover]

      // First commit window.
      committer := first_mover
      committed := 0
      commit_open := true
      repeat until (not commit_open) or (committed is 2) {
        offer to committer one of [commit_a, commit_b, commit_c, hold]
      }
      commits_r[committer] := committed

      // Second commit window: this player has seen the staging counts.
      committer := the player where player is not first_mover
      committed := 0
      commit_open := true
      repeat until (not commit_open) or (committed is 2) {
        offer to committer one of [commit_a, commit_b, commit_c, hold]
      }
      commits_r[committer] := committed

      // The flip: every staged card goes public at once.
      for each player p: move all cards from staged_a[p] to army_a[p]
      for each player p: move all cards from staged_b[p] to army_b[p]
      for each player p: move all cards from staged_c[p] to army_c[p]

      // Recon: a round of restraint earns an extra card.
      if commits_r[0] < 2 { draw 1 card from deck to hand[0] }
      if commits_r[1] < 2 { draw 1 card from deck to hand[1] }

      first_mover := the player where player is not first_mover
      round_no += 1
    }
  }

  phase settle {
    for each player p: pts_a[p] := (sum of loc_value(card, top_of(location_a)) over cards in army_a[p]) + salvo_combos(p, 0)
    for each player p: pts_b[p] := (sum of loc_value(card, top_of(location_b)) over cards in army_b[p]) + salvo_combos(p, 1)
    for each player p: pts_c[p] := (sum of loc_value(card, top_of(location_c)) over cards in army_c[p]) + salvo_combos(p, 2)

    if pts_a[0] > pts_a[1] { locs_won[0] += 1 } else { if pts_a[1] > pts_a[0] { locs_won[1] += 1 } }
    if pts_b[0] > pts_b[1] { locs_won[0] += 1 } else { if pts_b[1] > pts_b[0] { locs_won[1] += 1 } }
    if pts_c[0] > pts_c[1] { locs_won[0] += 1 } else { if pts_c[1] > pts_c[0] { locs_won[1] += 1 } }

    // Tie ladder as one number: locations dominate, grand total breaks ties
    // (a grand total is bounded well under 1000).
    for each player p: final[p] := (locs_won[p] * 1000) + pts_a[p] + pts_b[p] + pts_c[p]
  }

  winner: highest final
}

// Distance between a card's rank and the location's target rank on the
// linear aces-low scale. No wraparound: extreme targets are the point.
function dist(c : Card, l : Card) = if rank_value(c) >= rank_value(l) then rank_value(c) - rank_value(l) else rank_value(l) - rank_value(c)

// A committed card's worth at a location: proximity (13 for a bullseye down
// to 1 for the farthest miss) plus the affinity bonus for a matching suit. A
// joker is a flat perfect hit and takes no affinity — its suit matches no
// location's, since a location is never a joker.
function loc_value(c : Card, l : Card) = if c.suit is joker then 13 else (13 - dist(c, l)) + (if c.suit is l.suit then 3 else 0)

// --- commit vocabulary: one move_type per location, Cheat's pattern ---
// The hidden card pick is the in-effect chosen movement; WHICH location
// (the move_type itself) is public the moment it happens, as staging counts.

move_type commit_a {
  when: (hand[actor] is not empty)
        and ((number of cards in staged_a[actor]) + (number of cards in army_a[actor]) < 4)
  effect {
    move chosen 1 card from hand[actor] to staged_a[actor]
    committed += 1
  }
}

move_type commit_b {
  when: (hand[actor] is not empty)
        and ((number of cards in staged_b[actor]) + (number of cards in army_b[actor]) < 4)
  effect {
    move chosen 1 card from hand[actor] to staged_b[actor]
    committed += 1
  }
}

move_type commit_c {
  when: (hand[actor] is not empty)
        and ((number of cards in staged_c[actor]) + (number of cards in army_c[actor]) < 4)
  effect {
    move chosen 1 card from hand[actor] to staged_c[actor]
    committed += 1
  }
}

// Close the window early: commit fewer than two, or nothing at all.
move_type hold {
  effect {
    commit_open := false
  }
}
