// Salvo — round-1 encoding of the original design in DESIGN.md.
//
// Two players fight over three location cards dealt face up. Each location's
// rank is a target (a committed card is worth 13 minus its distance to the
// target) and its suit is an affinity (+3 per matching card). Six rounds:
// both players draw, then each in turn stages up to two cards face down at
// locations of their choice; all staged cards flip together at round end.
// Highest army total takes a location; most locations wins, grand total
// breaks ties (encoded as final = locations * 1000 + total).
//
// Round-1 reductions, deliberate (all recorded in DESIGN.md):
//
// - STAGED-ALTERNATING COMMITS, not pure-sealed simultaneity. The sealed
//   `each player simultaneously:` body is one fixed-destination chosen
//   movement (decisions.md, "Simultaneous moves and atomic effect"), which
//   cannot carry a per-card destination choice, so the commit runs on the
//   sequential offer machinery in Cheat's per-option-move_type pattern.
//   Within a round the second committer sees the first's staging COUNTS
//   (where and how many, never what) — the existence-only channel Marvel
//   Snap itself shows as face-down card-backs at locations. Initiative
//   alternates each round to balance the information edge.
// - NO COMBOS yet: cribbage-style combination scoring lives in a registered
//   stdlib primitive, not in-DSL combinators; a salvo primitive is round-2
//   work. Base-game sims isolate the interaction question first (combos are
//   self-synergy — if the base game is double solitaire, combos worsen it).
// - NO JOKERS yet: they ride the same round-2 change.
//
// The staged piles are HiddenPile<player> — identity to the owner, a bare
// count to the opponent — so the flip is just a movement to the public
// armies; no reveal choreography is needed.

game Salvo {

  players: 2
  direction: clockwise
  max_length: 300

  cards: standard52
  ranking: aces low                // A=0 .. K=12; dist() reads this scale

  zones {
    deck             : Deck
    location_a       : Discard             // the three location cards, face up
    location_b       : Discard
    location_c       : Discard
    hand[player]     : Hand<player>
    staged_a[player] : HiddenPile<player>  // this round's commits: owner sees
    staged_b[player] : HiddenPile<player>  //   identity, the opponent a count —
    staged_c[player] : HiddenPile<player>  //   Snap's card-backs at a location
    army_a[player]   : PlayerPile<player>  // flipped commits, public forever
    army_b[player]   : PlayerPile<player>
    army_c[player]   : PlayerPile<player>
  }

  state {
    round_no         : Integer = 0
    first_mover      : Player  = 0     // round initiative, alternates
    committer        : Player  = 0     // whose commit window is open
    committed        : Integer = 0     // commits made in the open window
    commit_open      : Boolean = false
    pts_a[player]    : Integer = 0     // army totals, computed at settle
    pts_b[player]    : Integer = 0
    pts_c[player]    : Integer = 0
    locs_won[player] : Integer = 0
    final[player]    : Integer = 0
  }

  phase setup {
    shuffle deck
    move one card from deck to location_a
    move one card from deck to location_b
    move one card from deck to location_c
    deal 5 cards from deck to hand[0]
    deal 5 cards from deck to hand[1]
  }

  phase play {
    repeat until round_no is 6 {
      // Both draw at round start.
      draw 1 card from deck to hand[first_mover]
      draw 1 card from deck to hand[the player where player is not first_mover]

      // First commit window.
      committer := first_mover
      committed := 0
      commit_open := true
      repeat until (not commit_open) or (committed is 2) {
        offer to committer one of [commit_a, commit_b, commit_c, hold]
      }

      // Second commit window: this player has seen the staging counts.
      committer := the player where player is not first_mover
      committed := 0
      commit_open := true
      repeat until (not commit_open) or (committed is 2) {
        offer to committer one of [commit_a, commit_b, commit_c, hold]
      }

      // The flip: every staged card goes public at once.
      for each player p: move all cards from staged_a[p] to army_a[p]
      for each player p: move all cards from staged_b[p] to army_b[p]
      for each player p: move all cards from staged_c[p] to army_c[p]

      first_mover := the player where player is not first_mover
      round_no += 1
    }
  }

  phase settle {
    for each player p: pts_a[p] := sum of loc_value(card, top_of(location_a)) over cards in army_a[p]
    for each player p: pts_b[p] := sum of loc_value(card, top_of(location_b)) over cards in army_b[p]
    for each player p: pts_c[p] := sum of loc_value(card, top_of(location_c)) over cards in army_c[p]

    if pts_a[0] > pts_a[1] { locs_won[0] += 1 } else { if pts_a[1] > pts_a[0] { locs_won[1] += 1 } }
    if pts_b[0] > pts_b[1] { locs_won[0] += 1 } else { if pts_b[1] > pts_b[0] { locs_won[1] += 1 } }
    if pts_c[0] > pts_c[1] { locs_won[0] += 1 } else { if pts_c[1] > pts_c[0] { locs_won[1] += 1 } }

    // Tie ladder as one number: locations dominate, grand total breaks ties
    // (a grand total is bounded well under 1000).
    for each player p: final[p] := (locs_won[p] * 1000) + pts_a[p] + pts_b[p] + pts_c[p]
  }

  winner: highest final
}

// Distance between a card's rank and the location's target rank on the
// linear aces-low scale. No wraparound: extreme targets are the point.
function dist(c : Card, l : Card) = if rank_value(c) >= rank_value(l) then rank_value(c) - rank_value(l) else rank_value(l) - rank_value(c)

// A committed card's worth at a location: proximity (13 for a bullseye down
// to 1 for the farthest miss) plus the affinity bonus for a matching suit.
function loc_value(c : Card, l : Card) = (13 - dist(c, l)) + (if c.suit is l.suit then 3 else 0)

// --- commit vocabulary: one move_type per location, Cheat's pattern ---
// The hidden card pick is the in-effect chosen movement; WHICH location
// (the move_type itself) is public the moment it happens, as staging counts.

move_type commit_a {
  when: hand[actor] is not empty
  effect {
    move chosen 1 card from hand[actor] to staged_a[actor]
    committed += 1
  }
}

move_type commit_b {
  when: hand[actor] is not empty
  effect {
    move chosen 1 card from hand[actor] to staged_b[actor]
    committed += 1
  }
}

move_type commit_c {
  when: hand[actor] is not empty
  effect {
    move chosen 1 card from hand[actor] to staged_c[actor]
    committed += 1
  }
}

// Close the window early: commit fewer than two, or nothing at all.
move_type hold {
  effect {
    commit_open := false
  }
}
