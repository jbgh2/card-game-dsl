// Green Lane V2b "delayed bounty" — the fairness patch for V2
// (v2-bounty.cardlang; baseline: ../green-lane.cardlang; design notes in
// ../DESIGN.md). Experiment, not corpus.
//
// ONE rule differs from V2: a bounty won on a false alarm is NOT spendable
// immediately — it lands in a public `pending` escrow and only becomes a
// live token at the end of the current PAIR of smuggling rounds, once both
// players have shipped. Fines are unchanged from V2 (false alarm 2,
// contraband 4); a contraband seizure still destroys the token outright.
//
// Why the delay: V2 measurably favoured P0 (game value +2.55 on the mini,
// exploitability residual 0.13). The within-pair order is fixed — P0 ships
// first in every pair — so a bounty P0 won in the pair's first half was
// spendable in the SAME pair's second half, while P1's bounty (won in the
// second half) only ever armed the following pair, and died worthless if
// won in the last pair. First-mover advantage via bounty freshness.
// Activating every bounty at the NEXT pair boundary, for BOTH players,
// equalizes freshness: a bounty won anywhere in pair k becomes spendable
// exactly at pair k+1 whoever won it, and a last-pair bounty is worthless
// for either player alike.
//
// `pending` is public, like `tokens` — deterrence is visible by design.
// Everything else is V2 exactly, which is the baseline exactly except the
// bounty rule: fixed public hands (2, 3, 4, 5, K, A of one suit each; K and
// A are contraband), no shuffle and no deal, the face-down shipment and the
// hidden warehouse are the only hidden information, cleared cards still
// score for the merchant, scoring stays zero-sum by construction, and with
// one card left the shipment is forced.

game GreenLaneV2bDelayedBounty {

  uses smuggling

  players: 2
  direction: clockwise
  max_length: 400

  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2

  zones {
    deck              : Deck
    dead              : Muck                  // the 40 out-of-play cards
    hand[player]      : Hand<player>          // goods still to ship
    shipment[player]  : HiddenPile<player>    // this round's face-down shipment
    warehouse[player] : HiddenPile<player>    // waved-through goods, concealed
    cleared[player]   : PlayerPile<player>    // inspected-legal goods, public
    seized[player]    : PlayerPile<player>    // contraband this player confiscated
  }

  state {
    tokens[player]   : Integer = 2   // live inspection tokens (public); bounties
                                     // arrive via `pending`, so a player can
                                     // still hold 0..4
    pending[player]  : Integer = 0   // bounty tokens awaiting next-pair activation
                                     // (public escrow; at most 1 accrues per pair)
    fine_net[player] : Integer = 0   // fines received minus fines paid
    merchant         : Player  = 0   // this round's shipper
    inspector        : Player  = 1   // this round's customs officer
    score[player]    : Integer = 0   // settled once, in scoring
  }

  phase setup {
    // Fixed public hands: the 2, 3, 4, 5 (legal; rank_value 0..3) and the
    // K, A (contraband; rank_value 11..12) of clubs for P0, spades for P1.
    move all cards from deck
         where card.suit is clubs and (rank_value(card) <= 3 or rank_value(card) >= 11)
         to hand[0]
    move all cards from deck
         where card.suit is spades and (rank_value(card) <= 3 or rank_value(card) >= 11)
         to hand[1]
    move all cards from deck to dead
  }

  phase play {
    // Twelve smuggling rounds, roles alternating. Hands shrink in lockstep,
    // so both empty together after six pairs. At each pair boundary the
    // escrowed bounties activate — for both players at once, so neither
    // side's bounty is ever fresher than the other's. (Activation must
    // credit tokens BEFORE the escrow is cleared; hence two passes.)
    repeat until hand[0] is empty and hand[1] is empty {
      merchant := 0
      inspector := 1
      run commit_shipment()
      run respond()
      merchant := 1
      inspector := 0
      run commit_shipment()
      run respond()
      for each player p: tokens[p] += pending[p]
      for each player p: pending[p] := 0
    }
  }

  phase scoring {
    // Goods total at card value (rank_value + 1, folded in as the zone count):
    // warehouse and cleared score for the player who shipped them; seized
    // score for the player who confiscated them.
    let goods0 = (sum of rank_value(card) over cards in warehouse[0])
               + (number of cards in warehouse[0])
               + (sum of rank_value(card) over cards in cleared[0])
               + (number of cards in cleared[0])
               + (sum of rank_value(card) over cards in seized[0])
               + (number of cards in seized[0])
    let goods1 = (sum of rank_value(card) over cards in warehouse[1])
               + (number of cards in warehouse[1])
               + (sum of rank_value(card) over cards in cleared[1])
               + (number of cards in cleared[1])
               + (sum of rank_value(card) over cards in seized[1])
               + (number of cards in seized[1])
    score[0] := goods0 - goods1 + fine_net[0] - fine_net[1]
    score[1] := goods1 - goods0 + fine_net[1] - fine_net[0]
  }

  winner: highest score
}

// The inspector's half of a smuggling round. The commit is the imported
// `commit_shipment` (docs/libraries/smuggling.cardlang), which the phase runs
// first. The inspector decides only while they hold a LIVE token — with none
// left the wave is automatic, and pending bounties do not count until they
// activate at the pair boundary. There is deliberately NO token-based gate on
// the merchant's side: shipping order during a disarmed window is a live
// strategic choice precisely because tokens can flow back.
procedure respond() {
  if tokens[inspector] > 0 {
    offer to inspector one of [inspect, wave]
  } else {
    move all cards from shipment[merchant] to warehouse[merchant]
  }
}

// Spend a token and open the crate. Contraband (K/A: rank_value >= 11) is
// seized and will score for the inspector, and the merchant is fined 4 —
// the token is destroyed. Legal goods clear publicly, the merchant is fined
// nothing and paid 2 by the inspector for the false alarm — and the spent
// token goes to the merchant's `pending` escrow, activating only at the
// next pair boundary (the V2b delta; V2 credited `tokens` immediately).
move_type inspect {
  when: tokens[actor] > 0   // backstop: the offer site in respond() gates on tokens
  effect {
    tokens[actor] -= 1
    reveal one card from shipment[merchant]
    if any card in shipment[merchant] where rank_value(card) >= 11 {
      move all cards from shipment[merchant] to seized[actor]
      fine_net[merchant] -= 4
      fine_net[actor] += 4
    } else {
      move all cards from shipment[merchant] to cleared[merchant]
      pending[merchant] += 1
      fine_net[merchant] += 2
      fine_net[actor] -= 2
    }
  }
}
