// Green Lane V2b "delayed bounty" MINI — the exactly-solvable variant of
// v2b-delayed-bounty.cardlang (V2 parent: v2-bounty-mini.cardlang; baseline
// mini: ../green-lane-mini.cardlang). Same shrink as the other minis: hands
// are the 2, 3 (legal) and A (contraband) of one suit each, ONE starting
// inspection token per player, six smuggling rounds total (three pairs).
//
// The V2b delta, exactly as in the full variant: a bounty won on a false
// alarm lands in a public `pending` escrow and only becomes a live token at
// the end of the current PAIR of smuggling rounds. Fines are V2's (false
// alarm 2, contraband 4; contraband still destroys the token). This
// equalizes bounty freshness between the players: in V2 the fixed
// within-pair order let P0 spend a first-half bounty in the SAME pair while
// P1's second-half bounty only armed the next pair — worth +2.55 to P0 on
// this mini. Here a bounty won anywhere in pair k activates at pair k+1 for
// either player, and a last-pair bounty is worthless for both alike.

game GreenLaneV2bDelayedBountyMini {

  players: 2
  direction: clockwise
  max_length: 200

  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2

  zones {
    deck              : Deck
    dead              : Muck                  // the 46 out-of-play cards
    hand[player]      : Hand<player>          // goods still to ship
    shipment[player]  : HiddenPile<player>    // this round's face-down shipment
    warehouse[player] : HiddenPile<player>    // waved-through goods, concealed
    cleared[player]   : PlayerPile<player>    // inspected-legal goods, public
    seized[player]    : PlayerPile<player>    // contraband this player confiscated
  }

  state {
    tokens[player]   : Integer = 1   // live inspection tokens (public); bounties
                                     // arrive via `pending`, so a player can
                                     // still hold 0..2
    pending[player]  : Integer = 0   // bounty tokens awaiting next-pair activation
                                     // (public escrow; at most 1 accrues per pair)
    fine_net[player] : Integer = 0   // fines received minus fines paid
    merchant         : Player  = 0   // this round's shipper
    inspector        : Player  = 1   // this round's customs officer
    score[player]    : Integer = 0   // settled once, in scoring
  }

  phase setup {
    // Fixed public hands: 2, 3 (legal; rank_value 0..1) and A (contraband;
    // rank_value 12) of clubs for P0, spades for P1.
    move all cards from deck
         where card.suit is clubs and (rank_value(card) <= 1 or rank_value(card) >= 12)
         to hand[0]
    move all cards from deck
         where card.suit is spades and (rank_value(card) <= 1 or rank_value(card) >= 12)
         to hand[1]
    move all cards from deck to dead
  }

  phase play {
    // Six smuggling rounds, roles alternating; hands shrink in lockstep. At
    // each pair boundary the escrowed bounties activate — for both players
    // at once, so neither side's bounty is ever fresher than the other's.
    // (Activation must credit tokens BEFORE the escrow is cleared; hence
    // two passes.)
    repeat until hand[0] is empty and hand[1] is empty {
      merchant := 0
      inspector := 1
      run smuggle_round()
      merchant := 1
      inspector := 0
      run smuggle_round()
      for each player p: tokens[p] += pending[p]
      for each player p: pending[p] := 0
    }
  }

  phase scoring {
    let goods0 = (sum of rank_value(card) over cards in warehouse[0])
               + (number of cards in warehouse[0])
               + (sum of rank_value(card) over cards in cleared[0])
               + (number of cards in cleared[0])
               + (sum of rank_value(card) over cards in seized[0])
               + (number of cards in seized[0])
    let goods1 = (sum of rank_value(card) over cards in warehouse[1])
               + (number of cards in warehouse[1])
               + (sum of rank_value(card) over cards in cleared[1])
               + (number of cards in cleared[1])
               + (sum of rank_value(card) over cards in seized[1])
               + (number of cards in seized[1])
    score[0] := goods0 - goods1 + fine_net[0] - fine_net[1]
    score[1] := goods1 - goods0 + fine_net[1] - fine_net[0]
  }

  winner: highest score
}

// One smuggling round for the current `merchant` / `inspector` — identical
// to the baseline's (see ../green-lane.cardlang for the commentary). The
// inspector decides only while they hold a LIVE token — pending bounties
// don't count until they activate at the pair boundary. No token-based gate
// on the merchant's side, deliberately: with token refunds, shipping order
// during a disarmed window is strategically live.
procedure smuggle_round() {
  if (number of cards in hand[merchant]) is 1 {
    move one card from hand[merchant] to shipment[merchant]
  } else {
    as merchant {
      move chosen 1 card from hand[merchant] to shipment[merchant]
    }
  }
  if tokens[inspector] > 0 {
    offer to inspector one of [inspect, wave]
  } else {
    move all cards from shipment[merchant] to warehouse[merchant]
  }
}

move_type wave {
  effect {
    move all cards from shipment[merchant] to warehouse[merchant]
  }
}

// V2b delta lives here and at the pair boundary in `play`: a false alarm
// escrows the spent token to the merchant's `pending` (activating next
// pair) and the fine is 2; contraband is unchanged (token destroyed,
// fine 4).
move_type inspect {
  when: tokens[actor] > 0   // backstop: the offer site in smuggle_round gates on tokens
  effect {
    tokens[actor] -= 1
    reveal one card from shipment[merchant]
    // Contraband: rank_value >= 12 — textually the same threshold as the
    // setup filter above, so the two sites cannot drift apart.
    if any card in shipment[merchant] where rank_value(card) >= 12 {
      move all cards from shipment[merchant] to seized[actor]
      fine_net[merchant] -= 4
      fine_net[actor] += 4
    } else {
      move all cards from shipment[merchant] to cleared[merchant]
      pending[merchant] += 1
      fine_net[merchant] += 2
      fine_net[actor] -= 2
    }
  }
}
