// Green Lane V4 "composed" MINI — the exactly-solvable shrink of
// v4-composed.cardlang: the V1 (impound) and V3 (graded contraband) deltas
// applied together to the baseline mini (parents: v1-impound-mini.cardlang
// and v3-graded-mini.cardlang; see ../DESIGN.md). Hands are the 2 (legal;
// card value 1) and the 7, A (BOTH contraband — the graded pair, card
// values 6 and 13) of one suit each, ONE inspection token per player, six
// smuggling rounds, fine 5, and inspected-legal goods are IMPOUNDED: face
// up in `cleared`, scoring NOBODY. Small enough for vanilla CFR and exact
// best response through the OpenSpiel adapter.
//
// The composed economics, relative to a wave: a caught 7 swings the margin
// by 22 (= 2*6 + 10), a caught A by 36 (= 2*13 + 10); a false alarm on the
// 2 destroys its 1 point of goods but hands the merchant the 10-point fine
// swing — +10 where a wave banks +1, so the single decoy is strictly
// PROFITABLE bait (net +9). Myopic inspect break-even beliefs: p > 9/45 =
// 0.20 when the A is what you'd catch, p > 9/31 ≈ 0.29 for the 7. Note the
// asymmetry impound inherits from the graded hand: with only one legal card
// the 2 is the ONLY card impound can ever touch — the 7 and A are seized
// (their value changes hands) exactly as in the baseline, and the
// contraband:token mix still inverts the baseline mini's (two grades
// against one token: the inspector catches at most one — which?).

game GreenLaneV4ComposedMini {

  uses smuggling

  players: 2
  direction: clockwise
  max_length: 200

  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2

  zones {
    deck              : Deck
    dead              : Muck                  // the 46 out-of-play cards
    hand[player]      : Hand<player>          // goods still to ship
    shipment[player]  : HiddenPile<player>    // this round's face-down shipment
    warehouse[player] : HiddenPile<player>    // waved-through goods, concealed
    cleared[player]   : PlayerPile<player>    // impound lot: inspected-legal goods, public, scores NOBODY
    seized[player]    : PlayerPile<player>    // contraband this player confiscated
  }

  state {
    tokens[player]   : Integer = 1   // one inspection for the whole game
    fine_net[player] : Integer = 0   // fines received minus fines paid
    merchant         : Player  = 0   // this round's shipper
    inspector        : Player  = 1   // this round's customs officer
    score[player]    : Integer = 0   // settled once, in scoring
  }

  phase setup {
    // Fixed public hands: 2 (legal; rank_value 0) and 7, A (contraband;
    // rank_value 5 and 12) of clubs for P0, spades for P1.
    move all cards from deck
         where card.suit is clubs and (rank_value(card) <= 0 or rank_value(card) is 5 or rank_value(card) is 12)
         to hand[0]
    move all cards from deck
         where card.suit is spades and (rank_value(card) <= 0 or rank_value(card) is 5 or rank_value(card) is 12)
         to hand[1]
    move all cards from deck to dead
  }

  phase play {
    // Six smuggling rounds, roles alternating; hands shrink in lockstep.
    repeat until hand[0] is empty and hand[1] is empty {
      merchant := 0
      inspector := 1
      run commit_shipment()
      run respond()
      merchant := 1
      inspector := 0
      run commit_shipment()
      run respond()
    }
  }

  phase scoring {
    // Warehouse scores for the shipper, seized for the confiscator, both at
    // card value (rank_value + 1, folded in as the zone count). The cleared
    // piles (impounded goods) score nobody — deliberately absent from these
    // sums; that IS the V1 half of the composition.
    let goods0 = (sum of rank_value(card) over cards in warehouse[0])
               + (number of cards in warehouse[0])
               + (sum of rank_value(card) over cards in seized[0])
               + (number of cards in seized[0])
    let goods1 = (sum of rank_value(card) over cards in warehouse[1])
               + (number of cards in warehouse[1])
               + (sum of rank_value(card) over cards in seized[1])
               + (number of cards in seized[1])
    score[0] := goods0 - goods1 + fine_net[0] - fine_net[1]
    score[1] := goods1 - goods0 + fine_net[1] - fine_net[0]
  }

  winner: highest score
}

// The inspector's half of a smuggling round; the commit is the imported
// `commit_shipment` (docs/libraries/smuggling.cardlang).
procedure respond() {
  if tokens[inspector] > 0 {
    offer to inspector one of [inspect, wave]
  } else {
    move all cards from shipment[merchant] to warehouse[merchant]
  }
}

// Spend the token and open the crate. Contraband (7/A) is seized and scores
// for the inspector, and the merchant is fined 5. The legal 2 is impounded:
// it lands face up in the merchant's cleared pile where it scores NOBODY,
// and the inspector pays the 5-point fine.
move_type inspect {
  when: tokens[actor] > 0   // backstop: the offer site in smuggle_round gates on tokens
  effect {
    tokens[actor] -= 1
    reveal one card from shipment[merchant]
    // Contraband: rank_value is 5 (the 7) or 12 (the A) — textually the same
    // disjunct as the setup filters above, so the two sites cannot drift.
    if any card in shipment[merchant] where rank_value(card) is 5 or rank_value(card) is 12 {
      move all cards from shipment[merchant] to seized[actor]
      fine_net[merchant] -= 5
      fine_net[actor] += 5
    } else {
      move all cards from shipment[merchant] to cleared[merchant]
      fine_net[merchant] += 5
      fine_net[actor] -= 5
    }
  }
}
