// Green Lane V4 "composed" — the V1 (impound) and V3 (graded contraband)
// deltas applied together to ../green-lane.cardlang (experiment, not corpus;
// see ../DESIGN.md and ../REPORT.md §8 for the parents). The two deltas edit
// disjoint rules text — V3 touches the hand mix and the contraband predicate,
// V1 the scoring sums and the fine literal — so each carries over unchanged:
//
//   From V3 (graded contraband): each hand is the 2, 3, 4, 5, 7, A of one
//   suit (card value = rank_value + 1, so 1/2/3/4/6/13); the 7 and the A are
//   contraband — two grades instead of the baseline's near-twin K/A. At
//   fine 5 a caught 7 swings the margin by 22 (= 2*6 + 10) and a caught A by
//   36 (= 2*13 + 10), relative to a wave.
//
//   From V1 (impound): inspected-legal goods are IMPOUNDED — they still land
//   face up in the merchant's cleared pile, but they score NOBODY — and the
//   fine is 5 (baseline 4). A false alarm hands the merchant the 10-point
//   fine swing but destroys the crate, so relative to a wave it nets the
//   merchant 10 - value: +9/+8/+7/+6 baiting with the 2/3/4/5. The cheapest
//   decoy is the best bait, and because the fine exceeds the dearest decoy's
//   value (4), no false alarm is ever net-negative for the merchant.
//
// Everything else is the baseline: 2 inspection tokens per player, twelve
// smuggling rounds with roles alternating, warehouse + seized scoring, the
// forced last shipment, public tokens and fines, no bounty. Note the
// asymmetry the composition creates: impound touches only legal goods, so
// only the decoys (2/3/4/5) can be destroyed — contraband is seized (its
// value changes hands) exactly as in the baseline.

game GreenLaneV4Composed {

  uses smuggling

  players: 2
  direction: clockwise
  max_length: 400

  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2

  zones {
    deck              : Deck
    dead              : Muck                  // the 40 out-of-play cards
    hand[player]      : Hand<player>          // goods still to ship
    shipment[player]  : HiddenPile<player>    // this round's face-down shipment
    warehouse[player] : HiddenPile<player>    // waved-through goods, concealed
    cleared[player]   : PlayerPile<player>    // impound lot: inspected-legal goods, public, scores NOBODY
    seized[player]    : PlayerPile<player>    // contraband this player confiscated
  }

  state {
    tokens[player]   : Integer = 2   // inspections left (public — deterrence is visible)
    fine_net[player] : Integer = 0   // fines received minus fines paid
    merchant         : Player  = 0   // this round's shipper
    inspector        : Player  = 1   // this round's customs officer
    score[player]    : Integer = 0   // settled once, in scoring
  }

  phase setup {
    // Fixed public hands: the 2, 3, 4, 5 (legal; rank_value 0..3) and the
    // 7, A (contraband; rank_value 5 and 12) of clubs for P0, spades for P1.
    move all cards from deck
         where card.suit is clubs and (rank_value(card) <= 3 or rank_value(card) is 5 or rank_value(card) is 12)
         to hand[0]
    move all cards from deck
         where card.suit is spades and (rank_value(card) <= 3 or rank_value(card) is 5 or rank_value(card) is 12)
         to hand[1]
    move all cards from deck to dead
  }

  phase play {
    // Twelve smuggling rounds, roles alternating. Hands shrink in lockstep,
    // so both empty together after six pairs.
    repeat until hand[0] is empty and hand[1] is empty {
      merchant := 0
      inspector := 1
      run commit_shipment()
      run respond()
      merchant := 1
      inspector := 0
      run commit_shipment()
      run respond()
    }
  }

  phase scoring {
    // Warehouse scores for the shipper, seized for the confiscator, both at
    // card value (rank_value + 1, folded in as the zone count). The cleared
    // piles (impounded goods) score nobody — deliberately absent from these
    // sums; that IS the V1 half of the composition.
    let goods0 = (sum of rank_value(card) over cards in warehouse[0])
               + (number of cards in warehouse[0])
               + (sum of rank_value(card) over cards in seized[0])
               + (number of cards in seized[0])
    let goods1 = (sum of rank_value(card) over cards in warehouse[1])
               + (number of cards in warehouse[1])
               + (sum of rank_value(card) over cards in seized[1])
               + (number of cards in seized[1])
    score[0] := goods0 - goods1 + fine_net[0] - fine_net[1]
    score[1] := goods1 - goods0 + fine_net[1] - fine_net[0]
  }

  winner: highest score
}

// The inspector's half of a smuggling round. The commit is the imported
// `commit_shipment` (docs/libraries/smuggling.cardlang), which the phase runs
// first. The inspector decides only while they hold a token — with none left
// the wave is automatic.
procedure respond() {
  if tokens[inspector] > 0 {
    offer to inspector one of [inspect, wave]
  } else {
    move all cards from shipment[merchant] to warehouse[merchant]
  }
}

// Spend a token and open the crate. Contraband (7/A: rank_value 5 or 12) is
// seized and will score for the inspector, and the merchant is fined 5.
// Legal goods are impounded: they land face up in the merchant's cleared
// pile where they score NOBODY, and the inspector pays the 5-point fine.
move_type inspect {
  when: tokens[actor] > 0   // backstop: the offer site in smuggle_round gates on tokens
  effect {
    tokens[actor] -= 1
    reveal one card from shipment[merchant]
    // Contraband: rank_value is 5 (the 7) or 12 (the A) — textually the same
    // disjunct as the setup filters above, so the two sites cannot drift.
    if any card in shipment[merchant] where rank_value(card) is 5 or rank_value(card) is 12 {
      move all cards from shipment[merchant] to seized[actor]
      fine_net[merchant] -= 5
      fine_net[actor] += 5
    } else {
      move all cards from shipment[merchant] to cleared[merchant]
      fine_net[merchant] += 5
      fine_net[actor] -= 5
    }
  }
}
