// Undertow — an original four-player trick-taker (experiment, not corpus;
// see DESIGN.md alongside this file).
//
// The whole game is one twist on the classic engine: when a trick is
// gathered, its LOWEST card — earliest played breaks ties — names the trump
// suit for the NEXT trick (the "undertow"). The first trick is played with
// no trump. Follow suit if able; highest trump, else highest of the led
// suit, takes the trick and leads; most tricks wins the hand. Aces high,
// so every 2 is a rudder: high cards buy the present, low cards steer the
// future, and a void player's sluff — the dead choice of classic trick
// games — becomes the control move that steals the tide.
//
// The tie rule is positional and free: `move one card ... where` takes the
// first match in zone order, and the trick pile is ordered by play, so the
// earliest-played of the tied lowest cards sets the tide.

game Undertow {

  players: 4
  direction: clockwise
  max_length: 800

  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2

  zones {
    deck             : Deck
    hand[player]     : Hand<player>
    trick_pile       : TrickPile
    tide_marker      : Discard              // the trick's lowest card, shown while it names the trump
    captured[player] : PlayerPile<player>
  }

  state {
    tricks_won[player] : Integer = 0
    trump_suit         : Suit?   = none     // none for the first trick: the tide is out
    leader             : Player? = none
  }

  phase setup {
    shuffle deck
    deal 13 cards from deck to each hand
  }

  phase play {
    active_rules: [MustFollowSuit]
    legal_moves:  [play_to_trick]

    leader := player_holding(2 of clubs)
    repeat until (all players where hand[player] is empty) {
      round play_to_trick from leader over all players source hand into trick_pile
            winner highest_trump_or_led_suit trump trump_suit

      // The undertow: pull the trick's lowest card (first played among ties)
      // onto the marker, read the next trump off it, then gather everything.
      let low_val = lowest rank_value(card) over cards in trick_pile or 0
      move one card from trick_pile where rank_value(card) is low_val to tide_marker
      trump_suit := suit_of(tide_marker)
      move all cards from tide_marker to captured[winner]
      move all cards from trick_pile to captured[winner]

      tricks_won[winner] += 1
      leader := winner
    }
  }

  winner: highest tricks_won
}

// MustFollowSuit is the standard-library rule (library.md "Rules"):
// activated by name above, defined once in cardlang/stdlib/rules.cardlang.
