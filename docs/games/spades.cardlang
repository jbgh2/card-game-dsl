// Spades — formalized DSL (parser/checker/runtime target).
//
// Companion to spades.md. The machine-checkable form: partnership trick-taking
// with a fixed trump suit (spades), a per-player integer bid (nil = 0), and
// contract + nil + bag-overflow scoring to 500. Where spades.md sketches
// constructs the grammar had not yet grown (scoring_component blocks, a
// first-trick spade ban that is redundant with "no leading spades until
// broken"), this file uses the constructs that actually execute and folds the
// scoring into the `scoring` phase the way hearts.cardlang does.
//
// Chosen ruleset (one of several Spades variants; kept internally consistent so
// the per-hand score reconciles):
//   - team contract = sum of the partners' non-nil bids;
//   - make it (team tricks >= contract): +10 per bid trick, +1 bag per overtrick;
//   - miss it: -10 per bid trick, no bags;
//   - nil bid (0): +100 if that player took zero tricks, -100 otherwise;
//   - every 10 accumulated bags: -100 and the bag counter drops by 10.

game Spades {

  players: 4
  partnerships: [[0, 2], [1, 3]]   // partners sit across the four-hand ring
  direction: clockwise
  max_length: 2000

  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  trump: spades

  zones {
    deck           : Deck
    hand[player]   : Hand<player>
    trick_pile     : TrickPile
    captured[team] : TeamPile<team>
  }

  state {
    // Game-level: persist across hands.
    score[team] : Integer = 0
    bags[team]  : Integer = 0
  }

  // The game ends when a team reaches +500 (a win) or sinks to -200 (a loss);
  // both are standard Spades thresholds. The -200 floor matters: it guarantees
  // termination under uniform-random bidding, which systematically overbids.
  phase hand_sequence repeats until (any team t: score[t] >= 500 or score[t] <= 0 - 200) {
    state {
      // Per-hand, reset each hand by before_each.
      dealer             : Player  = 0
      leader             : Player? = none
      bid[player]        : Integer = 0
      tricks_won[player] : Integer = 0
    }

    before_each {
      move all cards to deck
      shuffle deck
      deal 13 cards from deck to each hand
      dealer := dealer offset_by left          // rotate the deal each hand
      leader := dealer offset_by left          // eldest hand leads the first trick
      for each player p: bid[p] := 0
      for each player p: tricks_won[p] := 0
    }

    phase bidding {
      legal_moves: [submit_bid]
      // Each player names a number 0..13; 0 is a nil bid. The range is carried
      // by the choose, so no separate demand rule is needed to enforce it.
      for each player p: bid[p] := choose integer in 0 .. 13
    }

    phase play {
      active_rules: [MustFollowSuit]
      legal_moves:  [play_to_trick]

      phase spades_not_broken {
        active_rules: [+ NoLeadingSuitUntilBroken(spades)]
        transition_to: spades_broken when play_to_trick where action.card.suit == spades
      }

      phase spades_broken {
        // inherits the parent's MustFollowSuit only
      }

      repeat until (all player p: hand[p] is empty) {
        round play_to_trick from leader over all players source hand into trick_pile
              outcome highest_trump_or_led_suit
        move all cards from trick_pile to captured[team_of(outcome)]
        tricks_won[outcome] += 1
        leader := outcome
      }
    }

    phase scoring {
      state {
        // Per-hand team aggregates, fresh each hand.
        team_bid[team]    : Integer = 0
        team_tricks[team] : Integer = 0
      }

      // Fold per-player bids (excluding nil) and tricks into team totals.
      for each player p: team_bid[team_of(p)] += (if bid[p] == 0 then 0 else bid[p])
      for each player p: team_tricks[team_of(p)] += tricks_won[p]

      // Contract scoring per team.
      for each team t:
        if team_tricks[t] >= team_bid[t] {
          score[t] += contract_score(t) + overtricks(t)
          bags[t]  += overtricks(t)
        } else {
          score[t] -= contract_score(t)
        }

      // Nil scoring per player.
      for each player p:
        if bid[p] == 0 {
          if tricks_won[p] == 0 { score[team_of(p)] += 100 }
          else { score[team_of(p)] -= 100 }
        }

      // Bag overflow: every 10 bags costs 100 and decrements by 10.
      repeat until (all team t: bags[t] < 10) {
        for each team t:
          if bags[t] >= 10 { score[t] -= 100  bags[t] -= 10 }
      }
    }
  }

  winner: highest score
}

// MustFollowSuit and NoLeadingSuitUntilBroken(spades) are standard-library
// rules (library.md "Rules"): activated by name above, defined once in
// cardlang/stdlib/rules.cardlang.

// Per-team contract aggregates, named so the make and miss branches score the
// contract from one place: its value (10 per bid) and the overtricks beyond it.
function contract_score(t : Team) = 10 * team_bid[t]
function overtricks(t : Team)     = team_tricks[t] - team_bid[t]
