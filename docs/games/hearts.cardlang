// Hearts — the American game, 4 players.
//
// Rules source: https://www.pagat.com/reverse/hearts.html (fetched live per
// CLAUDE.md), the page's main account. Standard 52 ranked ace high, no trump,
// no partnerships. Thirteen cards each; three cards pass left, then right,
// then across, then a hand with no pass, and the cycle repeats. The holder of
// the two of clubs leads it to the first trick; the others follow suit, or
// play any card when void; the highest card of the led suit takes the trick
// and leads the next. A heart may not be led until one has been played to an
// earlier trick, unless the hand holds nothing but hearts. Each heart taken
// costs 1 point and the queen of spades 13. A player who takes all 26 has
// shot the moon, and chooses whether to take 26 off their own score or add 26
// to each other player's. Hands run until someone reaches 100 or more, and
// the lowest total wins.
//
// The first trick is the first pass of `play`'s loop rather than a phase of
// its own. A `mode`'s transition sees only its own phase's instance, so a
// `first_trick` sibling would hide the heart that breaks hearts on trick one;
// and the forced two-of-clubs opening needs no phase of its own, since a
// `rule` demanding that card is empty on every later lead.

game Hearts {

  players: 4
  direction: clockwise
  max_length: 5000

  cards: standard52
  ranking: aces high

  zones {
    deck             : Deck
    hand[player]     : Hand<player>
    trick_pile       : TrickPile
    captured[player] : PlayerPile<player>
  }

  state {
    // Game-level: persists across hands.
    cumulative_score[player] : Integer = 0
  }

  phase hand_sequence repeat until (any player where cumulative_score[player] >= 100) {
    state {
      // Loop state: persists across hands; before_each rotates it each hand,
      // so starting at `hold` makes hand 1 pass left.
      pass_direction : SeatDirection = hold
    }

    before_each {
      move all cards to deck    // gather the previous hand's cards back home
      shuffle deck
      deal 13 cards from deck to each hand
      rotate pass_direction through [left, right, across, hold]
    }

    phase passing when pass_direction is not hold {
      legal_moves:  [transfer_between_hands]

      // Exactly three cards, and the movement below is what binds that: the
      // `chosen 3` count IS the law. A `rule` cannot state it — rules are
      // consulted only at the trick round's card decision, never here
      // (open-questions/rule-scope-beyond-trick-play.md).
      each player simultaneously:
        transfer chosen 3 cards
          from hand[player]
          to   hand[player offset_by pass_direction]
    }

    phase play {
      state {
        // The trick leader: the two-of-clubs holder, then each trick's winner.
        leader : Player? = none
      }

      active_rules: [MustFollowSuit, MustLeadTwoOfClubs]
      legal_moves:  [play_to_trick]

      mode hearts_not_broken {
        active_rules: [+ NoLeadingSuitUntilBroken(hearts)]
        transition_to: hearts_broken when play_to_trick where action.card.suit is hearts
      }

      mode hearts_broken { }

      leader := player_holding(2 of clubs)

      // Body: loop tricks until hands empty.
      repeat until (all players where hand[player] is empty) {
        round play_to_trick from leader over all players source hand into trick_pile
              winner highest_of_led_suit
        move all cards from trick_pile to captured[winner]
        leader := winner
      }
    }

    phase scoring {
      state {
        // Set by whichever arm the shooter takes, and what ends the round.
        moon_settled : Boolean = false
      }

      // base is a phase-local let, not declared state.
      let base[p] = sum of (if card.suit is hearts       then 1
                            elif card is Q of spades     then 13
                            else 0)
                    over cards in captured[p]

      // Shooting the moon: all 26 penalty points in one player's tricks. The
      // shooter chooses between the two ways it scores; nobody else is asked.
      if any player where base[player] is 26 {
        round offering [charge_the_others, credit_the_shooter]
              from (the player where base[player] is 26)
              over players where base[player] is 26
              until moon_settled
      } else {
        for each player p:
          cumulative_score[p] += base[p]
      }
    }
  }

  winner: lowest cumulative_score
}

// === Hearts-specific rules ===

rule MustLeadTwoOfClubs {
  constrains: play_to_trick
  applies_when: state.led_suit is none      // i.e., leading
  demands: cards in hand where card is 2 of clubs
  if_impossible: hand   // every lead after the first: the card is gone
}

// === Shooting the moon ===

move_type charge_the_others {
  effect {
    let shooter = actor
    for each player p:
      if p is not shooter {
        cumulative_score[p] += 26
      }
    moon_settled := true
  }
}

move_type credit_the_shooter {
  effect {
    cumulative_score[actor] -= 26
    moon_settled := true
  }
}

// MustFollowSuit and NoLeadingSuitUntilBroken(hearts) are standard-library
// rules (library.md "Rules"): activated by name above, defined once in
// cardlang/stdlib/rules.cardlang.
