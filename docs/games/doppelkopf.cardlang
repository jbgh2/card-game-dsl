// Doppelkopf — formalized DSL (parser/checker/runtime target).
//
// Companion to doppelkopf.md. Four players, 48-card doppelkopf48 deck (two
// copies of A 10 K Q J 9 per suit; values A=11 10=10 K=4 Q=3 J=2 9=0, 240
// card points). One round of deals (four hands, each player deals once);
// normal games only — the DDV-aligned base without the Vorbehalt round
// (no marriage, poverty, or bid solos; a silent solo — both ♣Q dealt to one
// player — arises naturally from the ♣Q partition and is scored as a normal
// game with the lone player's score tripled). Rules: Pagat
// <https://www.pagat.com/schafkopf/doko.html>, base text.
//
// The two ♣Q holders form the Re team; the others are Kontra. Team
// membership is hidden information, so it is NEVER state: `is_re(p)` reads
// p's own hand (guards only — the actor's private legality) or the public
// record `re_known[p]`, which is written only on public events (playing a
// ♣Q, making a Re-side announcement). At scoring time every card has been
// played, so the public record is the complete partition — the same
// deferred evaluation the rulebook itself uses for the Fox ("turned over
// ... when the team becomes clear").
//
// Announcements (Re, Kontra, no 90/60/30/schwarz) are off-the-clock: legal
// "at any time", bounded by the announcer's own hand size. The encoding is
// the quiescence-lap poll (decisions.md "Off-the-clock windows"): before
// every card decision, while the public window gate holds, an offering
// round walks the ring from the player about to act; each player in turn
// submits an announcement or `no_announcement`; four consecutive
// `no_announcement`s close the poll. The gate reads only public state
// (hand counts and the announcement ladder), so skipping a closed window
// leaks nothing; a player with no legal announcement submits the same
// public `no_announcement` as a player declining by choice, so private
// ineligibility is indistinguishable from silence. The stated side is
// folded into the move vocabulary (announce_re_no90 vs announce_kontra_no90
// — Coup's block_claiming_* precedent), matching the rulebook's "must state
// whether he or she belongs to the Re-team or the Kontra-team".
//
// Tricks are hand-rolled (the Skat shape) because announcements may land
// between any two card plays — a foreign decision inside the trick, which
// the trick form of `round` cannot host. The trump group (both ♥10, all
// queens, all jacks, all diamonds) is a computed follow class in in-DSL
// functions; the only game-local runtime primitive is doko_trick_winner
// (ordered first-of-equals comparison, which needs the pile's play order).

game Doppelkopf {

  players: 4
  direction: clockwise
  max_length: 30000

  cards: doppelkopf48
  ranking: ace-ten

  zones {
    deck             : Deck
    hand[player]     : Hand<player>
    trick_pile       : TrickPile
    captured[player] : PlayerPile<player>
  }

  state {
    // Game-level: persists across hands.
    score[player] : Integer = 0
    hands_played  : Integer = 0
  }

  phase hand_sequence repeat until hands_played >= 4 {
    state {
      dealer : Player = 0
    }

    before_each {
      move all cards to deck
      shuffle deck
      deal 12 cards from deck to each hand
    }

    phase play {
      state {
        leader        : Player? = none
        // Announcements: said flags and the per-team ladder level
        // (0 none, 1 no 90, 2 no 60, 3 no 30, 4 schwarz). All public.
        re_said       : Boolean = false
        kontra_said   : Boolean = false
        re_level      : Integer = 0
        kontra_level  : Integer = 0
        // The public part of the team partition: set when p plays a ♣Q or
        // makes a Re-side announcement. Complete once all cards are played.
        re_known[player] : Boolean = false
        // Poll bookkeeping: consecutive no_announcement count.
        quiet         : Integer = 0
        // Led class for follow legality, set by the leader's play.
        led_trump     : Boolean = false
        led_suit      : Suit?   = none
        // Per-trick counters for attributing just-played cards to seats.
        trick_no      : Integer = 0
        cq_seen       : Integer = 0
        fox_seen      : Integer = 0
        cj_seen       : Integer = 0
        // Deferred bonus events (teams are resolved only at scoring time).
        // At most two of each: two ♦A and two ♣J exist.
        fox1_victim     : Player? = none
        fox1_winner     : Player? = none
        fox2_victim     : Player? = none
        fox2_winner     : Player? = none
        charlie1_player : Player? = none
        charlie2_player : Player? = none
        last_winner     : Player? = none
        tricks_won[player] : Integer = 0
        dk_tricks[player]  : Integer = 0
        // Scoring accumulators.
        re_pts        : Integer = 0
        kontra_pts    : Integer = 0
        re_tricks     : Integer = 0
        kontra_tricks : Integer = 0
        extras_re     : Integer = 0
        extras_kontra : Integer = 0
      }

      leader := dealer offset_by left

      repeat until (all players where hand[player] is empty) {
        trick_no += 1
        cq_seen := 0
        fox_seen := 0
        cj_seen := 0
        let s2 = leader offset_by left
        let s3 = s2 offset_by left
        let s4 = s3 offset_by left

        // --- Seat 1: the leader. Poll, then lead any card.
        if window_open() {
          quiet := 0
          round offering [announce_re, announce_kontra, announce_re_no90,
                          announce_re_no60, announce_re_no30, announce_re_schwarz,
                          announce_kontra_no90, announce_kontra_no60,
                          announce_kontra_no30, announce_kontra_schwarz,
                          no_announcement]
                from leader over all players until quiet >= 4
        }
        as leader { move chosen one card from hand[leader] to trick_pile }
        led_trump := any card in trick_pile where is_trump(card)
        led_suit := suit_of(trick_pile)
        if (number of cards in trick_pile where card is Q of clubs) > cq_seen {
          re_known[leader] := true
          cq_seen += 1
        }
        if (number of cards in trick_pile where card is A of diamonds) > fox_seen {
          if fox1_victim is none { fox1_victim := leader } else { fox2_victim := leader }
          fox_seen += 1
        }
        if trick_no is 12 and (number of cards in trick_pile where card is J of clubs) > cj_seen {
          if charlie1_player is none { charlie1_player := leader } else { charlie2_player := leader }
          cj_seen += 1
        }

        // --- Seat 2. Poll, then follow the led class.
        if window_open() {
          quiet := 0
          round offering [announce_re, announce_kontra, announce_re_no90,
                          announce_re_no60, announce_re_no30, announce_re_schwarz,
                          announce_kontra_no90, announce_kontra_no60,
                          announce_kontra_no30, announce_kontra_schwarz,
                          no_announcement]
                from s2 over all players until quiet >= 4
        }
        as s2 { move chosen one card from hand[s2] where follow_ok(s2, card) to trick_pile }
        if (number of cards in trick_pile where card is Q of clubs) > cq_seen {
          re_known[s2] := true
          cq_seen += 1
        }
        if (number of cards in trick_pile where card is A of diamonds) > fox_seen {
          if fox1_victim is none { fox1_victim := s2 } else { fox2_victim := s2 }
          fox_seen += 1
        }
        if trick_no is 12 and (number of cards in trick_pile where card is J of clubs) > cj_seen {
          if charlie1_player is none { charlie1_player := s2 } else { charlie2_player := s2 }
          cj_seen += 1
        }

        // --- Seat 3.
        if window_open() {
          quiet := 0
          round offering [announce_re, announce_kontra, announce_re_no90,
                          announce_re_no60, announce_re_no30, announce_re_schwarz,
                          announce_kontra_no90, announce_kontra_no60,
                          announce_kontra_no30, announce_kontra_schwarz,
                          no_announcement]
                from s3 over all players until quiet >= 4
        }
        as s3 { move chosen one card from hand[s3] where follow_ok(s3, card) to trick_pile }
        if (number of cards in trick_pile where card is Q of clubs) > cq_seen {
          re_known[s3] := true
          cq_seen += 1
        }
        if (number of cards in trick_pile where card is A of diamonds) > fox_seen {
          if fox1_victim is none { fox1_victim := s3 } else { fox2_victim := s3 }
          fox_seen += 1
        }
        if trick_no is 12 and (number of cards in trick_pile where card is J of clubs) > cj_seen {
          if charlie1_player is none { charlie1_player := s3 } else { charlie2_player := s3 }
          cj_seen += 1
        }

        // --- Seat 4.
        if window_open() {
          quiet := 0
          round offering [announce_re, announce_kontra, announce_re_no90,
                          announce_re_no60, announce_re_no30, announce_re_schwarz,
                          announce_kontra_no90, announce_kontra_no60,
                          announce_kontra_no30, announce_kontra_schwarz,
                          no_announcement]
                from s4 over all players until quiet >= 4
        }
        as s4 { move chosen one card from hand[s4] where follow_ok(s4, card) to trick_pile }
        if (number of cards in trick_pile where card is Q of clubs) > cq_seen {
          re_known[s4] := true
          cq_seen += 1
        }
        if (number of cards in trick_pile where card is A of diamonds) > fox_seen {
          if fox1_victim is none { fox1_victim := s4 } else { fox2_victim := s4 }
          fox_seen += 1
        }
        if trick_no is 12 and (number of cards in trick_pile where card is J of clubs) > cj_seen {
          if charlie1_player is none { charlie1_player := s4 } else { charlie2_player := s4 }
          cj_seen += 1
        }

        // --- Trick end: first-of-equals winner over the trump class.
        let w = doko_trick_winner(leader)
        tricks_won[w] += 1
        if fox1_victim is not none and fox1_winner is none { fox1_winner := w }
        if fox2_victim is not none and fox2_winner is none { fox2_winner := w }
        if (number of cards in trick_pile where card.rank in [A, "10"]) is 4 {
          dk_tricks[w] += 1
        }
        if trick_no is 12 { last_winner := w }
        move all cards from trick_pile to captured[w]
        leader := w
      }

      // --- Scoring. All 48 cards are played, so re_known[] is the complete
      // partition and every deferred bonus event can be team-resolved.
      let pts[p] = sum of card_value(card) over cards in captured[p]
      for each player p:
        if re_known[p] {
          re_pts += pts[p]
          re_tricks += tricks_won[p]
          extras_re += dk_tricks[p]
        } else {
          kontra_pts += pts[p]
          kontra_tricks += tricks_won[p]
          extras_kontra += dk_tricks[p]
        }

      // Fox: +1 to the capturing team when a ♦A fell to the other team.
      if fox1_victim is not none and re_known[fox1_winner] is not re_known[fox1_victim] {
        if re_known[fox1_winner] { extras_re += 1 } else { extras_kontra += 1 }
      }
      if fox2_victim is not none and re_known[fox2_winner] is not re_known[fox2_victim] {
        if re_known[fox2_winner] { extras_re += 1 } else { extras_kontra += 1 }
      }
      // Charlie: winning the last trick with a ♣J scores +1; playing a ♣J
      // into an opponent-won last trick concedes one (scored to the winner's
      // team — the zero-sum net is identical); partner-won is silent.
      if charlie1_player is not none {
        if charlie1_player is last_winner {
          if re_known[charlie1_player] { extras_re += 1 } else { extras_kontra += 1 }
        } else {
          if re_known[charlie1_player] is not re_known[last_winner] {
            if re_known[last_winner] { extras_re += 1 } else { extras_kontra += 1 }
          }
        }
      }
      if charlie2_player is not none {
        if charlie2_player is last_winner {
          if re_known[charlie2_player] { extras_re += 1 } else { extras_kontra += 1 }
        } else {
          if re_known[charlie2_player] is not re_known[last_winner] {
            if re_known[last_winner] { extras_re += 1 } else { extras_kontra += 1 }
          }
        }
      }

      // Winner determination (DDV-aligned; verified against both Pagat
      // worked examples — see doppelkopf.md "Scoring, worked"):
      // a side that fails any level it announced loses to the other side
      // unless that side also failed its own; with announcements fulfilled
      // (or none made) the base targets decide — Re 121 / Kontra 120,
      // flipping to 120 / 121 when Kontra alone was announced.
      let re_base = if kontra_said and not re_said then 120 else 121
      let kontra_base = if kontra_said and not re_said then 121 else 120
      let re_ann_ok = if re_level is 0 then true
                      elif re_level is 1 then re_pts >= 151
                      elif re_level is 2 then re_pts >= 181
                      elif re_level is 3 then re_pts >= 211
                      else kontra_tricks is 0
      let kontra_ann_ok = if kontra_level is 0 then true
                          elif kontra_level is 1 then kontra_pts >= 151
                          elif kontra_level is 2 then kontra_pts >= 181
                          elif kontra_level is 3 then kontra_pts >= 211
                          else re_tricks is 0
      let re_wins = re_ann_ok and (if kontra_ann_ok then re_pts >= re_base else true)
      let kontra_wins = kontra_ann_ok and (if re_ann_ok then kontra_pts >= kontra_base else true)

      // Game value to the winner: 1 game, +1 "gegen die Alten" for a Kontra
      // win, +2 per said Re/Kontra, +1 per level the loser was held under,
      // +1 per level the winner announced, +2 per level the loser announced
      // (the failed announcement and its level point transfer).
      let l_pts = if re_wins then kontra_pts else re_pts
      let l_tricks = if re_wins then kontra_tricks else re_tricks
      let w_ann_level = if re_wins then re_level else kontra_level
      let l_ann_level = if re_wins then kontra_level else re_level
      let v = 1
            + (if kontra_wins then 1 else 0)
            + (if re_said then 2 else 0)
            + (if kontra_said then 2 else 0)
            + (if l_pts < 90 then 1 else 0)
            + (if l_pts < 60 then 1 else 0)
            + (if l_pts < 30 then 1 else 0)
            + (if l_tricks is 0 then 1 else 0)
            + w_ann_level
            + 2 * l_ann_level

      // Neither side fulfilled its announcements: no game / gegen die Alten
      // / Re / Kontra points; the level points each side actually achieved
      // and the other side's failed announcement points net against each
      // other (scoped ruling, DDV 7.1.4/7.2.2-aligned; see doppelkopf.md).
      let nw = (if kontra_pts < 90 then 1 else 0)
             + (if kontra_pts < 60 then 1 else 0)
             + (if kontra_pts < 30 then 1 else 0)
             + (if kontra_tricks is 0 then 1 else 0)
             + 2 * kontra_level
             - (if re_pts < 90 then 1 else 0)
             - (if re_pts < 60 then 1 else 0)
             - (if re_pts < 30 then 1 else 0)
             - (if re_tricks is 0 then 1 else 0)
             - 2 * re_level

      let d = (if re_wins then v elif kontra_wins then 0 - v else nw)
            + extras_re - extras_kontra
      let re_size = number of players where re_known[player]
      let re_mult = if re_size is 1 then 3 else 1
      for each player p:
        if re_known[p] { score[p] := score[p] + d * re_mult }
        else { score[p] := score[p] - d }
    }

    after_each {
      dealer := dealer offset_by left
      hands_played += 1
    }
  }

  winner: highest score
}

// === Announcement vocabulary ===
//
// Game-defined move_types offered by the poll round. Guards read the
// actor's own hand (is_re, cards_left) plus public ladder state; effects
// write only public state. `no_announcement` is unguarded, so the poll
// never offers an empty candidate set.

move_type announce_re {
  when: is_re(actor) and not re_said and cards_left(actor) >= re_floor()
  effect {
    re_said := true
    re_known[actor] := true
    quiet := 0
  }
}

move_type announce_kontra {
  when: (not is_re(actor)) and not kontra_said and cards_left(actor) >= kontra_floor()
  effect {
    kontra_said := true
    quiet := 0
  }
}

move_type announce_re_no90 {
  when: is_re(actor) and re_said and re_level is 0 and cards_left(actor) >= 10
  effect {
    re_level := 1
    re_known[actor] := true
    quiet := 0
  }
}

move_type announce_re_no60 {
  when: is_re(actor) and re_said and re_level is 1 and cards_left(actor) >= 9
  effect {
    re_level := 2
    re_known[actor] := true
    quiet := 0
  }
}

move_type announce_re_no30 {
  when: is_re(actor) and re_said and re_level is 2 and cards_left(actor) >= 8
  effect {
    re_level := 3
    re_known[actor] := true
    quiet := 0
  }
}

move_type announce_re_schwarz {
  when: is_re(actor) and re_said and re_level is 3 and cards_left(actor) >= 7
  effect {
    re_level := 4
    re_known[actor] := true
    quiet := 0
  }
}

move_type announce_kontra_no90 {
  when: (not is_re(actor)) and kontra_said and kontra_level is 0 and cards_left(actor) >= 10
  effect {
    kontra_level := 1
    quiet := 0
  }
}

move_type announce_kontra_no60 {
  when: (not is_re(actor)) and kontra_said and kontra_level is 1 and cards_left(actor) >= 9
  effect {
    kontra_level := 2
    quiet := 0
  }
}

move_type announce_kontra_no30 {
  when: (not is_re(actor)) and kontra_said and kontra_level is 2 and cards_left(actor) >= 8
  effect {
    kontra_level := 3
    quiet := 0
  }
}

move_type announce_kontra_schwarz {
  when: (not is_re(actor)) and kontra_said and kontra_level is 3 and cards_left(actor) >= 7
  effect {
    kontra_level := 4
    quiet := 0
  }
}

move_type no_announcement {
  effect {
    quiet += 1
  }
}

// === Functions ===

// Hand size — the announcement thresholds are per-announcer card counts.
function cards_left(p : Player) = number of cards in hand[p]

// Team membership: public record, or a ♣Q still in p's own hand. Read only
// in guards (the actor's private legality) and at scoring time (when the
// public record is complete).
function is_re(p : Player) =
  re_known[p] or (any card in hand[p] where card is Q of clubs)

// The trump group of the normal game: both ♥10 (the Dulle), all queens,
// all jacks, and all diamonds.
function is_trump(c : Card) =
  c.rank is Q or c.rank is J or c.suit is diamonds
  or (c.suit is hearts and c.rank is "10")

function holds_trump(p : Player) =
  any card in hand[p] where is_trump(card)

// Strict follow by class: trumps are one suit for following purposes; a
// plain-suit lead must be followed with a non-trump card of that suit.
function follow_ok(p : Player, c : Card) =
  if led_trump
  then (if holds_trump(p) then is_trump(c) else true)
  else (if (any card in hand[p] where card.suit is led_suit and not is_trump(card))
        then (c.suit is led_suit and not is_trump(c))
        else true)

// Re/Kontra floors: 11 cards normally; after the other side's announcement
// the reply floor is one fewer card than that announcement required
// (deepest announcement counts: level L was made at >= 11 - L, so the
// reply floor is 10 - L).
function re_floor() = if kontra_said then 10 - kontra_level else 11
function kontra_floor() = if re_said then 10 - re_level else 11

// The public window gate: could ANY player have a legal announcement, by
// public information alone (hand counts + the ladder)? Team membership is
// private, so this over-approximates; the guards are exact, and a player
// with nothing legal submits the same public no_announcement either way.
function window_open() =
  any player where (not re_said and cards_left(player) >= re_floor())
                or (not kontra_said and cards_left(player) >= kontra_floor())
                or (re_said and re_level < 4 and cards_left(player) >= 10 - re_level)
                or (kontra_said and kontra_level < 4 and cards_left(player) >= 10 - kontra_level)
