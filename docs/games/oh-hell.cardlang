// Oh Hell — formalized DSL (parser/checker/runtime target).
//
// Companion to oh-hell.md. Four-player exact-bid trick-taking over 19 hands of
// varying size (10 down to 1, then back up to 10). Each hand turns up a card to
// fix trump, every player bids the exact number of tricks they expect, and the
// hand scores +1 per trick plus a +10 bonus for hitting the bid exactly.
//
// Tricks are played via the kernel `round` construct. The trump suit varies per
// hand, so it is passed as a `trump` argument (read from the per-hand
// `trump_suit` state var) rather than a fixed game-level `trump:` declaration.
//
// The dealer hook (the total of all bids may not equal the hand size) is
// enforced here as a correction to the dealer's bid after the bids are in,
// rather than as the rulebook's choice-time constraint, because a value cannot
// be excluded from a `choose` range as it is chosen (issue #509).
//
// The correction is not observationally equivalent to the constraint, and the
// difference is in this project's own currency. Every `choose` announces its
// result to all players at the moment it is made, while the correcting
// assignment is silent — so the bids players HEAR are the uncorrected ones,
// which can total the hand size, the one total the rule exists to forbid.
// Scoring uses a corrected bid nobody was told, and two different dealer bids
// reach the same corrected value while the announcement tells them apart.
//
// Bidding also runs in seat order, so the dealer does not bid last as the rules
// require (issue #511). That half is expressible today — the `turns` form takes
// a starting seat — and is a property of this file, not of the language.

game OhHell {

  players: 4
  direction: clockwise
  max_length: 3000

  cards: standard52
  ranking: aces high

  zones {
    deck             : Deck
    hand[player]     : Hand<player>
    trump_indicator  : Discard              // the face-up card that fixes trump
    trick_pile       : TrickPile
    captured[player] : PlayerPile<player>
  }

  state {
    // Game-level: persists across hands.
    score[player] : Integer = 0
  }

  phase hand_sequence repeat until hand_index >= 19 {
    state {
      hand_index         : Integer = 0      // 0..18 across the 19 hands
      hand_size          : Integer = 0      // tricks this hand
      dealer             : Player  = 0
      leader             : Player? = none
      bid[player]        : Integer = 0
      tricks_won[player] : Integer = 0
      trump_suit         : Suit?   = none
      total_bid          : Integer = 0
    }

    before_each {
      move all cards to deck
      shuffle deck
      // Hand size: 10, 9, ..., 1, 2, ..., 10.
      hand_size := if hand_index <= 9 then 10 - hand_index else hand_index - 8
      deal hand_size cards from deck to each hand
      deal 1 card from deck to trump_indicator    // turn up the trump card
      trump_suit := suit_of(trump_indicator)
      dealer := dealer offset_by left
      leader := dealer offset_by left             // eldest hand leads
      for each player p: bid[p] := 0
      for each player p: tricks_won[p] := 0
    }

    phase bidding {
      legal_moves: [submit_bid]
      // Bid up to the tricks in hand. `hand_size` varies per hand, so the range's
      // upper bound is runtime state; `up to 10` declares the static ceiling (the
      // largest hand) the OpenSpiel action space reserves for the bid.
      for each player p: bid[p] := choose integer in 0 .. hand_size up to 10

      // Dealer hook: the bids may not total the hand size.
      total_bid := 0
      for each player p: total_bid += bid[p]
      if total_bid is hand_size {
        if bid[dealer] < hand_size { bid[dealer] := bid[dealer] + 1 }
        else { bid[dealer] := bid[dealer] - 1 }
      }
    }

    phase play {
      active_rules: [MustFollowSuit]
      legal_moves:  [play_to_trick]

      repeat until (all players where hand[player] is empty) {
        round play_to_trick from leader over all players source hand into trick_pile
              winner highest_trump_or_led_suit trump trump_suit
        move all cards from trick_pile to captured[winner]
        tricks_won[winner] += 1
        leader := winner
      }
    }

    phase scoring {
      // +1 per trick taken, +10 for hitting the bid exactly (never negative).
      for each player p:
        if tricks_won[p] is bid[p] { score[p] += tricks_won[p] + 10 }
        else { score[p] += tricks_won[p] }
    }

    after_each {
      hand_index += 1
    }
  }

  winner: highest score
}

// MustFollowSuit is a standard-library rule (library.md "Rules"): activated
// by name above, defined once in cardlang/stdlib/rules.cardlang.
