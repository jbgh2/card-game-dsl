// FreeCell — one player, standard 52-card deck, Microsoft FreeCell rules:
// eight cascades dealt face up (7,7,7,7,6,6,6,6), four free cells (one card
// each), four foundations built A up to K in suit; one card moves at a time
// (the multi-card "supermove" is UI shorthand for a sequence of single-card
// moves and is not a separate rule); any single card may go to an empty
// cascade; foundation cards never come back down. Cell-to-cell moves are
// excluded (they change nothing). The player may abandon at any time.
//
// FreeCell is the perfect-information half of the positional-zone pair
// (decisions.md "Position domains and positional zones"): the same position
// machinery as Klondike — position-indexed Cascade/Cell/Foundation families,
// top_of, rank-scale guards — with NO HiddenStack anywhere. Every zone is
// identity-visible to the sole player, so the design carries zero visibility
// machinery it does not need: the orthogonality proof by construction.
//
// Foundations use the same fixed suit layout as Klondike (clubs=1,
// diamonds=2, hearts=3, spades=4 — presentational, rule-equivalent), and
// `ranking: aces low` gives the A=0..K=12 arithmetic scale.

game FreeCell {

  players: 1
  direction: clockwise
  max_length: 600

  cards: standard52
  ranking: aces low

  positions {
    column : 1..8    // the eight cascades, left to right
    cell   : 1..4    // the four free cells
    fslot  : 1..4    // the four foundation piles (clubs, diamonds, hearts, spades)
  }

  zones {
    deck              : Deck                // only for the deal; empty in play
    cascade[column]   : Cascade<column>     // a face-up column
    cells[cell]       : Cell<cell>          // a one-card holding space
    foundation[fslot] : Foundation<fslot>   // ace up to king, one suit each
  }

  state {
    resigned           : Boolean = false
    home_count[player] : Integer = 0    // cards sent to the foundations (the score)
  }

  // The whole deck is dealt face up: columns 1-4 take seven cards, 5-8 six.
  // (Microsoft deals round-robin; for a shuffled deck any fixed assignment
  // is distribution-equivalent, so the deal is written column-wise.)
  phase setup {
    shuffle deck
    deal 7 cards from deck to cascade[1]
    deal 7 cards from deck to cascade[2]
    deal 7 cards from deck to cascade[3]
    deal 7 cards from deck to cascade[4]
    deal 6 cards from deck to cascade[5]
    deal 6 cards from deck to cascade[6]
    deal 6 cards from deck to cascade[7]
    deal 6 cards from deck to cascade[8]
  }

  // One decision per turn until won or abandoned. `resign` is always legal,
  // so the offer can never be empty — including the genuine FreeCell
  // deadlock (no cell, no build, nothing home), which ends by abandonment.
  phase play {
    turns t from 0 over all players
          until resigned or (any player where home_count[player] is 52) {
      offer to t one of [to_cell, cell_to_cascade, cell_to_foundation,
                         cascade_to_cascade, cascade_to_foundation, resign]
    }
  }

  winner: highest home_count
}

// The fixed foundation layout: which pile a suit builds on.
function fpile(s : Suit) = if s is clubs then 1 elif s is diamonds then 2 elif s is hearts then 3 else 4

// Card color, for the alternating cascade build.
function red(s : Suit) = (s is hearts) or (s is diamonds)

// May c be placed on t in a cascade? One rank lower, opposite color.
function fits_down(c : Card, t : Card) = (rank_value(c) is rank_value(t) - 1) and (red(c.suit) is not red(t.suit))

// May c go to its foundation next? Its pile's ace first, then ascending.
function home_ok(c : Card) = if foundation[fpile(c.suit)] is empty then rank_value(c) is 0 else rank_value(c) is rank_value(top_of(foundation[fpile(c.suit)])) + 1

// A cascade's top card to any empty free cell.
move_type to_cell(src : column, slot : cell) {
  when: (cascade[src] is not empty) and (cells[slot] is empty)
  effect {
    let c = top_of(cascade[src])
    move one card from cascade[src] where card is c to cells[slot]
  }
}

// A held card back onto a cascade: onto a fitting top card, or any card
// onto an empty cascade (the FreeCell rule — no King restriction).
move_type cell_to_cascade(slot : cell, dst : column) {
  when: (cells[slot] is not empty)
        and ((cascade[dst] is empty)
             or fits_down(top_of(cells[slot]), top_of(cascade[dst])))
  effect {
    move all cards from cells[slot] to cascade[dst]
  }
}

// A held card to its foundation.
move_type cell_to_foundation(slot : cell) {
  when: (cells[slot] is not empty) and home_ok(top_of(cells[slot]))
  effect {
    let c = top_of(cells[slot])
    move one card from cells[slot] where card is c to foundation[fpile(c.suit)]
    home_count[actor] += 1
  }
}

// One card between cascades: the top card only (single-card rule), onto a
// fitting top card or an empty cascade.
move_type cascade_to_cascade(src : column, dst : column) {
  when: (src is not dst)
        and (cascade[src] is not empty)
        and ((cascade[dst] is empty)
             or fits_down(top_of(cascade[src]), top_of(cascade[dst])))
  effect {
    let c = top_of(cascade[src])
    move one card from cascade[src] where card is c to cascade[dst]
  }
}

// A cascade's top card to its foundation.
move_type cascade_to_foundation(src : column) {
  when: (cascade[src] is not empty) and home_ok(top_of(cascade[src]))
  effect {
    let c = top_of(cascade[src])
    move one card from cascade[src] where card is c to foundation[fpile(c.suit)]
    home_count[actor] += 1
  }
}

// Abandon the game; the score stands at the cards already sent home.
move_type resign {
  effect {
    resigned := true
  }
}
