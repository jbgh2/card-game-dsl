// Tichu — formalized DSL (parser/checker/runtime target).
//
// Companion to tichu.md. Four-player team climbing game on the 56-card
// Tichu deck (standard 52 plus Mahjong, Dog, Phoenix, Dragon). Players push one
// card to each other player, then climb: each play must match the led
// combination's type and length and beat it, or be a bomb that outranks
// what stands, or pass; a trick ends when action returns to the last player
// who played. First team to 1000 wins.
//
// The hand runs fully on the kernel. Each climbing trick is one `round climb`
// over the game-local combination engine (`tichu_lead_options` /
// `tichu_follows`; the engine itself is not expressible in the DSL — a play
// moves a specific computed card-set, where the movement vocabulary moves
// cards by count). The Dog is a trick-ending lead: the engine marks the play
// `ends_trick`, the climb form closes the trick with no follower draws, and
// the body reads `state.lead_ended_trick` to route it (discard, lead to the
// partner). Finishing order comes from the round's terminal state
// (`state.shed_first` / `state.shed_second`), folded in whichever way the
// trick closed: a player who sheds by leading the Dog is out like any other.
// The trick itself ends the instant the third player goes out, or the
// instant a double victory is complete — the round's `until` says so — and
// the pile is still taken (or given away by the Dragon) by the last player
// to play.
//
// The Mahjong's wish is a decision inside the trick: the play that holds
// the Mahjong (a lead single, or a straight from the one) is followed by one
// announcement from the same seat — a rank, or no wish — and from then on
// every seat asked in turn must play a combination holding a natural card
// of that rank whenever it lawfully can (a bomb holding one counts; the
// Phoenix never does), until a play holding it clears the wish. The engine
// marks the compelled plays and the climb form offers those alone, with no
// pass; the wish persists across tricks in `wish`, written after each round
// from the round's own record.
//
// Bombs play out of turn. After every play but the Dog, and once more when
// the trick would otherwise be gathered, every other player still holding
// cards is asked in turn whether they bomb — offered the bombs that beat
// what stands, beside `no_bomb`, so a player with none says the same thing
// as one who declines — and a bomb taken there stands, the play resumes
// after the bomber, and the asking begins again. A bomb played out of turn
// need not fulfil the wish. This is the climb form's interrupt window; the
// engine names which plays interrupt (bombs) and what a decline is called.
//
// The calls and the Dragon are real decisions. Grand tichu is called any
// time before the caller takes their ninth card: the first eight cards are
// taken one at a time, and after each a quiescence poll walks the ring
// (decisions.md "Off-the-clock windows"), so a call on one card or seven is
// a decision the game offers, and a seat that sees another decline may
// still call before the next card. Small tichu is off-the-clock — any time
// before the caller's first play — encoded as the same poll: before the
// push, after it, and before each climbing trick, while the public gate
// holds, an offering round walks the ring; `no_call` laps close it.
// Eligibility is public with no dedicated tracking: before the push nobody
// has played; after it, exactly the players still holding 14 cards haven't
// (plays are the only thing that shrink a post-push hand). The poll cannot
// sit between the plays *inside* a trick — the climb round owns those
// decisions — so within-trick call timing coarsens to trick boundaries; no
// call is made unreachable (see tichu.md). A Dragon-won trick is given away
// by a real choice (`dragon_to_left` / `dragon_to_right`), and the choice
// moves points: each player banks their own tricks, and the last player's
// tricks go to the first player out, so whose pile a Dragon trick lands in
// is part of the hand's score.
//
// The push is one chosen 3-card movement per player into a per-player gift
// pile (simultaneous: gifts land only after every pick), distributed
// giver-major, pick order to seat order.

game Tichu {

  players: 4
  teams: [[0, 2], [1, 3]]   // partners sit across
  direction: counterclockwise
  max_length: 20000

  cards: tichu56
  // The sparse point table: K and 10 score 10, 5 scores 5, the Dragon 25,
  // the Phoenix -25; every other card 0 (100 points per hand).
  card_points { 5: 5  10: 10  K: 10  Dragon: 25  Phoenix: -25 }

  // The one this game borrows from outside the DSL at a CALL position,
  // implemented in `cardlang/runtime/tichu.py`. It takes no `reads` clause:
  // the completed trick's standing play reaches it as an engine fact, and the
  // clause names this game's own zones and state variables alone.
  //
  // The climbing engine (`tichu_lead_options` / `tichu_follows`) is not here
  // and cannot be: a climb query is named on a `round climb` slot, a
  // Primitive namespace the block does not cover (issue #142), so those two
  // keep the `PRIMITIVE_READS` row their binder holds at load.
  primitives {
    tichu_dragon_won() : Boolean
    tichu_wish_after_trick() : Integer reads wish in play
  }

  zones {
    deck             : Deck
    hand[player]     : Hand<player>
    gift[player]     : Hand<player>       // the push: three picks, in pick order
    trick_pile       : TrickPile
    captured[player] : PlayerPile<player> // each player's own tricks
    discard          : Discard            // the Dog goes here (no capture)
  }

  state {
    // Game-level: persists across hands.
    score[team] : Integer = 0
  }

  phase hand_sequence repeat until (any team where score[team] >= 1000) {
    before_each {
      move all cards to deck
      shuffle deck
    }

    phase play {
      state {
        called[player] : Integer = 0   // 0 / 100 / 200; calls are announced (public)
        out_first  : Player? = none    // finishing order (public), first two only —
        out_second : Player? = none    //   all the scoring ever reads
        leader     : Player? = none
        poll_anchor : Player = 0       // fixed, public ring anchor for pre-lead polls
        quiet      : Integer = 0       // consecutive decline count (poll bookkeeping)
        push_done  : Boolean = false   // public flip: post-push, hand size 14 = unplayed
        dealt      : Integer = 0       // cards each player has taken of the first eight
        wish       : Integer = 0       // the Mahjong's wish in force: a rank value 2..14, or 0
      }

      legal_moves: [play_combination]

      // Grand tichu: any time before the ninth card. Each of the first eight
      // cards is taken by every player at once; after each, while somebody
      // may still call, a poll walks the ring — a call re-opens the lap, a
      // silent lap closes it — and then the next card is taken.
      repeat until dealt >= 8 {
        deal one card from deck to each hand
        dealt += 1
        if any player where called[player] is 0 {
          round offering [call_grand_tichu, decline_grand] from poll_anchor over all players
                until quiet >= 4
          quiet := 0
        }
      }
      deal 6 cards from deck to each hand

      // Small tichu before the push ("a call before the cards are pushed can
      // be useful as a request for partner to hand over his best card").
      if tichu_window_open() {
        round offering [call_tichu, no_call] from poll_anchor over all players
              until quiet >= 4
        quiet := 0
      }

      // The push: one draw of three from the live hand per player; gifts land
      // only after every pick (simultaneous). Distribution is draw-free and
      // giver-major: pick i goes to the i-th other player in seat order.
      for each player p: move chosen 3 cards from hand[p] to gift[p]
      for each player p: for each player q: if q is not p { deal one card from gift[p] to hand[q] }
      push_done := true

      // Small tichu between the push and the first lead.
      if tichu_window_open() {
        round offering [call_tichu, no_call] from poll_anchor over all players
              until quiet >= 4
        quiet := 0
      }

      // The Mahjong holder (post-push) leads the first trick.
      leader := player_holding(Mahjong of special)

      // Climbing tricks until at most one player holds cards, or the first two
      // finishers are teammates (double victory ends the hand early).
      repeat until (number of players where hand[player] is not empty) <= 1 or tichu_double_victory() {
        // Small tichu before each trick (the poll cannot interleave with the
        // plays inside the climb round; see the header note).
        if tichu_window_open() {
          round offering [call_tichu, no_call] from leader over all players
                until quiet >= 4
          quiet := 0
        }
        // The trick ends the instant only one player still holds cards, or
        // the instant the second finisher completes a double victory — with
        // a finisher recorded earlier in the hand (`out_first`), or both in
        // this trick (`state.shed_first` / `state.shed_second`). The Dog ends
        // it through the engine's `ends_trick`.
        round climb play_combination from leader
              over players where hand[player] is not empty
              source hand into trick_pile
              combinations tichu_lead_options follows tichu_follows
              until (number of players where hand[player] is not empty) <= 1
                    or (out_first is not none and state.shed_first is not none and team_of(out_first) is team_of(state.shed_first))
                    or (out_first is none and state.shed_first is not none and state.shed_second is not none and team_of(state.shed_first) is team_of(state.shed_second))
        // The wish outlives the trick until someone fulfils it: carry what
        // still stands (the announced rank, unless a play holding it has
        // since been made) into the next trick's legal sets.
        wish := tichu_wish_after_trick()
        // Fold this trick's sheds (play order) into the finishing order,
        // however the trick closed.
        if state.shed_first is not none {
          if out_first is none { out_first := state.shed_first }
          else { if out_second is none { out_second := state.shed_first } }
        }
        if state.shed_second is not none {
          if out_first is none { out_first := state.shed_second }
          else { if out_second is none { out_second := state.shed_second } }
        }
        if state.lead_ended_trick {
          // The Dog: no capture, the lead passes to the partner.
          move all cards from trick_pile to discard
          leader := the player where player is not winner and team_of(player) is team_of(winner)
        } else {
          // A Dragon-won trick is given to an opponent of the winner's
          // choice; the chosen move banks the pile. Otherwise the winner
          // banks it.
          if tichu_dragon_won() {
            offer to winner one of [dragon_to_left, dragon_to_right]
          } else {
            move all cards from trick_pile to captured[winner]
          }
          leader := winner
        }
        // The lead passes to the winner if they still hold cards, else
        // onward round the ring; when the trick ended the hand there may be
        // nobody to find, and the loop is about to exit.
        if any player where hand[player] is not empty {
          leader := the first player from leader where hand[player] is not empty
        }
      }

      // --- Scoring: double victory is a flat +200 (no card points); otherwise
      // the lone remaining player's hand goes to the opponents and their own
      // captured tricks to the first player out, then each team scores the
      // card points its players captured (100 in play every hand).
      if tichu_double_victory() {
        score[team_of(out_first)] += 200
      } else {
        let last = the player where hand[player] is not empty
        move all cards from hand[last] to captured[last offset_by left]
        move all cards from captured[last] to captured[out_first]
        for each player p: score[team_of(p)] += (sum of card_points(card) over cards in captured[p])
      }
      // Tichu / Grand Tichu settle against going out first.
      for each player p:
        if called[p] > 0 {
          if out_first is not none and p is out_first { score[team_of(p)] += called[p] }
          else { score[team_of(p)] -= called[p] }
        }
    }
  }

  winner: highest score
}

// === Call and Dragon vocabulary ===
//
// Game-defined move_types (the Skat/Doppelkopf shape). Guards read only the
// actor's public standing (their call flag and hand count); effects write
// only public state. The declines are unguarded, so a poll never offers an
// empty candidate set, and a forced decline emits the same public event as a
// chosen one.

move_type call_grand_tichu {
  when: called[actor] is 0
  effect {
    called[actor] := 200
    quiet := 0
  }
}

move_type decline_grand {
  effect { quiet += 1 }
}

move_type call_tichu {
  when: called[actor] is 0 and (not push_done or (number of cards in hand[actor]) is 14)
  effect {
    called[actor] := 100
    quiet := 0
  }
}

move_type no_call {
  effect { quiet += 1 }
}

// The Dragon's gift: the trick goes to the opponent the winner names, and
// lands in that opponent's own pile. Left and right are seat neighbours,
// and in a partnership game both are opponents.
move_type dragon_to_left {
  effect { move all cards from trick_pile to captured[actor offset_by left] }
}

move_type dragon_to_right {
  effect { move all cards from trick_pile to captured[actor offset_by right] }
}

// The public small-tichu gate: someone may still call iff they have not
// called and have not played (pre-push: nobody has played; post-push: a
// full 14-card hand is exactly "unplayed", since only plays shrink it).
function tichu_window_open() =
  any player where called[player] is 0 and (not push_done or (number of cards in hand[player]) is 14)

// Double victory: both recorded finishers are teammates (ends the hand
// early; a flat +200 with no card points).
function tichu_double_victory() =
  out_first is not none and out_second is not none and team_of(out_first) is team_of(out_second)
