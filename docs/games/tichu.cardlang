// Tichu — formalized DSL (parser/checker/runtime target).
//
// Companion to tichu.md. Four-player partnership climbing game on the 56-card
// Tichu deck (standard 52 plus Mahjong, Dog, Phoenix, Dragon). Players push one
// card to each other player, then climb: each play must match the led
// combination's type and length and beat it, or be a bomb, or pass; three passes
// end the trick. First partnership to 1000 wins.
//
// The hand engine — pushing, the climbing trick, the four special cards, the
// finishing order with the double-victory shortcut, and card-point + Tichu-call
// scoring — runs in the built-in `TichuHand` mechanic, which updates `score`
// directly. Card points total 100 each hand. The combination engine, the
// climbing, and the special cards are not expressible in the trick DSL; this is
// a concrete mechanic. Scope reductions (Mahjong wish, Phoenix-in-straights,
// straight-flush bombs, out-of-turn bombs, low random Tichu-call rate) are noted
// in IMPLEMENTATION_LOG.md.

game Tichu {

  players: 4
  partnerships: [[0, 2], [1, 3]]   // partners sit across
  direction: counterclockwise

  cards: tichu56

  zones {
    deck           : Deck
    hand[player]   : Hand<player>
    trick_pile     : TrickPile
    captured[team] : TeamPile<team>
    discard        : Discard          // the Dog goes here (no capture)
  }

  state {
    // Game-level: persists across hands.
    score[team] : Integer = 0
  }

  phase hand_sequence repeats until (any team t: score[t] >= 1000) {
    before_each {
      move all cards to deck
      shuffle deck
      deal 14 cards from deck to each hand
    }

    phase play {
      legal_moves: [play_combination, pass, call_tichu, call_grand_tichu, push_card]
      instantiate TichuHand(starting = 0)
    }
  }

  winner: highest score
}
