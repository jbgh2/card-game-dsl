// Pinochle — formalized DSL (parser/checker/runtime target).
//
// Companion to pinochle.md. Team Bid Pinochle, single (48-card) pack,
// four players in fixed teams sitting across. Each hand: an ascending
// auction, the high bidder names trump (any suit), his partner passes four
// cards across and he passes four back, both sides score their meld, then
// twelve strict tricks score 10 per A/10/K captured plus 10 for the last
// trick. The bidding side must reach its bid in meld + tricks or be set back
// by the bid amount. First team to 150 wins.
//
// Two settlements end a hand before the tricks. The bidders are not "on the
// board" when the bid stands more than 250 above their meld, the whole of the
// trick phase, and after the meld the declarer may throw the hand in instead
// of playing it. Both pay the same: the bidders lose the bid and the
// defenders score their meld and nothing for tricks. A defence that plays the
// hand and takes no trick points has not saved its meld and scores none of it
// — unless that meld was nothing but nines of trump (the "deece"), which save
// themselves.
//
// The whole hand runs in the DSL. The ascending auction runs on the kernel
// `round` (the move vocabulary below, a shrinking participants ring, and
// `pinochle_auction_outcome`). Trump declaration is a one-draw `round offering
// [declare_trump_suit]` guarded by `has_marriage`; meld is a forced (not
// chosen) per-player `pinochle_meld_value(p)` Primitive query, credited to each
// player's team. The twelve strict tricks run on the trick form of `round`,
// legality narrowed by the MustFollowSuit/MustHeadTrick/MustTrumpIfVoid/
// MustOverTrump rule cascade (follow suit and head the trick if able; else
// trump and over-trump if able; else anything). `pinochle_meld_value`'s
// Counter-based tally stays a runtime primitive (cardlang/runtime/pinochle.py) —
// not yet the shared combination model (docs/kernel-migration.md, Workstream 3).

game Pinochle {

  players: 4
  teams: [[0, 2], [1, 3]]   // partners sit across the four-hand ring
  direction: clockwise
  max_length: 1000

  cards: pinochle48
  ranking: ace-ten            // 10 sits between K and A
  card_points { A: 10  10: 10  K: 10  Q: 0  J: 0  9: 0 }

  // The one this game borrows from outside the DSL at a CALL position,
  // implemented in `cardlang/runtime/pinochle.py`. `trump_suit` is declared by
  // `phase hand_sequence`, not by the game, so the read names that phase — and
  // in naming it promises what the resolver then checks: the meld query is
  // called only where `hand_sequence` is running, which is `phase play`, one
  // level inside it.
  //
  // The auction's own outcome query is not here and cannot be: an outcome is
  // named on a `round auction ... outcome` slot, a Primitive namespace the
  // block does not cover (issue #142), so it keeps the `PRIMITIVE_READS` row
  // its dispatch binds.
  primitives {
    pinochle_meld_value(p : Player) : Integer
        reads hand[p], trump_suit in hand_sequence
  }

  zones {
    deck           : Deck
    hand[player]   : Hand<player>
    trick_pile     : TrickPile
    captured[team] : TeamPile<team>
  }

  state {
    // Game-level: persist across hands.
    score[team] : Integer = 0
  }

  phase hand_sequence repeat until (any team where score[team] >= 150) {
    state {
      dealer            : Player  = 0
      trump_suit        : Suit?   = none
      current_bid       : Integer = 0
      high_bidder       : Player? = none
      hand_played       : Boolean = true
      meld_score[team]  : Integer = 0
      // The part of a team's meld that is nines of trump, which score whether
      // or not the side saves its meld.
      deece_meld[team]  : Integer = 0
      trick_score[team] : Integer = 0
      leader            : Player? = none
    }

    before_each {
      move all cards to deck
      shuffle deck
      deal 12 cards from deck to each hand
      dealer := dealer offset_by left
      for each team t: meld_score[t] := 0
      for each team t: deece_meld[t] := 0
      for each team t: trick_score[t] := 0
      hand_played := true
      trump_suit := none
    }

    // The ascending auction settles on a declarer and his bid; the remaining
    // hand (trump declaration, meld, the twelve strict tricks) runs on the
    // kernel below.
    phase auction -> outcome { bid_won(Player, Integer) } {
      // Each non-passed seat — never the standing high bidder — bids the next
      // 10 up (50 to open) or passes for good; the participants ring re-evaluates
      // each turn, so a passed seat or the high bidder is never offered again.
      // The ring shrinks until one seat remains or the 16-bid cap is hit. The
      // 16-bid cap also bounds the bid value: 50 + 15*10 = 200, so no further
      // ceiling is needed (raising the cap would let working_bid exceed 200).
      state {
        passed[player] : Boolean = false
        bids           : Integer = 0
        lead_bidder    : Player? = none   // standing high bidder (auction-local)
        working_bid    : Integer = 0      // his standing bid (auction-local)
        opener         : Player? = none
      }
      opener := dealer offset_by left
      round offering [submit_bid, pass] from opener
            over players where not passed[player]
                              and (lead_bidder is none or player is not lead_bidder)
            until (number of players where not passed[player]) <= 1 or bids >= 16
            outcome pinochle_auction_outcome
    }
    auction produces:
      bid_won(d, c) { high_bidder := d  current_bid := c  continue to play }

    phase play {
      active_rules: [MustFollowSuit, MustHeadTrick, MustTrumpIfVoid, MustOverTrump]
      legal_moves:  [declare_trump_suit, play_to_trick]

      state {
        passes_done : Integer = 0
        thrown_in   : Boolean = false
        decided     : Boolean = false
      }

      // The high bidder names trump. Any suit: the rules put no condition on
      // the choice.
      round offering [declare_trump_suit] from high_bidder
            over players where player is high_bidder
            until trump_suit is not none

      // The exchange: the declarer's partner passes four across, then the
      // declarer passes four back, which may include cards just received.
      round offering [pass_four] from high_bidder offset_by across
            over players where player is (high_bidder offset_by across)
            until passes_done >= 1
      round offering [pass_four] from high_bidder
            over players where player is high_bidder
            until passes_done >= 2

      // Meld is forced (a rational player melds everything) — a pure
      // computation per player, credited to his team.
      for each player p: meld_score[team_of(p)] += pinochle_meld_value(p)
      for each player p: deece_meld[team_of(p)] +=
            10 * (number of cards in hand[p]
                    where card.suit is trump_suit and card.rank is "9")

      // On the board? A bid standing more than the whole trick phase above the
      // bidders' meld cannot be made, so the hand is not played. Otherwise the
      // declarer may still throw it in.
      if current_bid > meld_score[team_of(high_bidder)] + 250 {
        hand_played := false
      } else {
        round offering [throw_in, play_on] from high_bidder
              over players where player is high_bidder
              until decided
        if thrown_in {
          hand_played := false
        } else {
          // Twelve strict tricks: high bidder leads; A/10/K score 10 each and
          // the last trick 10 (card_points reads the game's declared table).
          leader := high_bidder
          repeat until (all players where hand[player] is empty) {
            round play_to_trick from leader over all players source hand into trick_pile
                  winner highest_trump_or_led_suit trump trump_suit
            trick_score[team_of(winner)] += sum of card_points(card) over cards in trick_pile
            move all cards from trick_pile to captured[team_of(winner)]
            leader := winner
          }
          trick_score[team_of(leader)] += 10   // ten for the last trick
        }
      }
    }

    phase scoring {
      if not hand_played {
        // Not on the board, or thrown in: the bidders lose the bid, and the
        // defenders score their meld with nothing for tricks, which were never
        // played.
        for each team t:
          if t is team_of(high_bidder) {
            score[t] -= current_bid
          } else {
            score[t] += meld_score[t]
          }
      } else {
        for each team t:
          if t is team_of(high_bidder) {
            if team_score_in_hand(t) >= current_bid {
              score[t] += team_score_in_hand(t)
            } else {
              score[t] -= current_bid
            }
          } else {
            score[t] += saved_meld(t) + trick_score[t]
          }
      }
    }
  }

  winner: highest score
}

// === Auction move vocabulary ===
//
// The bid value is derived, not chosen: 50 to open, then a fixed 10 higher each
// time. A seat either bids that or passes for good — the participants ring then
// drops it. `submit_bid` is nullary (contrast Bridge, whose bid names a strain).

move_type submit_bid {
  effect {
    working_bid := if working_bid is 0 then 50 else working_bid + 10
    lead_bidder := actor
    bids        := bids + 1
  }
}

move_type pass {
  effect { passed[actor] := true }
}

// A team's total for the hand: meld plus tricks. Named so the bidder's
// make-the-bid test and every team's payout add the same total from one place.
function team_score_in_hand(t : Team) = meld_score[t] + trick_score[t]

// What a defending side's meld is worth once the tricks are in. Taking any
// trick point saves the whole meld; taking none loses it, except a meld that
// was nothing but nines of trump, which save themselves. The last trick is
// worth 10, so a side that took it has a positive trick score.
function saved_meld(t : Team) =
  if trick_score[t] > 0 then meld_score[t]
  elif meld_score[t] is deece_meld[t] then deece_meld[t]
  else 0

// Trump declaration: the candidate list is `Suit` in deck order, all four of
// them. Winning the auction is the whole qualification the rules ask for.
move_type declare_trump_suit(s : Suit) {
  effect { trump_suit := s }
}

// The exchange. Exactly four cards each way — the `chosen 4` count IS the law,
// as it is for Hearts' pass. The declarer's partner plays this first and the
// declarer second, so the declarer's four may include cards just received.
move_type pass_four {
  effect {
    move chosen 4 cards from hand[actor] to hand[actor offset_by across]
    passes_done := passes_done + 1
  }
}

// After the meld the declarer either concedes the hand or plays it out. The
// concession pays what being off the board pays, which is why a side with no
// chance prefers it: the defenders take no trick points because there are no
// tricks.
move_type throw_in {
  effect { thrown_in := true  decided := true }
}

move_type play_on {
  effect { decided := true }
}

// === Pinochle strict-trick legality (rule DSL) ===
//
// The cascade reproduces the classic obligation: follow suit and head the
// trick if able; if void, trump and over-trump if able; else anything. Each
// rule's `if_impossible: hand` intersects the running set with the whole
// hand — i.e. "keep the prior narrowing" — so an inapplicable obligation
// falls through (rules.legal_cards).

// MustFollowSuit is a standard-library rule (library.md "Rules"): activated
// by name above, defined once in cardlang/stdlib/rules.cardlang.

// The duty is to beat the card CONTROLLING the trick. On a trump lead that is
// the highest trump, and a led-suit card can reach it. On a plain-suit lead a
// trump already in the trick controls it, and no card of the led suit can beat
// a trump — so the duty lapses and any card of the led suit is legal, which is
// what MustFollowSuit alone then leaves.
rule MustHeadTrick {
  constrains: play_to_trick
  applies_when: state.led_suit is not none and
                (state.led_suit is trump_suit or
                 not (any card in trick_pile where card.suit is trump_suit))
  demands: cards in hand where card.suit is state.led_suit and
             rank_value(card) > (highest rank_value(card) over cards in trick_pile
               where card.suit is state.led_suit or -1)
  if_impossible: hand   // cannot head (or is void): the prior narrowing stands
}

rule MustTrumpIfVoid {
  constrains: play_to_trick
  applies_when: state.led_suit is not none
  demands: cards in hand where card.suit is trump_suit
  if_impossible: hand   // holds the led suit, or has no trump
}

rule MustOverTrump {
  constrains: play_to_trick
  applies_when: state.led_suit is not none and
                (any card in trick_pile where card.suit is trump_suit)
  demands: cards in hand where card.suit is trump_suit and
             rank_value(card) > (highest rank_value(card) over cards in trick_pile
               where card.suit is trump_suit or -1)
  if_impossible: hand   // cannot over-trump: any trump (or the prior set) stands
}
