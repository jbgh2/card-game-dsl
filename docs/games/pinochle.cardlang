// Pinochle — formalized DSL (parser/checker/runtime target).
//
// Companion to pinochle.md. Partnership Bid Pinochle, single (48-card) pack,
// four players in fixed partnerships sitting across. Each hand: an ascending
// auction, the high bidder names trump (a suit he holds a marriage in, else he
// abandons the bid), both sides score their meld, then twelve strict tricks
// score 10 per A/10/K captured plus 10 for the last trick. The bidding side must
// reach its bid in meld + tricks or be set back by the bid amount. First team to
// 150 wins.
//
// The ascending auction runs on the kernel `round` (the move vocabulary below,
// a shrinking participants ring, and `pinochle_auction_outcome`). Trump
// declaration, meld scoring, and the strict follow/head/trump/over-trump trick
// play run in the `PinochleRest` mechanic (strict-trick legality is not yet
// expressible in the rule DSL; see IMPLEMENTATION_LOG.md). The cardlang holds
// the deal, the auction, the contract settlement, and termination.

game Pinochle {

  players: 4
  partnerships: [[0, 2], [1, 3]]   // partners sit across the four-hand ring
  direction: clockwise

  cards: pinochle48
  ranking: A 10 K Q J 9            // 10 sits between K and A

  zones {
    deck           : Deck
    hand[player]   : Hand<player>
    trick_pile     : TrickPile
    captured[team] : TeamPile<team>
  }

  state {
    // Game-level: persist across hands.
    score[team] : Integer = 0
  }

  phase hand_sequence repeats until (any team t: score[t] >= 150) {
    state {
      dealer            : Player  = 0
      trump_suit        : Suit?   = none
      current_bid       : Integer = 0
      high_bidder       : Player? = none
      bid_abandoned     : Boolean = false
      meld_score[team]  : Integer = 0
      trick_score[team] : Integer = 0
    }

    before_each {
      move all cards to deck
      shuffle deck
      deal 12 cards from deck to each hand
      dealer := dealer offset_by left
      for each team t: meld_score[t] := 0
      for each team t: trick_score[t] := 0
      bid_abandoned := false
    }

    // The ascending auction settles on a declarer and his bid; the remaining
    // hand (trump declaration, meld, the twelve strict tricks) runs in the
    // PinochleRest mechanic, which still holds the strict follow/head/trump
    // legality not yet expressible in the rule DSL.
    phase auction -> outcome { bid_won(Player, Integer) } {
      // Each non-passed seat — never the standing high bidder — bids the next
      // 10 up (50 to open) or passes for good; the participants ring re-evaluates
      // each turn, so a passed seat or the high bidder is never offered again.
      // The ring shrinks until one seat remains or the bid cap (16 bids) is hit.
      state {
        passed[player] : Boolean = false
        bids           : Integer = 0
        lead_bidder    : Player? = none   // standing high bidder (auction-local)
        working_bid    : Integer = 0      // his standing bid (auction-local)
        opener         : Player? = none
      }
      opener := dealer offset_by left
      round offering [submit_bid, pass] from opener
            over players where not passed[player]
                              and (lead_bidder is none or player != lead_bidder)
            until (number of players where not passed[player]) <= 1 or bids >= 16
            outcome pinochle_auction_outcome
    }
    auction produces:
      bid_won(d, c) { high_bidder := d  current_bid := c  continue to play }

    phase play {
      legal_moves: [declare_trump_suit, play_to_trick]
      instantiate PinochleRest(declarer = high_bidder)
    }

    phase scoring {
      if bid_abandoned {
        // The bidder found no marriage to name trump: set back by the bid.
        score[team_of(high_bidder)] -= current_bid
      } else {
        for each team t:
          if t == team_of(high_bidder) {
            if meld_score[t] + trick_score[t] >= current_bid {
              score[t] += meld_score[t] + trick_score[t]
            } else {
              score[t] -= current_bid
            }
          } else {
            score[t] += meld_score[t] + trick_score[t]
          }
      }
    }
  }

  winner: highest score
}

// === Auction move vocabulary ===
//
// The bid value is derived, not chosen: 50 to open, then a fixed 10 higher each
// time. A seat either bids that or passes for good — the participants ring then
// drops it. `submit_bid` is nullary (contrast Bridge, whose bid names a strain).

move_type submit_bid {
  effect {
    working_bid := if working_bid == 0 then 50 else working_bid + 10
    lead_bidder := actor
    bids        := bids + 1
  }
}

move_type pass {
  effect { passed[actor] := true }
}
