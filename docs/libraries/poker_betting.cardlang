// Fixed-limit poker betting — the family library every poker game in the corpus
// imports. "Betting proceeds as in standard poker" is the rulebook sentence a
// game's `uses poker_betting` line stands in for, and this file is that sentence
// written out. The membership is not listed here: a consumer joins on arrival
// simply by writing `uses poker_betting`, and a count in this comment would go
// stale silently the next time one does. `tests/metamorphic/test_inline.py`'s
// `test_the_library_procedure_games_are_pinned_as_uncovered` holds the current
// set, derived and pinned in both directions.
//
// What is here is the ZONE-FREE core: check, bet, call, raise, the three ring
// predicates that keep a betting round's `over` filter and `until` terminator
// naming the same set, and `open_street` — the one procedure a street opens
// with. Every one of them touches chips and betting bookkeeping and nothing
// else, which is why this library's state surface names no zone.
//
// What is deliberately NOT here is `fold`. Folding is the one betting move that
// touches cards, and which cards — and where they go — is a property of the
// game, not of the family: Stud sends the folder's upcards to the muck the
// instant they fold (opponents stop seeing them, and that is an observation
// their information sets carry), while Kuhn and Leduc simply end the player's
// hand. A move touching a game-specific zone stays game-local; the library holds
// the part that is genuinely the same. Each game defines its own `fold` and
// offers it alongside the four imported moves in one vocabulary list.
//
// Variation across the family is carried by state the game declares and sets,
// not by parameters on the import. `raise_cap` — the number of AGGRESSIONS
// allowed per street, counting the opening bet, so Kuhn 1, Leduc 2, Stud 3 and
// both Hold'em variants 4 — is a per-GAME constant, so it is required: provided
// state has exactly one default and no default is right for every consumer. The
// "including the opening bet" half is load-bearing rather than pedantic: `bet`
// sets `raises := 1` and `raise` gates on `raises < raise_cap`, so a game
// reading the cap as "raises on top of a bet" plays a street one bet longer
// than it declares. `limit` is not a per-game constant at all but a per-STREET one
// (Stud runs 5/5/10/10/10), so no declaration could carry it either; it is
// provided, and `open_street` takes it as an argument, which puts the bet size
// at the street it belongs to rather than in a state block far away.

library poker_betting {

  // State this library OWNS. The game may read these — and does not, today —
  // but may not write them: they are pure intra-street bookkeeping, maintained
  // entirely by the move types and `open_street` below. `limit` is 0 between
  // streets, which is the reading of "no street is open"; no move runs then.
  state {
    acted[player] : Boolean = false   // has acted since the last aggression
    limit         : Integer = 0       // the open street's bet size
  }

  // What the including game must declare. Checked at its `uses` line, so an
  // unmet requirement is reported in the game's currency rather than as an
  // undeclared name inside text the author did not write. Each is here because
  // a game genuinely touches it: the four chip variables and `folded` are
  // written by antes, settlements and each game's own `fold`, and `raises` by
  // Stud's bring-in, which counts a forced opening post as the street's first
  // aggression. `raise_cap` is the family's one per-game constant.
  requires {
    stack[player]     : Integer   // chips held
    committed[player] : Integer   // chips put in this hand (for side pots)
    bet_by[player]    : Integer   // chips put in on the current street
    folded[player]    : Boolean   // out of the hand
    bet_to_match      : Integer   // the street's standing bet
    raises            : Integer   // raises so far on this street
    raise_cap         : Integer   // raises allowed per street
  }

  // Open a betting street at a bet size of `bet_size`: no standing bet, no
  // aggression yet, nobody owing and nobody yet acted. Every street in the
  // family opens exactly this way and differs only in the size, which is what
  // makes it one procedure rather than a block repeated per street. A game that
  // opens its street with a forced post (Stud's bring-in) runs this first and
  // then posts, so the post's own bookkeeping is not undone.
  procedure open_street(bet_size : Integer) {
    bet_to_match := 0
    raises := 0
    limit := bet_size
    for each player p: bet_by[p] := 0
    for each player p: acted[p] := false
  }

  // Betting-ring predicates. `pending` composes the others; the round's `over`
  // filter and its `until` terminator must name the same set, or the priority
  // ring will not close exactly when it empties.
  function can_act(p : Player) = not folded[p] and stack[p] > 0
  function owes(p : Player)    = bet_by[p] < bet_to_match
  function pending(p : Player) = can_act(p) and (not acted[p] or owes(p))

  move_type check {
    when: bet_to_match <= bet_by[actor]
    effect { acted[actor] := true }
  }

  // A bet is a partial all-in when the actor cannot cover the limit.
  move_type bet {
    when: bet_to_match is 0
    effect {
      let post = if limit < stack[actor] then limit else stack[actor]
      stack[actor] := stack[actor] - post
      committed[actor] := committed[actor] + post
      bet_by[actor] := bet_by[actor] + post
      bet_to_match := bet_by[actor]
      raises := 1
      for each player p: acted[p] := false
      acted[actor] := true
    }
  }

  move_type call {
    when: bet_to_match > bet_by[actor]
    effect {
      let owed = bet_to_match - bet_by[actor]
      let pay = if owed < stack[actor] then owed else stack[actor]
      stack[actor] := stack[actor] - pay
      committed[actor] := committed[actor] + pay
      bet_by[actor] := bet_by[actor] + pay
      acted[actor] := true
    }
  }

  // Aggression re-opens the action: every other player's `acted` is cleared, so
  // seats that already acted this street owe a response again.
  //
  // A raise needs someone able to ANSWER it. Facing opponents who are all-in,
  // the only legal actions are call and fold — raising into a field that cannot
  // respond is not a poker decision, and offering it puts a node in the game
  // tree the rules do not have. The chips still come out right either way (the
  // side-pot layering returns an uncalled excess to its sole contributor), so
  // no conservation check can see this clause: it is about the ACTION SPACE.
  // A raise must also be able to RAISE. A stack that cannot cover more than the
  // call pays what it has and leaves `bet_to_match` where it was — so offering
  // `raise` there would bump `raises` and clear everyone's `acted`, reopening
  // action that nobody reopened. A short all-in is a call, and `call` already
  // pays it correctly.
  move_type raise {
    when: bet_to_match > bet_by[actor] and raises < raise_cap
          and (number of players where can_act(player)) > 1
          and stack[actor] > bet_to_match - bet_by[actor]
    effect {
      let owed = bet_to_match - bet_by[actor]
      let want = owed + limit
      let pay = if want < stack[actor] then want else stack[actor]
      stack[actor] := stack[actor] - pay
      committed[actor] := committed[actor] + pay
      bet_by[actor] := bet_by[actor] + pay
      bet_to_match := if bet_to_match > bet_by[actor] then bet_to_match else bet_by[actor]
      raises := raises + 1
      for each player p: acted[p] := false
      acted[actor] := true
    }
  }
}
