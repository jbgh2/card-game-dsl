  when: discard_pile is not empty and last_discard_rank == "7" and
        (has_melded[team_of(actor)] or (sum over hand[actor] as c: if c.rank == "7" then point_value(c) else 0) >= 50) and
        (naturals_of(actor, "7") >= 2 or
         (naturals_of(actor, "7") >= 1 and meld_seven[team_of(actor)] is not empty and not frozen_for(team_of(actor))))
  effect {
    move all cards from discard_pile to hand[actor]
    pile_has_wild := false
