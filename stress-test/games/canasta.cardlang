// --- Discard (exactly one per turn, unless melding emptied the hand) ---
// Suit is irrelevant throughout Canasta, so "which specific card of a rank
// leaves the hand" never matters — the default (non-`chosen`) movement mode
// deterministically takes the first match, no chooser draw spent on it.

move_type discard_two {
  when: naturals_of(actor, "2") > 0
  effect {
    move one card from hand[actor] where c => c.rank == "2" to discard_pile
    last_discard_rank := "2"
    pile_has_wild := true
  }
}

move_type discard_three {
  when: naturals_of(actor, "3") > 0
  effect {
    move one card from hand[actor] where c => c.rank == "3" to discard_pile
    last_discard_rank := "3"
  }
}

move_type discard_four {
  when: naturals_of(actor, "4") > 0
  effect {
    move one card from hand[actor] where c => c.rank == "4" to discard_pile
    last_discard_rank := "4"
  }
}

