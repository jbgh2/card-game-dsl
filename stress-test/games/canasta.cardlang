        (has_melded[team_of(actor)] or (sum over hand[actor] as c: if c.rank == "8" then point_value(c) else 0) >= 50) and
        (naturals_of(actor, "8") >= 2 or
         (naturals_of(actor, "8") >= 1 and meld_eight[team_of(actor)] is not empty and not frozen_for(team_of(actor))))
  effect {
