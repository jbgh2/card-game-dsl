// --- Melding (any number per turn; `stop_melding` always legal) ---

move_type stop_melding {
  effect { melding_done := true }
}

// Twos meld naturally (no separate wild concept applies to a meld of 2s).
move_type meld_two {
  when: (has_melded[team_of(actor)] or (sum over hand[actor] as c: if c.rank == "2" then point_value(c) else 0) >= 50)
        and (naturals_of(actor, "2") >= 3 or meld_two[team_of(actor)] is not empty)
  effect {
    move all cards from hand[actor] where c => c.rank == "2" to meld_two[team_of(actor)]
    has_melded[team_of(actor)] := true
  }
}

move_type meld_four {
  when: (has_melded[team_of(actor)] or (sum over hand[actor] as c: if c.rank == "4" then point_value(c) else 0) >= 50)
        and (naturals_of(actor, "4") >= 3 or meld_four[team_of(actor)] is not empty)
  effect {
    move all cards from hand[actor] where c => c.rank == "4" to meld_four[team_of(actor)]
    let existing_wild = sum over meld_four[team_of(actor)] as c: if c.rank == "2" then 1 else 0
    let existing_natural = sum over meld_four[team_of(actor)] as c: if c.rank != "2" then 1 else 0
    let available_twos = sum over hand[actor] as c: if c.rank == "2" then 1 else 0
    let wild_room = min2(min2(existing_natural - existing_wild, 3 - existing_wild), available_twos)
    move wild_room cards from hand[actor] where c => c.rank == "2" to meld_four[team_of(actor)]
    has_melded[team_of(actor)] := true
  }
}

move_type meld_five {
  when: (has_melded[team_of(actor)] or (sum over hand[actor] as c: if c.rank == "5" then point_value(c) else 0) >= 50)
        and (naturals_of(actor, "5") >= 3 or meld_five[team_of(actor)] is not empty)
  effect {
    move all cards from hand[actor] where c => c.rank == "5" to meld_five[team_of(actor)]
    let existing_wild = sum over meld_five[team_of(actor)] as c: if c.rank == "2" then 1 else 0
    let existing_natural = sum over meld_five[team_of(actor)] as c: if c.rank != "2" then 1 else 0
    let available_twos = sum over hand[actor] as c: if c.rank == "2" then 1 else 0
    let wild_room = min2(min2(existing_natural - existing_wild, 3 - existing_wild), available_twos)
