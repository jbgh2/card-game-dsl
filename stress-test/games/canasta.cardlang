        (has_melded[team_of(actor)] or (sum over hand[actor] as c: if c.rank == "6" then point_value(c) else 0) >= 50) and
        (naturals_of(actor, "6") >= 2 or
         (naturals_of(actor, "6") >= 1 and meld_six[team_of(actor)] is not empty and not frozen_for(team_of(actor))))
  effect {
    move all cards from discard_pile to hand[actor]
    pile_has_wild := false
    move all cards from hand[actor] where c => c.rank == "6" to meld_six[team_of(actor)]
