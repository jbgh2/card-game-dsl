// =============================================================================
// === Functions ===
// =============================================================================

// Smallest of two integers — `min`/`max` are not callable stdlib functions
// (only usable as a `sum`/`max`/`min` zone-comprehension aggregator, a
// different construct), so wild-cap arithmetic uses this instead.
function min2(a : Integer, b : Integer) = if a < b then a else b

function is_red_three(c : Card) = c.rank == "3" and (c.suit == hearts or c.suit == diamonds)

// Card-point table (Pagat's basic-rules table minus the joker row, which
// cannot exist under the single-52-card-pack simplification — see cut 1).
function point_value(c : Card) =
  if c.rank == "2" then 20
  elif c.rank == "A" then 20
  elif c.rank == "K" then 10
  elif c.rank == "Q" then 10
  elif c.rank == "J" then 10
  elif c.rank == "10" then 10
  elif c.rank == "9" then 10
  elif c.rank == "8" then 10
  else 5

function naturals_of(p : Player, r : String) = sum over hand[p] as c: if c.rank == r then 1 else 0

// A pile is frozen against a partnership if a wild card has ever hit it
// since it last emptied, or the partnership hasn't melded yet this hand.
function frozen_for(t : Team) = pile_has_wild or not has_melded[t]

function team_has_canasta(t : Team) =
  (count over meld_two[t]   as c: true) >= 7 or
  (count over meld_four[t]  as c: true) >= 7 or
  (count over meld_five[t]  as c: true) >= 7 or
  (count over meld_six[t]   as c: true) >= 7 or
  (count over meld_seven[t] as c: true) >= 7 or
  (count over meld_eight[t] as c: true) >= 7 or
  (count over meld_nine[t]  as c: true) >= 7 or
  (count over meld_ten[t]   as c: true) >= 7 or
  (count over meld_jack[t]  as c: true) >= 7 or
  (count over meld_queen[t] as c: true) >= 7 or
  (count over meld_king[t]  as c: true) >= 7 or
  (count over meld_ace[t]   as c: true) >= 7

function meld_points_of(t : Team) =
  (sum over meld_two[t]   as c: point_value(c)) +
  (sum over meld_four[t]  as c: point_value(c)) +
  (sum over meld_five[t]  as c: point_value(c)) +
  (sum over meld_six[t]   as c: point_value(c)) +
  (sum over meld_seven[t] as c: point_value(c)) +
  (sum over meld_eight[t] as c: point_value(c)) +
  (sum over meld_nine[t]  as c: point_value(c)) +
  (sum over meld_ten[t]   as c: point_value(c)) +
  (sum over meld_jack[t]  as c: point_value(c)) +
  (sum over meld_queen[t] as c: point_value(c)) +
  (sum over meld_king[t]  as c: point_value(c)) +
  (sum over meld_ace[t]   as c: point_value(c))

function hand_penalty_of(p : Player) = sum over hand[p] as c: point_value(c)

function red_three_bonus(t : Team) =
  if has_melded[t]
  then 100 * (count over red_threes[t] as c: true)
  else 0 - 100 * (count over red_threes[t] as c: true)

// Natural canasta (no wild 2s inside) = 500; mixed canasta (has wild 2s) =
// 300. The twos meld is always natural (2s melding 2s isn't "wild" of
// itself), so it's a flat 500 with no mixed check.
function canasta_bonus_of(t : Team) =
  (if (count over meld_two[t] as c: true) >= 7 then 500 else 0) +
  (if (count over meld_four[t] as c: true) >= 7 then
     (if (sum over meld_four[t] as c: if c.rank == "2" then 1 else 0) == 0 then 500 else 300) else 0) +
  (if (count over meld_five[t] as c: true) >= 7 then
     (if (sum over meld_five[t] as c: if c.rank == "2" then 1 else 0) == 0 then 500 else 300) else 0) +
  (if (count over meld_six[t] as c: true) >= 7 then
     (if (sum over meld_six[t] as c: if c.rank == "2" then 1 else 0) == 0 then 500 else 300) else 0) +
  (if (count over meld_seven[t] as c: true) >= 7 then
     (if (sum over meld_seven[t] as c: if c.rank == "2" then 1 else 0) == 0 then 500 else 300) else 0) +
  (if (count over meld_eight[t] as c: true) >= 7 then
     (if (sum over meld_eight[t] as c: if c.rank == "2" then 1 else 0) == 0 then 500 else 300) else 0) +
  (if (count over meld_nine[t] as c: true) >= 7 then
     (if (sum over meld_nine[t] as c: if c.rank == "2" then 1 else 0) == 0 then 500 else 300) else 0) +
  (if (count over meld_ten[t] as c: true) >= 7 then
     (if (sum over meld_ten[t] as c: if c.rank == "2" then 1 else 0) == 0 then 500 else 300) else 0) +
  (if (count over meld_jack[t] as c: true) >= 7 then
     (if (sum over meld_jack[t] as c: if c.rank == "2" then 1 else 0) == 0 then 500 else 300) else 0) +
  (if (count over meld_queen[t] as c: true) >= 7 then
     (if (sum over meld_queen[t] as c: if c.rank == "2" then 1 else 0) == 0 then 500 else 300) else 0) +
  (if (count over meld_king[t] as c: true) >= 7 then
     (if (sum over meld_king[t] as c: if c.rank == "2" then 1 else 0) == 0 then 500 else 300) else 0) +
  (if (count over meld_ace[t] as c: true) >= 7 then
     (if (sum over meld_ace[t] as c: if c.rank == "2" then 1 else 0) == 0 then 500 else 300) else 0)
