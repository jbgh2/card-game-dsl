// Crazy Eights — formalized DSL (stress test).
//
// Source: https://www.pagat.com/eights/crazy8s.html
//
// Shedding game: players discard cards matching the rank or suit of the top
// discard. Eights are wild. First to shed wins; others score penalty points.
//
// MAJOR GAPS ENCOUNTERED:
//
// 1. Rank literals and Rank variables: Cannot assign rank literals to Rank variables.
//    `top_rank := 8` fails with type mismatch. Rank is a type distinct from integers.
//    Workaround needed for differentiated scoring by rank (8s → 50 pts, faces → 10 pts).
//
// 2. Zone initialization: No operation moves cards to non-player zones without
//    a chooser. "move chosen 1 card" requires player context. "deal" requires
//    player recipients. Cannot initialize the discard pile from deck in setup.
//
// 3. Card observation: Round form doesn't expose state.played. Cannot extract
//    which card was just played, so dynamic play constraints cannot update.
//    Suit/rank matching rules must be hardcoded (non-functional).
//
// 4. First-player selection: player_holding(card) can fail if card isn't dealt.
//    dealer variable is not automatically available. initial_dealer is not
//    a recognized name. No syntax for "the first player" or "any player."
//    Workaround: use before_each hook with a fixed player selection per iteration.
//
// 5. Custom move types: Cannot define play_card, draw_card types. Only stdlib
//    types available (play_to_trick, transfer, etc.).
//
// 6. Forced draw on unplayable: Rules cannot express "must draw if unable to play."
//    if_impossible fallback is either hand (any card) or error (fail).
//
// IMPLEMENTATION: Minimal shedding game that plays cards in turn order with
// no suit/rank constraints. Scoring is uniform (1 point per card).

game CrazyEights {

  players: 4
  direction: clockwise

  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2

  zones {
    deck       : Deck
    hand[player] : Hand<player>
    discard    : Discard
  }

  state {
    score[player] : Integer = 0
  }

  phase setup {
    shuffle deck
    deal 5 cards from deck to each hand
    // GAP: Cannot initialize the discard pile. Operations available:
    // - move all cards: would empty deck (wrong)
    // - move chosen X: requires a chooser/player context (setup has none)
    // - deal: requires player recipients (discard is not a player)
    // Leave discard empty; first card played will populate it.
  }

  phase play repeats until (any player p: hand[p] is empty) {
    // Play until one player sheds.
    active_rules: []
    legal_moves: [play_to_trick]

    state {
      leader : Player? = none
    }

    before_each {
      // GAP: No clean way to get "first player" without explicit selection syntax.
      // Player selection routines (player_holding) can fail if the card isn't dealt.
      // For now, leave leader as none and hope the round's turn_order logic
      // handles it (it doesn't; this is a blocker).
      // Ideally: leader := initial_player or leader := any_player_with_cards.
    }

    // Play one round. GAP: Cannot extract which card was played (no state.played),
    // so dynamic suit/rank constraints are impossible. No rules are enforced.
    round play_to_trick from leader over all players
          source hand into discard outcome highest_of_led_suit
    leader := outcome
  }

  phase scoring {
    // Simplified uniform scoring: 1 point per card held.
    // Real Crazy Eights: 50 for 8s, 10 for face cards, pip value for 2–9.
    // GAP: Rank type system prevents rank-based conditionals. Workaround would be
    // to check every card individually (c == 8 of spades or ... or c == 8 of clubs),
    // but this is verbose and error-prone. Ideal: if c.rank in [8] then 50 ...
    let hand_score[p] = sum over hand[p] as c: 1

    for each player p: score[p] := hand_score[p]
  }

  winner: lowest score
}
