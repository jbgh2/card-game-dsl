// Knockout Whist — formalized DSL (parser/checker/runtime target).
//
// Source: https://www.pagat.com/whist/kowhist.html
// A trick-taking game of progressive elimination across seven hands.
//
// Simplified rules:
// - Fixed 3 players (official rules support 2-7 players)
// - Trump always determined by top undealt card (official rules: winner of
//   previous hand selects trump for next hand; selection is skipped in this DSL version)
// - Skipped optional "dog's life" mechanic (one-card rescue for the first
//   eliminated player; also skipped the tiebreaker "cutting cards" for trump selection)
//
// These simplifications let us focus on the core mechanic: trick-taking with
// progressive mid-game elimination based on taking zero tricks.

game KnockoutWhist {

  players: 3
  direction: clockwise

  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2

  zones {
    deck              : Deck
    hand[player]      : Hand<player>
    trump_indicator   : Discard       // the face-up trump card for this hand
    trick_pile        : TrickPile
    captured[player]  : PlayerPile<player>
  }

  state {
    alive[player] : Integer = 1   // 1 = still in game, 0 = eliminated
  }

  phase hand_sequence repeats until hand_index >= 7 {
    state {
      hand_index             : Integer = 0
      hand_size              : Integer = 0
      dealer                 : Player = 0
      leader                 : Player? = none
      tricks_this_hand[player] : Integer = 0
      trump_suit             : Suit? = none
    }

    before_each {
      move all cards to deck
      shuffle deck

      // Hand sizes descend: 7, 6, 5, 4, 3, 2, 1
      hand_size := 7 - hand_index

      // Deal only to players still alive
      for each player p:
        if alive[p] == 1 { deal hand_size cards from deck to hand[p] }

      // Turn up trump from the undealt stock
      deal 1 card from deck to trump_indicator
      trump_suit := suit_of(trump_indicator)

      // Reset trick count for this hand
      for each player p: tricks_this_hand[p] := 0

      // Dealer rotates left; leader is dealer's left
      dealer := dealer offset_by left
      leader := dealer offset_by left
    }

    phase play {
      active_rules: [MustFollowSuit]
      legal_moves:  [play_to_trick]

      // Play tricks until all cards are gone or only one player remains
      repeat until (all player p: hand[p] is empty or alive[p] == 0) {
        round play_to_trick from leader over players where alive[player] == 1
              source hand into trick_pile
              outcome highest_trump_or_led_suit trump trump_suit
        move all cards from trick_pile to captured[outcome]
        tricks_this_hand[outcome] += 1
        leader := outcome
      }
    }

    phase elimination {
      // Any player who took zero tricks is eliminated
      for each player p:
        if alive[p] == 1 and tricks_this_hand[p] == 0 { alive[p] := 0 }
    }

    after_each {
      hand_index += 1
    }
  }

  winner: highest alive
}

// === Standard library rule ===

rule MustFollowSuit {
  constrains: play_to_trick
  applies_when: state.led_suit is not none
  demands: hand.cards_of_suit(state.led_suit)
  if_impossible: hand   // void in the led suit: play any card
}
