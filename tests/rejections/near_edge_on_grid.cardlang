// Guard: resolve's board availability row (cardlang/resolve/,
// `_check_board_call`, `BOARD_VERB_NEEDS`). `near_edge` reads each seat's
// two borders; a `grid` declares none, so the call is refused naming the
// family and the verbs it answers.
game NearEdgeOnGrid {
  players: 2
  max_length: 30
  board: grid(8, 8)
  pieces: xo_marks
  zones {
    box             : Deck
    square[cell]    : Cell<cell>
    reserve[player] : PlayerPile<player>
  }
  state { score[player] : Integer = 0  done : Boolean = false }
  phase setup {
    move all pieces from box to reserve[0]
  }
  phase play {
    turns t from 0 over all players until done {
      offer to t one of [place, stop]
    }
  }
  winner: highest score
}
move_type place(at : cell) {
  when: (square[at] is empty) and (at in near_edge(actor))
  effect { move one piece from reserve[actor] to square[at] }
}
move_type stop { effect { done := true } }
