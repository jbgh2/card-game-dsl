// Guard: parse.py's `primitives_default_reject` (diagnostics.lark). An entry
// declares a signature, never a body; the state-row habit writes `= <expr>`.
game PrimitivesDefaultValue {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  primitives { f(p : Player) : Integer reads hand[p] = 1 }
  zones {
    deck : Deck
    table : Discard
    hand[player] : Hand<player>
  }
  state { score[player] : Integer = 0 }
  phase play {
    deal 3 cards from deck to each hand
    score[0] := 1
  }
  winner: highest score
}
