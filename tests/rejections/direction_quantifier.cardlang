// Guard: resolve's `_check_domain_query`. `dir` is the board direction
// domain a `board:` mints, and a board game quantifies over it (`any dir
// where ...`); this game declares no `board:`, so nothing mints `dir`, and the
// quantifier is refused naming the missing clause.
game DirQuantifier {
  players: 2
  max_length: 20
  pieces: xo_marks
  zones {
    box             : Deck
    reserve[player] : PlayerPile<player>
  }
  state {
    result[player] : Integer = 0
    done : Boolean = false
  }
  phase setup {
    move all pieces from box where piece.side is x to reserve[0]
    move all pieces from box to reserve[1]
  }
  phase play {
    turns t from 0 over all players until done {
      offer to t one of [pick, stop]
    }
  }
  winner: highest result
}
move_type pick {
  when: any dir where not done
  effect { done := true }
}
move_type stop { effect { done := true } }
