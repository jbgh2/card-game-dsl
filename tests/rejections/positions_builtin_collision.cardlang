// Wall: resolve.py `_resolve_positions`. A declared position may not
// reuse a built-in domain id or type spelling, nor a name the game
// declares as a `type`: the reconciliation between those sources and
// the per-game block is rejection, so lookups that consult positions
// first can never shadow a row or a struct. Three sources, one wall —
// the declared-type source was added after a review found `positions
// { R : 1..4 }` beside `type R` silently reading the struct as the
// position's Integer.
game PositionsBuiltinCollision {
  players: 1
  direction: clockwise
  max_length: 100
  cards: standard52
  positions { player : 1..4 }
  zones {
    deck : Deck
    pile[player] : Cascade<player>
  }
  state {
    resigned : Boolean = false
    score[player] : Integer = 0
    }
  phase setup { shuffle deck }
  phase play {
    turns t from 0 over all players until resigned {
      offer to t one of [quit]
    }
    }
  winner: highest score
}
move_type quit { effect { resigned := true } }
