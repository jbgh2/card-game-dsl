// Guard: resolve.py `_resolve_positions`. A declared position may not
// reuse a name from any namespace in `POSITION_NAME_SOURCES`: the
// reconciliation between those sources and the per-game block is
// rejection, so lookups that consult positions first can never shadow a
// row, a zone type, a struct or a quantifier noun. The diagnostic names
// the source that was hit rather than listing the namespaces it might
// have been — the sources accumulate, and a prose list of them goes
// stale silently. The whole registry is swept in tests/test_positions.py;
// this case pins the rendering.
game PositionsBuiltinCollision {
  players: 1
  direction: clockwise
  max_length: 100
  cards: standard52
  positions { player : 1..4 }
  zones {
    deck : Deck
    pile[player] : Cascade<player>
  }
  state {
    resigned : Boolean = false
    score[player] : Integer = 0
    }
  phase setup { shuffle deck }
  phase play {
    turns t from 0 over all players until resigned {
      offer to t one of [quit]
    }
    }
  winner: highest score
}
move_type quit { effect { resigned := true } }
