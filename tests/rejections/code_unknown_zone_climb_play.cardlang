// A minimal climbing game over a combination catalogue: the probe base the
// catalogue grid edits one clause of at a time. Four players climb singles
// out of a standard 52; a play follows a standing play of as many cards, and
// the first player out scores a point.

game Climb {

  players: 4
  max_length: 5000

  cards: standard52
  ranking: twos high

  zones {
    deck         : Deck
    hand[player] : Hand<player>
    trick_pile   : TrickPile
    discard      : Discard
  }

  state {
    score[player] : Integer = 0
    leader        : Player? = none
    opened : Boolean = false
  }

  phase hand_sequence repeat until (any player where score[player] >= 1) {
    before_each {
      move all cards to deck
      shuffle deck
      deal 13 cards from deck to each hand
      leader := 0
    }

    phase play {
      legal_moves: [play_combination]

      repeat until (any player where hand[player] is empty) {
        round climb play_combination from leader
              over players where hand[player] is not empty
              source hand into trik_pile
              combinations tichu_lead_options follows tichu_follows
              until (any player where hand[player] is empty)
        move all cards from trick_pile to discard
        leader := winner
      }
    }

    phase scoring {
      for each player p:
        if hand[p] is empty {
          score[p] += 1
        }
    }
  }

  winner: highest score
}



function climb_follows(x : Integer) = x > 0
