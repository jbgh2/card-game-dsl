// Wall: resolve's declared-type-name check on a user function's parameters.
// `Integar` is a typo for `Integer`. Before this wall the name fell through
// `typecheck.type_from_name` to the permissive `TAny`, so the body's
// `x is hearts` — an always-false Integer/Suit comparison the checker rejects
// when the parameter is spelled correctly — was silently accepted. Making a
// type name WORSE must never make the checker MORE permissive.
game UnknownTypeFunctionParam {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones { deck : Deck  hand[player] : Hand<player> }
  state { score[player] : Integer = 0 }
  phase play { for each player p: score[p] := 1 }
  winner: highest score
}

function f(x : Integar) = x is hearts
