// Guard: the `payload_type` teaching twin, carrying the collection's optional
// spelling too. The four parameter hosts and the outcome payloads all reach
// this one production, so a function parameter is where the shared half of the
// twin is sampled.
game CollectionOptionalAtAFunctionParameter {
  players: 2
  max_length: 100
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones { deck : Deck  hand[player] : Hand<player> }
  state { score[player] : Integer = 0 }
  phase play {
    score[0] := 1
  }
  winner: highest score
}
function meld_size(cs : Collection<Card>?) = 1
