// Guard: resolve's `_check_winner_target`, the one Owner Guard for a
// result ranking's target, addressed to the slot it fires in.
game StopResultRankingUnindexed {
  players: 2
  max_length: 30
  at max_length: highest done
  cards: standard52
  zones { deck : Deck  hand[player] : Hand<player> }
  state { coins[player] : Integer = 0  done : Boolean = false }
  phase play {
    turns t from 0 over all players until done {
      as t { offer to t one of [stop] }
    }
  }
  winner: highest coins
}
move_type stop { effect { done := true } }
