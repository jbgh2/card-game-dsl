// Guard: resolve.py `_check_bare_family_refs`. A round's `source` is the
// zone each player plays from, keyed by the acting seat, so it names a
// family kept per player. The runtime refusal in `mechanics` is the Shadow
// Guard.
game RoundSourceTeamFamily {
  players: 4
  teams: [[0, 2], [1, 3]]
  direction: clockwise
  max_length: 200
  cards: standard52
  ranking: aces high
  zones {
    deck : Deck
    shared[team] : Hand<team>
    trick_pile : TrickPile
  }
  state { score[team] : Integer = 0 }
  phase deal_out { shuffle deck  deal 26 cards from deck to shared[0]  move all cards from deck to shared[1] }
  phase play {
    legal_moves: [play_to_trick]
    round play_to_trick from 0 over all players source shared into trick_pile
          winner highest_trump_or_led_suit
  }
  winner: highest score
}
