// Guard: resolve's domain-query check. `any <noun> where` ranges over a
// position domain the game declares, and this game declares none.
game AnyOverUnknownPositionDomain {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones { deck : Deck  hand[player] : Hand<player> }
  state { score[player] : Integer = 0 }
  phase p {
    for each player q: score[q] := 0
    if any column where true { score[0] := 1 }
  }
  winner: highest score
}
