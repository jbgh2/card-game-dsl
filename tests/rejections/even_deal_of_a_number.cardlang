// Guard: typecheck's even-deal check. An even deal splits the whole
// source, so its amount is `all`, never a number.
game EvenDealOfANumber {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones { deck : Deck  hand[player] : Hand<player>  pile : TrickPile }
  state { score[player] : Integer = 0 }
  phase p {
    for each player q: score[q] := 0
    deal 10 cards from deck as-equally-as-possible to each hand
  }
  winner: highest score
}
