// Guard: parse.py's `collection_phrase_reject`. The issue's own spelling and
// the one a reader of the design note writes first: no declaration in this
// language spells a type as a phrase, so the phrase form is taught back as the
// ruled one rather than dying at the lexer.
game PrimitivesCollectionPhraseForm {
  players: 2
  max_length: 100
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  primitives {
    gin_valid_meld(cards : collection of Card) : Boolean
  }
  zones { deck : Deck  hand[player] : Hand<player> }
  state { score[player] : Integer = 0 }
  phase play {
    score[0] := if gin_valid_meld(hand[0]) then 1 else 0
  }
  winner: highest score
}
