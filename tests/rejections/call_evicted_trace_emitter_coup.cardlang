// Guard: resolve.py's unknown-call check. `coup_note_reveal` was Coup's trace
// emitter, evicted to the harness layer (primitive-sidecars stage 1;
// tests/playout_trace.py derives the reveal sequence instead). An author
// copying the old rules text's `let noted = coup_note_reveal(...)` gets the
// standard unknown-function diagnostic, not a silent no-op.
game CallEvictedTraceEmitterCoup {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones {
    deck : Deck
    hand[player] : Hand<player>
  }
  state { score[player] : Integer = 0 }
  phase play {
    deal 3 cards from deck to each hand
    let noted = coup_note_reveal(0)
  }
  winner: highest score
}
