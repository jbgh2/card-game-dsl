
game G {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones { deck : Deck  hand[player] : Hand<player> }
  state { score[player] : Integer = 0  flag : Boolean = false }
  phase round {
    phase decide -> outcome { a } when flag { produce a }
    decide produces:
      a { score[0] += 1 }
  }
  winner: highest score
}
