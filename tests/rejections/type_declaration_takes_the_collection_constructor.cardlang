// Guard: resolve's type-declaration reservation site, over the block's
// collection constructor word. A game declaring `type Collection` would make
// `x : Collection<Card>` readable two ways in the one slot that spells it.
game TypeDeclarationTakesTheCollectionConstructor {
  players: 2
  max_length: 100
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones { deck : Deck  hand[player] : Hand<player> }
  state { score[player] : Integer = 0 }
  phase play {
    score[0] := 1
  }
  winner: highest score
}
type Collection = { size : Integer }
