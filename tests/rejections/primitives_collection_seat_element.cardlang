// Guard: resolve's `_check_primitives_block` element allow-list. `Player` is a
// declarable type name and `Collection<Player>` is a type the checker mints
// for `all players` — but no registered Primitive is implemented over one, so
// the element list refuses it until a witness arrives.
game PrimitivesCollectionSeatElement {
  players: 2
  max_length: 100
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  primitives {
    gin_valid_meld(cards : Collection<Player>) : Boolean
  }
  zones { deck : Deck  hand[player] : Hand<player> }
  state { score[player] : Integer = 0 }
  phase play {
    score[0] := if gin_valid_meld(hand[0]) then 1 else 0
  }
  winner: highest score
}
