// Guard: resolve.py `_check_duplicate_names` (the position namespace
// joins every other declaration namespace's uniqueness sweep).
game PositionsDuplicateName {
  players: 1
  direction: clockwise
  max_length: 100
  cards: standard52
  positions { column : 1..3  column : 1..4 }
  zones {
    deck : Deck
    pile[column] : Cascade<column>
  }
  state {
    resigned : Boolean = false
    score[player] : Integer = 0
    }
  phase setup { shuffle deck }
  phase play {
    turns t from 0 over all players until resigned {
      offer to t one of [quit]
    }
    }
  winner: highest score
}
move_type quit { effect { resigned := true } }
