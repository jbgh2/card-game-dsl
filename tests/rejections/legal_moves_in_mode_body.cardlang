// Wall: the grammar's `?mode_item`. `window` is a mode — a condition, whose
// body is configuration only — so a `legal_moves:` there is consulted by no
// runtime consumer and would be silently ignored. The move menu is set by the
// phase you are in, never toggled by a condition, so this is a parse error
// rather than a dropped clause: the earliest layer that can own the class.

game LegalMovesInModeBody {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones {
    deck : Deck
    hand[player] : Hand<player>
    trick_pile : TrickPile
  }
  state { score[player] : Integer = 0 }
  phase play {
    legal_moves: [play_to_trick]
    mode window {
      active_rules: [+ MustFollowSuit]
      legal_moves: [play_to_trick]
    }
  }
  winner: highest score
}
