// Guard: parse.py's `collection_type_reject` on `type_name`. Cards outside a
// zone are the second source of truth decisions.md "Meld groups: flattened
// zone families" refuses — the group IS the zone — so the state row cannot
// spell one either.
game CollectionAtAStateRow {
  players: 2
  max_length: 100
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones { deck : Deck  hand[player] : Hand<player> }
  state { melded : Collection<Card> = 0
          score[player] : Integer = 0 }
  phase play {
    score[0] := 1
  }
  winner: highest score
}
