// Guard: parse.py's `trump_string_reject` (diagnostics.lark). The trump suit
// is named bare; a quoted string where the name belongs is refused naming
// the spelling.
game TrumpAsString {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  trump: "spades"
  zones {
    deck : Deck
    table : Discard
    hand[player] : Hand<player>
  }
  state { score[player] : Integer = 0 }
  phase play {
    deal 3 cards from deck to each hand
    score[0] := 1
  }
  winner: highest score
}
