// Guard: parse.py's `subset_plus_reject` (diagnostics.lark). `+` reads as
// addition; two zones for a Subset Source are bracketed.
game SubsetSourcePlusJoined {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones {
    deck : Deck
    table : Discard
    hand[player] : Hand<player>
  }
  state { score[player] : Integer = 0 }
  phase play {
    deal 3 cards from deck to each hand
    score[0] := number of subsets of 2 cards in table + hand[0] where 1 is 1
  }
  winner: highest score
}
