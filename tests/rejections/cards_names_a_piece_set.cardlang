// Guard: resolve.py's `_resolve_component_set`, the cross-flavor arm — the
// mirror of pieces_names_a_deck. `xo_marks` is a known PIECE set, so the
// fix is the other clause, not another deck name.
game CardsNamesAPieceSet {
  players: 2
  cards: xo_marks
  max_length: 10
  state { score[player] : Integer = 0 }
  winner: highest score
}
