// Guard: the type layer's collection quantifier source. `any cell in ...`
// iterates one line, but `neighbors(c)` is a Collection<Cell>; the
// membership spelling `any cell where (cell in neighbors(c)) and ...` is the
// one a game writes.
game NeighborsCollectionQuantifier {
  players: 2
  max_length: 30
  board: morris9
  pieces: xo_marks
  zones {
    box             : Deck
    point[cell]     : Cell<cell>
    reserve[player] : PlayerPile<player>
  }
  state { score[player] : Integer = 0  done : Boolean = false }
  phase setup {
    move all pieces from box to reserve[0]
  }
  phase play {
    turns t from 0 over all players until done {
      offer to t one of [place, stop]
    }
  }
  winner: highest score
}
move_type place(at : cell) {
  when: point[at] is empty
  effect { move one piece from reserve[actor] to point[at] }
}
move_type stop { effect { done := true } }
function crowded(c : cell) = any cell in neighbors(c) where point[cell] is empty
