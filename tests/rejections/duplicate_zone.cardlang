// Guard: resolve.py's `_check_duplicate_names` over the zone namespace. `deck`
// is declared twice; the later declaration would otherwise silently shadow
// the earlier one (accepted-but-ignored at the declaration level).
game DuplicateZone {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones {
    deck : Deck
    deck : Deck
    hand[player] : Hand<player>
  }
  state { score[player] : Integer = 0 }
  phase play {
    deal 3 cards from deck to each hand
  }
  winner: highest score
}
