// Guard: resolve.py's `_check_hosted_polls`. A Hosted Poll's body runs
// between two asks of a live climbing trick, where only decisions and state
// writes may happen; a card movement ("discard before playing") would change
// the hands and the pile the trick is reading.
game HostedPollCardMovement {
  players: 4
  teams: [[0, 2], [1, 3]]
  direction: counterclockwise
  max_length: 5000
  cards: tichu56
  zones {
    deck             : Deck
    hand[player]     : Hand<player>
    trick_pile       : TrickPile
    captured[player] : PlayerPile<player>
  }
  state {
    score[player] : Integer = 0
    wish          : Integer = 0
    leader        : Player = 0
  }
  phase play {
    legal_moves: [play_combination]
    shuffle deck
    deal 14 cards from deck to each hand
    leader := player_holding(Mahjong of special)
    round climb play_combination from leader
          over players where hand[player] is not empty
          source hand into trick_pile
          combinations tichu_lead_options follows tichu_follows
          until (number of players where hand[player] is not empty) <= 1
          before asking seat {
            move one card from hand[seat] to captured[seat]
          }
  }
  winner: highest score
}
