// Guard: resolve.py's `_check_read_tail`. A tail on a name the GAME declares:
// meaningless rather than harmless, since a game-level declaration stands
// wherever the game runs. Accepting it would be the accepted-but-ignored class
// one slot over, so it is refused and told to drop the tail.
game ScopedReadOnGameState {
  players: 2
  max_length: 100
  cards: pinochle48
  ranking: A 10 K Q J 9
  primitives {
    pinochle_meld_value(p : Player) : Integer reads hand[p], trump_suit, meld[p] in outer
  }
  zones { deck : Deck  hand[player] : Hand<player> }
  state { meld[player] : Integer = 0  trump_suit : Suit? = spades }
  phase outer {
    deal 12 cards from deck to each hand
    meld[0] := pinochle_meld_value(0)
  }
  winner: highest meld
}
