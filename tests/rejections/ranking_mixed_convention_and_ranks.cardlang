// Wall: resolve.py `_resolve_ranking`. A convention keyword mixed with
// explicit ranks has no single reading — the whole clause is taken as an
// enumeration (the convention spellings are reserved only for an EXACT
// full-clause match), so the convention words reject as unknown ranks,
// with the hint pointing at the convention set.
game RankingMixedConventionAndRanks {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: aces high A K Q
  zones {
    deck : Deck
    hand[player] : Hand<player>
  }
  state { score[player] : Integer = 0 }
  phase play {
    deal 3 cards from deck to each hand
  }
  winner: highest score
}
