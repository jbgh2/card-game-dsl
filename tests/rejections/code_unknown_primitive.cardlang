game Probe {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  primitives { probe_fn(x : Card) : Card }
  zones { deck : Deck  hand[player] : Hand<player>
          discard : Discard }
  state { trump_suit : Suit? = none
          seen[player] : Integer = 0
          score[player] : Integer = 0 }
  phase play {
    trump_suit := spades
    move all cards from deck as-equally-as-possible to each hand
    score[0] := 1
  }
  winner: highest score
}
