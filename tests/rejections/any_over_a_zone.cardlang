// Guard: resolve's domain-query check. `any <noun> in <zone> where` with a noun
// that names no collection reads as a position domain; `pile` is a zone, whose matching cards are
// `cards in pile where <pred>`.
game AnyOverAZone {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones { deck : Deck  hand[player] : Hand<player>  pile : TrickPile }
  state { score[player] : Integer = 0 }
  phase p {
    for each player q: score[q] := 0
    if any column in pile where true { score[0] := 1 }
  }
  winner: highest score
}
