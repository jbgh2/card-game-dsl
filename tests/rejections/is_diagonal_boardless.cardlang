// Wall: resolve's board-only wall (cardlang/resolve.py::_check_board_call,
// BOARD_ONLY_CALL_FUNCS). `is_diagonal` reads the `board:` entry; a boardless game
// has no board, so the call is rejected at resolve -- the `lines` twin.
game IsDiagonalBoardless {
  players: 2
  direction: clockwise
  max_length: 30
  pieces: xo_marks
  zones {
    box          : Deck
    pile[player] : PlayerPile<player>
  }
  state { n : Integer = 0  done : Boolean = false }
  phase play {
    turns t from 0 over all players until done {
      offer to t one of [foo, stop]
    }
  }
  winner: highest n
}
move_type foo {
  effect {
    let x = is_diagonal(n)
    done := true
  }
}
move_type stop { effect { done := true } }
