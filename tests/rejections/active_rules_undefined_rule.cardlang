// Wall: resolve.py's `active_rules:` referent check. `Nonexistent` names no
// rule declared in this game (and no library rule), so the reference is
// rejected before the rule set is ever instantiated.
game ActiveRulesUndefinedRule {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones {
    deck : Deck
    hand[player] : Hand<player>
  }
  state { score[player] : Integer = 0 }
  phase play {
    active_rules: [Nonexistent]
  }
  winner: highest score
}
