// Guard: typecheck.py's `_check_state_default_type`. A state variable may be
// typed by the board's `cell` domain, and a cell is no number, so an Integer
// default does not fit it. The board is otherwise valid (it mints `cell`);
// only the default `0` is the defect.
game BoardCellStateVar {
  players: 2
  max_length: 20
  board: grid(3, 3)
  pieces: xo_marks
  zones { box : Deck  reserve[player] : PlayerPile<player> }
  state { score[player] : Integer = 0  foo : cell = 0 }
  phase play { move all pieces from box where piece.side is x to reserve[0] }
  winner: highest score
}
