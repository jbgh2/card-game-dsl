// Guard: resolve.py's `_validate_refs` StateDecl arm (KNOWN_TYPE_NAMES). A
// board-minted position domain (`cell`) is an index/parameter domain, never a
// declarable state TYPE -- position-typed state stays rejected. The board is
// otherwise valid (it mints `cell`); only `foo : cell` is the defect.
game BoardCellStateVar {
  players: 2
  max_length: 20
  board: grid(3, 3)
  pieces: xo_marks
  zones { box : Deck  reserve[player] : PlayerPile<player> }
  state { score[player] : Integer = 0  foo : cell = 0 }
  phase play { move all pieces from box where piece.side is x to reserve[0] }
  winner: highest score
}
