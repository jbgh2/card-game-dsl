// Guard: typecheck's deal-distribution check. An even deal goes round the
// zones in turn, so it cannot also be a random selection.
game EvenDealRandom {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones { deck : Deck  hand[player] : Hand<player>  pile : TrickPile }
  state { score[player] : Integer = 0 }
  phase p {
    for each player q: score[q] := 0
    deal random all cards from deck as-equally-as-possible to each hand
  }
  winner: highest score
}
