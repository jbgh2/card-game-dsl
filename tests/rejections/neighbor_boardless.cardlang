// Guard: resolve's board-only guard (cardlang/resolve.py::_check_board_call,
// BOARD_ONLY_CALL_FUNCS). `neighbor` reads the `board:` entry; a boardless game
// has no board, so the call is rejected at resolve -- the `lines` twin.
game NeighborBoardless {
  players: 2
  direction: clockwise
  max_length: 30
  pieces: xo_marks
  zones {
    box          : Deck
    pile[player] : PlayerPile<player>
  }
  state { n : Integer = 0  done : Boolean = false  score[player] : Integer = 0 }
  phase play {
    turns t from 0 over all players until done {
      offer to t one of [foo, stop]
    }
  }
  winner: highest score
}
move_type foo {
  effect {
    let x = neighbor(n, n, n)
    done := true
  }
}
move_type stop { effect { done := true } }
