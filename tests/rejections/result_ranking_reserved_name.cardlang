// Guard: parse.py's `_reserved_result_name_hint`. A state variable may be
// named for a clause keyword, but a result ranking may not rank it: the word
// is reserved where a ranking's name ends, so the next clause is never read
// as one.
game ResultRankingReservedName {
  players: 2
  max_length: 30
  cards: standard52
  zones { deck : Deck  hand[player] : Hand<player> }
  state { pieces[player] : Integer = 0  done : Boolean = false }
  phase play {
    turns t from 0 over all players until done {
      as t { offer to t one of [stop] }
    }
  }
  winner: highest pieces
}
move_type stop { effect { done := true } }
