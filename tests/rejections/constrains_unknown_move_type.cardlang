// Wall: resolve.py's `_resolve_rule` constrains check. `nonesuch_move` names
// no library move type (cardlang/stdlib LIBRARY_MOVE_TYPES), so the rule's
// `constrains:` target is rejected before the rule is ever instantiated.
game ConstrainsUnknownMoveType {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones {
    deck : Deck
    hand[player] : Hand<player>
  }
  state { score[player] : Integer = 0 }
  phase play {
    deal 3 cards from deck to each hand
  }
  winner: highest score
}
rule BadConstrains {
  constrains: nonesuch_move
}
