game G {
  players: 2
  max_length: 50
  cards: standard52
  zones {
    deck : Deck
    hand[player] : Hand<player>
    pile : Discard
  }
  state { score[player] : Integer = 0  bid : Integer = 0  done : Boolean = false }
  phase play {
    
    shuffle deck
    deal 1 card from deck to each hand
    shuffle hand
  }
  winner: highest score
}

