// Wall: typecheck.py's subscript-legality check. `total` is a bare Integer,
// not a collection, so indexing it with `[p]` is rejected rather than
// crashing at runtime on an unsubscriptable value.
game SubscriptNonCollection {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones { deck : Deck  hand[player] : Hand<player> }
  state { score[player] : Integer = 0  total : Integer = 0 }
  phase play {
    for each player p:
      score[p] := total[p]
  }
  winner: highest score
}
