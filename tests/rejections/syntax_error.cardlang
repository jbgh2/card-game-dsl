// Guard: parse.py's `UnexpectedInput` wrapping. The `zones {` block is never
// closed, so the grammar itself cannot recognize what follows — rejected at
// parse time, before resolve/typecheck ever run.
game SyntaxError {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones {
    deck : Deck
    hand[player] : Hand<player>
  state { score[player] : Integer = 0 }
  phase play {
    deal 3 cards from deck to each hand
  }
  winner: highest score
}
