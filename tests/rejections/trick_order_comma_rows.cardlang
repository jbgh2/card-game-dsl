// Guard: parse.py's `trick_order_comma_reject` (diagnostics.lark). Rows are
// whitespace-separated like every block clause; the list habit puts commas.
game TrickOrderCommaRows {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  trick_order { trump: card.suit is spades, follow_class: card.suit, card_strength: card.rank }
  zones {
    deck : Deck
    table : Discard
    hand[player] : Hand<player>
  }
  state { score[player] : Integer = 0 }
  phase play {
    deal 3 cards from deck to each hand
    score[0] := 1
  }
  winner: highest score
}
