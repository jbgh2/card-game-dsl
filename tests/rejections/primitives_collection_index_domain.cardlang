// Guard: resolve's `_check_primitives_block` element check. The confusion a
// designer who has written `Hand<player>` all day makes: angle brackets whose
// meaning is fixed by the head, and a collection's head takes what it HOLDS.
game PrimitivesCollectionIndexDomain {
  players: 2
  max_length: 100
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  primitives {
    gin_valid_meld(cards : Collection<player>) : Boolean
  }
  zones { deck : Deck  hand[player] : Hand<player> }
  state { score[player] : Integer = 0 }
  phase play {
    score[0] := if gin_valid_meld(hand[0]) then 1 else 0
  }
  winner: highest score
}
