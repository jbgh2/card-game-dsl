// Wall: resolve.py `_check_move_params`. A misspelled position name
// in a parameter domain is rejected with the declared positions
// listed beside the built-in domains.
game PositionsParamDomainTypo {
  players: 1
  direction: clockwise
  max_length: 100
  cards: standard52
  positions { column : 1..3 }
  zones {
    deck : Deck
    pile[column] : Cascade<column>
  }
  state {
    resigned : Boolean = false
    score[player] : Integer = 0
    }
  phase setup { shuffle deck }
  phase play {
    turns t from 0 over all players until resigned {
      offer to t one of [quit, mv]
    }
    }
  winner: highest score
}
move_type mv(c : colum) {
  when: pile[c] is not empty
  effect { resigned := true }
}
move_type quit { effect { resigned := true } }
