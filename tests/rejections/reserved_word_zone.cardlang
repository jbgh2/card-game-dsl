// Guard: resolve.py's `_check_reserved`, run over the zone namespace by
// `_check_duplicate_names`. `state` is a fixed context pronoun
// (`state.foo`); a zone declared under that name would silently change
// what a bare `state` reference means, so it is rejected outright.
game ReservedWordZone {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones {
    deck : Deck
    hand[player] : Hand<player>
    state : Discard
  }
  state { score[player] : Integer = 0 }
  phase play {
    deal 3 cards from deck to each hand
  }
  winner: highest score
}
