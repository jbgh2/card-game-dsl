// Guard: parse.py's `div_symbol`, refusing `/` naming the rounded division
// spellings through the diagnostic grammar's `factor` extension.
game OperatorSlash {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones {
    deck : Deck
    hand[player] : Hand<player>
  }
  state { score[player] : Integer = 0 }
  phase play {
    deal 3 cards from deck to each hand
    score[0] := score[1] / 2
  }
  winner: highest score
}
