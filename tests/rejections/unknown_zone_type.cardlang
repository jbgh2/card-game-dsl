// Guard: resolve.py's zone-type reference check. `Nonesuch` names no library
// zone type (cardlang/stdlib/zones.py's LIBRARY_ZONE_TYPES), so the zone
// declaration itself is rejected before anything downstream runs.
game UnknownZoneType {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones {
    deck : Deck
    hand[player] : Hand<player>
    pile : Nonesuch
  }
  state { score[player] : Integer = 0 }
  phase play {
    deal 3 cards from deck to each hand
  }
  winner: highest score
}
