// Guard: resolve.py's `_check_scoped_read_containment`. The entry reads state
// only `outer` declares, so it is callable only where `outer` runs; this call
// sits in a sibling phase, where that frame is gone.
game ScopedReadCalledOutside {
  players: 2
  max_length: 100
  cards: pinochle48
  ranking: A 10 K Q J 9
  primitives {
    pinochle_meld_value(p : Player) : Integer reads hand[p], trump_suit in outer
  }
  zones { deck : Deck  hand[player] : Hand<player> }
  state { meld[player] : Integer = 0 }
  phase outer {
    state { trump_suit : Suit? = spades }
    deal 12 cards from deck to each hand
  }
  phase later {
    meld[0] := pinochle_meld_value(0)
  }
  winner: highest meld
}
