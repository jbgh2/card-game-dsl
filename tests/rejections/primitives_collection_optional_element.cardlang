// Guard: the grammar's entry-slot reject twin. An absence inside a set has no
// rulebook reading, so an optional ELEMENT is refused with the filter that
// says what the designer meant.
game PrimitivesCollectionOptionalElement {
  players: 2
  max_length: 100
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  primitives {
    gin_valid_meld(cards : Collection<Suit?>) : Boolean
  }
  zones { deck : Deck  hand[player] : Hand<player> }
  state { score[player] : Integer = 0 }
  phase play {
    score[0] := if gin_valid_meld(hand[0]) then 1 else 0
  }
  winner: highest score
}
