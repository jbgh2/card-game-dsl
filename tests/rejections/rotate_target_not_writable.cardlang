// Guard: resolve's write-target check (`_bad_write_target`). A `rotate`
// writes a state variable, and `deck` is a zone; the refusal stands at the
// name, not at the `rotate` keyword.
game RotateTargetNotWritable {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones { deck : Deck  hand[player] : Hand<player> }
  state {
    score[player] : Integer = 0
    side : SeatDirection = left
  }
  phase play {
    rotate deck through [left, right]
  }
  winner: highest score
}
