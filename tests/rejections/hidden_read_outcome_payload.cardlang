// Guard: resolve.py's `_check_hidden_reads`, a value read where it is
// consumed. Seat 1 counts its own hearts into a phase outcome, and every seat
// then discards that many: a count only seat 1 could see decides the others'
// picks. A phase outcome is not announced, so the count is a hidden read at
// each consuming seat.
game HiddenReadOutcomePayload {
  players: 2
  max_length: 20
  cards: standard52
  zones {
    deck         : Deck
    hand[player] : Hand<player>
    table        : Discard
  }
  state {
    score[player] : Integer = 0
  }
  phase setup {
    shuffle deck
    deal 5 cards from deck to each hand
  }
  phase count -> outcome { hearts(Integer) } {
    as 1 { produce hearts(number of cards in hand[1] where card.suit is hearts) }
  }
  phase discard {
    count produces:
      hearts(k) { for each player p: move chosen (k) cards from hand[p] to table }
  }
  winner: highest score
}
