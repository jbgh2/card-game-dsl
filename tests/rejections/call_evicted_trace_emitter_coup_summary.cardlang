// Guard: resolve.py's unknown-call check. `coup_game_summary` was Coup's
// end-of-game trace emitter, evicted to the harness layer
// (primitive-sidecars stage 3; tests/playout_trace.py reads the terminal
// state instead). An author copying the old rules text's dead
// `let summary = coup_game_summary()` gets the standard unknown-function
// diagnostic, not a silent no-op.
game CallEvictedTraceEmitterCoupSummary {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones {
    deck : Deck
    hand[player] : Hand<player>
  }
  state { score[player] : Integer = 0 }
  phase play {
    deal 3 cards from deck to each hand
    let summary = coup_game_summary()
  }
  winner: highest score
}
