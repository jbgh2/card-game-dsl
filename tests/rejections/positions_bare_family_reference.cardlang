// Guard: resolve.py `_check_bare_family_refs`. A family named bare is the
// acting player's own instance, and no player owns a position's zone, so a
// position family named bare is refused with the subscript to write. The
// runtime refusal in `evaluate._name` is the Shadow Guard.
game PositionsBareFamilyReference {
  players: 1
  direction: clockwise
  max_length: 100
  cards: standard52
  positions { column : 1..3 }
  zones {
    deck : Deck
    pile[column] : Cascade<column>
  }
  state {
    resigned : Boolean = false
    score[player] : Integer = 0
    }
  phase setup { shuffle deck }
  phase play {
    turns t from 0 over all players until resigned {
      offer to t one of [quit]
    }
    if pile is empty { resigned := true }
  }
  winner: highest score
}
move_type quit { effect { resigned := true } }
