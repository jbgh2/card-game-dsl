// Wall: resolve.py `_check_position_family_refs`. The bare-family
// actor sugar (`hand` = the acting player's hand) keys by SEAT; a
// position family has no seat keys, so a bare reference must be
// subscripted. The runtime's phantom-key error is the backstop.
game PositionsBareFamilyReference {
  players: 1
  direction: clockwise
  max_length: 100
  cards: standard52
  positions { column : 1..3 }
  zones {
    deck : Deck
    pile[column] : Cascade<column>
  }
  state {
    resigned : Boolean = false
    score[player] : Integer = 0
    }
  phase setup { shuffle deck }
  phase play {
    turns t from 0 over all players until resigned {
      offer to t one of [quit]
    }
    if pile is empty { resigned := true }
  }
  winner: highest score
}
move_type quit { effect { resigned := true } }
