// Guard: resolve.py's `_check_read_tails_nest`. The phases an entry's `reads`
// clause names lie on ONE ancestor path, and the entry is callable only where
// the innermost of them runs. `outer` and `later` are siblings: a phase's
// frame is popped when the phase ends, so no position in this game runs both
// and the entry could never be called anywhere. A designed constraint, not a
// deferral — splitting the entry is no fix, since one caller would need both
// values in a place that does not exist.
game ScopedReadTwoPhases {
  players: 2
  max_length: 100
  cards: pinochle48
  ranking: A 10 K Q J 9
  primitives {
    pinochle_meld_value(p : Player) : Integer reads hand[p], trump_suit in outer, bonus in later
  }
  zones { deck : Deck  hand[player] : Hand<player> }
  state { meld[player] : Integer = 0 }
  phase outer {
    state { trump_suit : Suit? = spades }
    deal 12 cards from deck to each hand
    meld[0] := pinochle_meld_value(0)
  }
  phase later {
    state { bonus : Integer = 0 }
    meld[1] := bonus
  }
  winner: highest meld
}
