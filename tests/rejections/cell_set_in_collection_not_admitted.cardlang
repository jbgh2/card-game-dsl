// Guard: the Diagnostic Grammar. The position set takes no source: cells
// live on the board, so `cells in <expr> where …` (the card register's
// `cards in <zone> where` habit) is not the language, and its twin
// (`cell_set_in_collection_reject`) names the set form, `cells where <pred>`.
game CellSetInCollection {
  players: 2
  direction: clockwise
  max_length: 20
  board: grid(3, 3)
  pieces: xo_marks
  zones {
    box             : Deck
    square[cell]    : Cell<cell>
    reserve[player] : PlayerPile<player>
  }
  state {
    done : Boolean = false
  }
  phase play {
    turns t from 0 over all players until done {
      offer to t one of [place]
    }
  }
  winner: highest done
}

move_type place(at : cell) {
  when: at in (cells in home(actor) where square[cell] is empty)
  effect { move one piece from reserve[actor] to square[at] }
}
