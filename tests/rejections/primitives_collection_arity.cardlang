// Guard: the grammar's entry-slot reject twin. A collection takes one element
// type; a second argument is a keyed or paired shape the language has no
// reading for, so the sentence is taught back as the ruled one rather than
// stopped at the comma.
game PrimitivesCollectionArity {
  players: 2
  max_length: 100
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  primitives {
    gin_valid_meld(cards : Collection<Card, Card>) : Boolean
  }
  zones { deck : Deck  hand[player] : Hand<player> }
  state { score[player] : Integer = 0 }
  phase play {
    score[0] := if gin_valid_meld(hand[0]) then 1 else 0
  }
  winner: highest score
}
