// Guard: resolve.py `_expand_ranking`. A ranking convention orders the
// standard A..2 rank set; a deck with ranks outside it (tichu56's specials
// here — tarot78's atouts and coup15's characters are the same cell) has no
// place for them in any template, so silently filtering would produce a
// partial ranking nobody wrote. Rejected with the offending ranks named.
game RankingConventionNonFrenchDeck {
  players: 2
  max_length: 1000
  cards: tichu56
  ranking: aces high
  zones {
    deck : Deck
    hand[player] : Hand<player>
  }
  state { score[player] : Integer = 0 }
  phase play {
    deal 3 cards from deck to each hand
  }
  winner: highest score
}
