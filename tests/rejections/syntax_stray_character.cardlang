// Guard: parse.py's failure rendering, the non-word-shaped lexeme arm. A
// character the language spells nowhere is quoted back as the designer typed
// it, so the reported position and the character agree — a stray keystroke is
// the one syntax error whose fix is visible from the message alone.
game SyntaxStrayCharacter {
  players: 2 @
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones {
    deck : Deck
    hand[player] : Hand<player>
  }
  state { score[player] : Integer = 0 }
  phase play {
    deal 3 cards from deck to each hand
  }
  winner: highest score
}
