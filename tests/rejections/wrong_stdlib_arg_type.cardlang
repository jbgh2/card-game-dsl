// Guard: typecheck.py's stdlib call-signature check. `player_holding` expects
// a Card; `hearts` is a Suit.
game WrongStdlibArgType {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones { deck : Deck  hand[player] : Hand<player> }
  state { score[player] : Integer = 0  dealer : Player = 0 }
  phase play {
    dealer := player_holding(hearts)
  }
  winner: highest score
}
