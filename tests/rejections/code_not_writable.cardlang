
game P {
  players: 3
  direction: clockwise
  max_length: 30
  cards: standard52
  zones { deck : Deck  hand[player] : Hand<player>  pile : Discard }
  state { score[player] : Integer = 0  turn : Player = 0  pass_dir : SeatDirection = left }
  phase p {
    deal 3 cards from deck to each hand
    deck := 1
  }
  winner: highest score
}

