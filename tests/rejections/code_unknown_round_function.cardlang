
game G {
  players: 4
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones { deck : Deck  hand[player] : Hand<player>  trick_pile : TrickPile  captured[player] : PlayerPile<player> }
  state { leader : Player? = none  trump_suit : Suit? = none  score[player] : Integer = 0 }
  phase play {
    active_rules: [MustFollowSuit]
    legal_moves: [play_to_trick]
    round play_to_trick from leader over all players source hand into trick_pile winner highest_of_led_suit early nope_predicate
    leader := winner
  }
  winner: highest score
}
