// Guard: the grammar. A collection is never optional — `is empty` is its
// absence — and the shape is made inexpressible rather than refused by a pass:
// the entry's type slot composes the element with neither the `?` arm nor a
// second type argument, so `Collection<Card>?` has no derivation at all.
game PrimitivesCollectionOptional {
  players: 2
  max_length: 100
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  primitives {
    gin_valid_meld(cards : Collection<Card>?) : Boolean
  }
  zones { deck : Deck  hand[player] : Hand<player> }
  state { score[player] : Integer = 0 }
  phase play {
    score[0] := if gin_valid_meld(hand[0]) then 1 else 0
  }
  winner: highest score
}
