// Guard: the grammar's entry-slot reject twin. A collection is never optional
// — `is empty` is its absence — and the rule is designed, so the sentence
// answers with the ruled spelling rather than stopping at the `?`. The runtime
// reason is `coerce_args`: its dispatch is on the declared `TCollection`
// itself, so an optional wrapper would pass the argument raw.
game PrimitivesCollectionOptional {
  players: 2
  max_length: 100
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  primitives {
    gin_valid_meld(cards : Collection<Card>?) : Boolean
  }
  zones { deck : Deck  hand[player] : Hand<player> }
  state { score[player] : Integer = 0 }
  phase play {
    score[0] := if gin_valid_meld(hand[0]) then 1 else 0
  }
  winner: highest score
}
