// Guard: resolve.py's `_check_scoped_read_containment`, the offering arm. The
// maintenance hazard this diagnostic exists for: a move type calling a scoped
// entry was offered only inside the declaring phase, and a later edit offered
// it from somewhere else. The span is the offending OFFER, because that is
// what the addressee has to move.
move_type note {
  when: pinochle_meld_value(0) >= 0
  effect { meld[0] := meld[0] }
}
game ScopedReadOfferLeaks {
  players: 2
  max_length: 100
  cards: pinochle48
  ranking: A 10 K Q J 9
  primitives {
    pinochle_meld_value(p : Player) : Integer reads hand[p], trump_suit in outer
  }
  zones { deck : Deck  hand[player] : Hand<player> }
  state { meld[player] : Integer = 0 }
  phase outer {
    state { trump_suit : Suit? = spades }
    deal 12 cards from deck to each hand
    offer to 0 one of [note]
  }
  phase later {
    offer to 1 one of [note]
  }
  winner: highest meld
}
