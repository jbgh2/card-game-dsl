// Guard: resolve.py's `transition_to:` sibling-MODE check. `nowhere` is not a
// mode of `play`, so the target is rejected even though `play_to_trick` is a
// real library move event. `b` is gone: with `a` pointing elsewhere, `b` would
// be an orphan and its own guard would fire first, hiding the case named here.
game TransitionToNonSibling {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  zones {
    deck : Deck
    hand[player] : Hand<player>
  }
  state { score[player] : Integer = 0 }
  phase play {
    mode a {
      transition_to: nowhere when play_to_trick
    }
  }
  winner: highest score
}
