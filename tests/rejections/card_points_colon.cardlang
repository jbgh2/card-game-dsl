// Guard: parse.py's `card_points_colon_reject` (diagnostics.lark). A block
// clause takes no colon; the habit of every scalar clause puts one there.
game CardPointsColon {
  players: 2
  max_length: 1000
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2
  card_points: { A: 1 }
  zones {
    deck : Deck
    table : Discard
    hand[player] : Hand<player>
  }
  state { score[player] : Integer = 0 }
  phase play {
    deal 3 cards from deck to each hand
    score[0] := 1
  }
  winner: highest score
}
