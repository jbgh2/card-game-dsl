// A probe, not a corpus game: a State Variable reads hand[1], which seat 0
// cannot see, is shown to seat 0 at its first decision, and is overwritten
// before its second. Perfect recall over Constructed Worlds holds only if
// seat 0's second information state still fixes what it was shown at its
// first, which the State Delta of its second decision node does.
game StateRecall {
  players: 2
  max_length: 4
  cards: standard52
  ranking: aces high
  zones {
    deck         : Deck
    hand[player] : Hand<player>
  }
  state {
    flag : Integer = 0
    guess[player] : Integer = 0
  }
  phase setup {
    shuffle deck
    deal 1 card from deck to hand[1]
  }
  phase peek {
    flag := number of cards in hand[1] where rank_value(card) >= 8
    as 0 { guess[0] := choose integer in 0 .. 1 }
    flag := 0
    as 0 { guess[0] := choose integer in 0 .. 1 }
  }
  winner: highest guess
}
