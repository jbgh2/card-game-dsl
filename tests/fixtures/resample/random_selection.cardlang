// A probe, not a corpus game: a random selection, the one drawing construct no
// corpus game reaches. It sits between seat 0's two discards, so a line paused
// at the first discard has not reached it yet and one paused at the second
// has.
game RandomSelection {
  players: 2
  max_length: 4
  cards: standard52
  zones {
    deck : Deck
    hand[player] : Hand<player>
  }
  state {
    score[player] : Integer = 0
  }
  phase setup {
    shuffle deck
    deal 3 cards from deck to each hand
  }
  phase first_discard {
    as 0 { move chosen 1 card from hand[0] to deck }
  }
  phase draw {
    for each player p: move random 1 cards from deck to hand[p]
  }
  phase second_discard {
    as 0 { move chosen 1 card from hand[0] to deck }
  }
  winner: highest score
}
