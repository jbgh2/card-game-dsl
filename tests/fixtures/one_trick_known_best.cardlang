// Two seats, three tricks, and the lead passing to whoever took the last one:
// small enough that every line a seat can play is enumerable, so the best a
// seat can do against a fixed opponent is computed rather than assumed. The
// specified oracle a ranking policy is measured against (the Architect's
// sourcebook, P12) — every rank is ranked and there are no trumps, so nothing
// about a trick is left to a library.
game OneTrickKnownBest {
  players: 2
  direction: clockwise
  max_length: 40
  cards: standard52
  ranking: A K Q J 10 9 8 7 6 5 4 3 2

  trick_order {
    trump:         false
    card_strength: rank_value(card)
  }

  zones {
    deck         : Deck
    hand[player] : Hand<player>
    trick_pile   : TrickPile
    won[player]  : PlayerPile<player>
  }

  state {
    taken[player] : Integer = 0
    leader        : Player  = 0
  }

  phase setup {
    shuffle deck
    deal 3 cards from deck to each hand
  }

  phase play {
    legal_moves: [play_to_trick]
    repeat until (number of cards in hand[0]) is 0 {
      round play_to_trick from leader over all players source hand into trick_pile
            winner highest_by_trick_order
      taken[winner] += 1
      leader := winner
      move all cards from trick_pile to won[winner]
    }
  }

  winner: highest taken
}
