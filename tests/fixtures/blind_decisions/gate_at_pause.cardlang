// A probe, not a corpus game: a phase gate reads hand[1], which seat 0
// cannot see. Seat 0's first decision precedes the gate; its second is asked
// in `high` or `low` by hand[1]'s single card. Both phases offer the same
// move, so only the phase the ask names differs. The checker refuses the
// gate, which every seat must be able to check.
game GateAtPause {
  players: 2
  max_length: 20
  cards: standard52
  ranking: aces high
  zones {
    deck         : Deck
    hand[player] : Hand<player>
    table        : Discard
  }
  state {
    score[player] : Integer = 0
  }
  phase setup {
    shuffle deck
    deal 5 cards from deck to hand[0]
    deal 1 card from deck to hand[1]
  }
  phase first {
    as 0 { move chosen 1 card from hand[0] to table }
  }
  phase high when any card in hand[1] where rank_value(card) >= 6 {
    as 0 { move chosen 1 card from hand[0] to table }
  }
  phase low when not (any card in hand[1] where rank_value(card) >= 6) {
    as 0 { move chosen 1 card from hand[0] to table }
  }
  phase last {
    as 0 { move chosen 1 card from hand[0] to table }
  }
  winner: highest score
}
