// A probe, not a corpus game: an `if` reads hand[1], which seat 0 cannot
// see, and narrows seat 0's lead while seat 1 holds a jack or higher. The
// branch turns on one of seat 1's five cards, so only a swap moving a high
// card in or out of hand[1] flips it. The checker does not judge a control
// position for a Hidden Read, so it accepts this game (issue #755).
game ControlHighCard {
  players: 2
  max_length: 40
  cards: standard52
  ranking: aces high
  zones {
    deck         : Deck
    hand[player] : Hand<player>
    table        : Discard
  }
  state {
    score[player] : Integer = 0
  }
  phase setup {
    shuffle deck
    deal 12 cards from deck to hand[0]
    deal 5 cards from deck to hand[1]
  }
  phase play {
    as 0 { move chosen 1 card from hand[0] to table }
    if any card in hand[1] where rank_value(card) >= 11 {
      as 0 { move chosen 1 card from hand[0] where rank_value(card) < 6 to table }
    } else {
      as 0 { move chosen 1 card from hand[0] to table }
    }
    as 0 { move chosen 1 card from hand[0] to table }
  }
  winner: highest score
}
