// A probe, not a corpus game: a phase gate reads hand[1], which seat 0
// cannot see, and decides who is asked next: `high` asks seat 0 and `low`
// asks seat 1. Seat 0 is asked again in `last`, the pause at depth 2.
game GateReroutes {
  players: 2
  max_length: 20
  cards: standard52
  ranking: aces high
  zones {
    deck         : Deck
    hand[player] : Hand<player>
    table        : Discard
  }
  state {
    score[player] : Integer = 0
  }
  phase setup {
    shuffle deck
    deal 5 cards from deck to hand[0]
    deal 2 cards from deck to hand[1]
  }
  phase first {
    as 0 { move chosen 1 card from hand[0] to table }
  }
  phase high when any card in hand[1] where rank_value(card) >= 9 {
    as 0 { move chosen 1 card from hand[0] to table }
  }
  phase low when not (any card in hand[1] where rank_value(card) >= 9) {
    as 1 { move chosen 1 card from hand[1] to table }
  }
  phase last {
    as 0 { move chosen 1 card from hand[0] to table }
  }
  winner: highest score
}
