// A probe, not a corpus game: an `if` reads hand[1], which seat 0 cannot
// see, and picks which of two decisions seat 0 is asked. The two decisions
// share their phase, construct, count and destination and differ only in
// their `where`, so seat 0 is told the same thing in both worlds and offered
// a different menu. The checker does not judge a control position for a
// Hidden Read, so it accepts this game (issue #755).
game ControlBranch {
  players: 2
  max_length: 20
  cards: standard52
  ranking: aces high
  zones {
    deck         : Deck
    hand[player] : Hand<player>
    table        : Discard
  }
  state {
    score[player] : Integer = 0
  }
  phase setup {
    shuffle deck
    deal 12 cards from deck to hand[0]
    deal 1 card from deck to hand[1]
  }
  phase play {
    as 0 { move chosen 1 card from hand[0] to table }
    if any card in hand[1] where rank_value(card) >= 8 {
      as 0 { move chosen 1 card from hand[0] where rank_value(card) >= 2 to table }
    } else {
      as 0 { move chosen 1 card from hand[0] where rank_value(card) >= 8 to table }
    }
    as 0 { move chosen 1 card from hand[0] to table }
  }
  winner: highest score
}
