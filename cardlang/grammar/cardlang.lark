_SOURCE_KW: "source" /(?![A-Za-z0-9_])/
_STATE_KW: "state" /(?![A-Za-z0-9_])/
_SUIT_KW: "suit" /(?![A-Za-z0-9_])/
_SUITS_KW: "suits" /(?![A-Za-z0-9_])/
_SUM_KW: "sum" /(?![A-Za-z0-9_])/
_TEAM_KW: "team" /(?![A-Za-z0-9_])/
_TEAMS_KW: "teams" /(?![A-Za-z0-9_])/
_THE_KW: "the" /(?![A-Za-z0-9_])/
_THEN_KW: "then" /(?![A-Za-z0-9_])/
_THROUGH_KW: "through" /(?![A-Za-z0-9_])/
_TO_KW: "to" /(?![A-Za-z0-9_])/
_TRANSITION_TO_KW: "transition_to" /(?![A-Za-z0-9_])/
_TRICK_ORDER_KW: "trick_order" /(?![A-Za-z0-9_])/
_TRUMP_KW: "trump" /(?![A-Za-z0-9_])/
_TURNS_KW: "turns" /(?![A-Za-z0-9_])/
_TYPE_KW: "type" /(?![A-Za-z0-9_])/
_UNTIL_KW: "until" /(?![A-Za-z0-9_])/
_UP_KW: "up" /(?![A-Za-z0-9_])/
_USES_KW: "uses" /(?![A-Za-z0-9_])/
_VISIBILITY_KW: "visibility" /(?![A-Za-z0-9_])/
_WHEN_KW: "when" /(?![A-Za-z0-9_])/
_WHERE_KW: "where" /(?![A-Za-z0-9_])/
_WINNER_KW: "winner" /(?![A-Za-z0-9_])/
_ZONES_KW: "zones" /(?![A-Za-z0-9_])/

// Keywords that sit where a NAME is also grammatical, and never name a value,
// are ALSO excluded from NAME — the second half, and a smaller set than the
// keywords above. `always` (the applies_when wildcard), the quantity words
// `all` / `one` / `some`, `jointly`, and `not` / `is` / `number` (the equality
// and card-query keywords): without the exclusion, `number of cards in <zone>`
// is also derivable as the card literal `number of cards` followed by
// membership, `some` as an amount expression, and `jointly (x) >= 3` as a call
// to a function named `jointly`. `none`, by contrast, is a domain value (the
// no-pass Direction, an optional's null) and stays an ordinary name_ref the
// resolver interprets. Extend this guard only for keywords that never name a
// value; statement-leading keywords (game, phase, …) need no guard — anchoring
// alone keeps `assets := …` a NAME.
// The position-domain / collection quantifier noun (`any <QNOUN> where`, `any
// <QNOUN> in …`). A NAME that additionally excludes the nouns of the fixed
// quantifier forms (player/team/suit/rank) and the card queries (card), with
// their plurals: without the exclusion, `any player where` derives BOTH
// `q_any_player` and `q_any_domain` (a real Earley ambiguity the corpus
// exercises), and `any card in …` both `cq_any` and `q_any_in`. Excluded from
// this terminal, those spellings can only match their own dedicated
// productions. It carries the same base reserved-word exclusion as NAME (a
// position domain can never be named `all`/`number`/… — those cannot be
// declared) and the same identifier shape, so anywhere the grammar expects a
// plain NAME the QNOUN token is simply not an accepted terminal.
QNOUN: /(?!(?:always|all|one|some|jointly|not|is|number|players?|teams?|suits?|ranks?|cards?)\b)[a-zA-Z_][a-zA-Z0-9_]*/
NAME: /(?!(?:always|all|one|some|jointly|not|is|number)\b)[a-zA-Z_][a-zA-Z0-9_]*/
STRING: /"[^"]*"/

// The mirror of keyword anchoring, and the one member of the class a keyword's
// own lookahead cannot reach: a digit run cannot absorb letters, so `1and`
// lexes as `1` + `and` however well `and` is anchored. The anchor has to sit
// here. Defined rather than imported from common for that lookahead.
INT: /[0-9]+(?![A-Za-z0-9_])/

LINE_COMMENT: /\/\/[^\n]*/

%import common.WS
%ignore WS
%ignore LINE_COMMENT
