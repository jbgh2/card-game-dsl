// Card Game DSL — surface grammar.
//
// Grown corpus-first: every production here exists because a [[game]] in the
// corpus needs it. Developed on Earley (reports ambiguity), tightening toward
// LALR. The expression sublanguage (docs/building.md) is the lower half of
// this file and is reused everywhere an expression appears.

start: top_item+

// Alternate start for the standard-library rules fragment
// (cardlang/stdlib/rules.cardlang): rule definitions with no enclosing game.
stdlib_rules: rule_def+

// Alternate start for a family-library file (docs/libraries/<name>.cardlang):
// the definition forms a game already holds, plus the two state clauses, with no
// enclosing game (decisions.md "Family libraries"). It holds definitions and the
// state its own definitions own, but no other game structure — no zones, no
// phases — as far as the corpus has forced, not as a permanent boundary. State
// reaches a library two ways: `state` PROVIDES it (the library owns the variable
// and its initial value; the game may read it and may not write it) and
// `requires` CONTRACTS for it (the game declares it, picks its initial value,
// and writes it). A move touching a game-specific zone stays game-local, which
// is why neither clause names a zone.
library: _LIBRARY_KW NAME "{" library_item* "}"

?library_item: requires_block
             | state_block
             | rule_def
             | move_type_def
             | type_def
             | define_def
             | function_def
             | procedure_def

// What the including game must declare, checked at its `uses` line so the
// error reaches the game's author rather than inside spliced library text.
// Deliberately `state_decl` minus the `= <default>`: a required variable's
// initial value is the GAME's to choose (Stud's raise cap is 3, Leduc's is 2),
// and a library that could set one would be configuring the game rather than
// contracting with it. The library's OWN state carries defaults, and reuses
// `state_block` unchanged to say so — a provided variable's initial value is
// the library's precisely because the variable is.
//
// An entry names a thing from EITHER of the two blocks a game declares keyed
// names in, and its type says which: a `state { }` type or a `zones { }` one.
// That is why the type slot carries both spellings the two blocks use — the
// index-domain argument a zone type takes, and the `?` a state type takes.
// Which reading a head takes, and why `?` suffixes a value type only, is
// decisions.md "Typed object model"; neither spelling is legal on the other
// side, and both crosses are refused at resolve rather than here: the grammar
// cannot see which registry a NAME came from, and a syntax error would report
// a shape question as a spelling one.
requires_block: _REQUIRES_KW "{" require_decl* "}"
require_decl: NAME [index] ":" NAME [type_args]     -> require_plain
            | NAME [index] ":" NAME [type_args] "?" -> require_optional

?top_item: game
         | rule_def
         | move_type_def
         | type_def
         | define_def
         | function_def
         | procedure_def

// ----------------------------------------------------------------------------
// Game structure
// ----------------------------------------------------------------------------

game: _GAME_KW NAME "{" game_item* "}"

?game_item: uses_decl
          | primitives_block
          | players
          | direction
          | cards
          | pieces
          | board
          | ranking
          | card_points_table
          | trump
          | trick_order
          | teams
          | max_length
          | positions
          | zones
          | state_block
          | phase
          | winner
          | loser

// `uses <library>` — a family-[[library]] import, the tier between game-local
// and [[stdlib]] (decisions.md "Family libraries"). Unlike every other game clause this
// one may repeat: a game uses as many libraries as it draws on, and the line is
// meant to read like the rulebook sentence it stands in for ("betting proceeds
// as in standard poker"). Whole-library, never a named-definitions manifest.
uses_decl: _USES_KW NAME

// The game's `primitives { }` block (docs/design-notes/primitive-sidecars.md
// section 2): what this game borrows from outside the DSL. An entry is a
// COLON-ROW
// like every other declaration here (`zones`, `state`, `card_points`,
// `require`) — a typed parameter list, a colon, the return type, and the
// load-bearing clause: the state and zones the implementation reads. Entries
// reuse `parameter`, so a Primitive's parameters and a `move_type`'s are one
// shape rather than two spellings of the same thing.
//
// Entry-STAR, unlike `card_points` and `trick_order`: an empty block is a
// declaration, not a syntax error. It says the game borrows no Python, which
// is a different state from writing no block at all — the presence, not the
// contents, picks the game's Primitive regime.
//
// A read is `<name>` or `<name>[<binder>]`, the binder naming a parameter of
// the entry it sits in: bare grants the whole family, indexed narrows to the
// one instance the call names. It reuses `index`, the same `[...]` a zone or
// state declaration writes.
//
// A read may name the PHASE whose `state { }` declares it — `trump_suit in
// hand_sequence` — which is what lets an entry read state a phase declares.
// The tail is per-READ, not per clause, because a clause legitimately mixes
// game-level names with a phase's (`reads hand[p], trump_suit in
// hand_sequence`); one clause-wide tail could not say that. `in` is reused
// rather than a new word minted: it is already anchored, and its containment
// sense is the one wanted — `committed in play` is the variable contained in
// play's state, the way `cards in hand` is. Inference was rejected: sibling
// phases may legally declare the same name, so a bare name would be resolved
// by a silent pick, and the phase the designer names is also what carries the
// call-position constraint to the reader of the block.
//
// One transposition earns a reject-with-replacement twin, because it is the
// one a designer plausibly writes: the binder rides the VARIABLE, never the
// phase.
//
// Two reject-with-replacement twins (the `card_points_table` mechanism): the
// colon habit, and the ARROW — the spelling the design note sketched before
// the block had a surface, so it is the first thing a reader of that note
// writes. A `= <expr>` default is the third: an entry declares a signature,
// never a body, and the state-row habit is what puts one there. Each reject
// arm's tail admits the well-formed spelling too, so ONE wrong entry among
// right ones reaches the designer-voice rejection rather than the lexer's.
primitives_block: _PRIMITIVES_KW "{" primitive_decl* "}"
                | _PRIMITIVES_KW ":" "{" primitive_decl* "}"  -> primitives_colon_reject
                | _PRIMITIVES_KW "{" primitive_decl* primitive_arrow_decl (primitive_decl | primitive_arrow_decl)* "}"     -> primitives_arrow_reject
                | _PRIMITIVES_KW "{" primitive_decl* primitive_default_decl (primitive_decl | primitive_default_decl)* "}" -> primitives_default_reject
//
// The entry's two type slots take their OWN production family, written out
// rather than derived from `payload_type`: the teaching twin below lands ON
// the shared productions, so a shared derivation would give the entry's own
// spelling two derivations of one string. All three entry forms take it, so a
// mis-spelled entry with a collection parameter reaches its own reject arm's
// message instead of dying at the `<`.
//
// The element slot holds ONE bare NAME (decisions.md "Typed object model": a
// value-constructor head takes an element type), and the four shapes that
// would put something else there are sentences a designer writes on purpose —
// an optional collection, a second argument, a nested bracket, an optional
// element. Each is its own reject-with-replacement arm rather than a place the
// lexer stops, because the ruling is that a refusal names the ruled form in
// the designer's words. The arms are COMPLETE productions for the string they
// name, never prefixes: a prefix arm would give one sentence two derivations
// in the entry's own slot, which is the ambiguity this family exists to avoid.
// WHICH element is the resolver's, from the block's own allow-list.
primitive_decl: NAME "(" [primitive_param ("," primitive_param)*] ")" ":" primitive_type [primitive_reads]
primitive_arrow_decl: NAME "(" [primitive_param ("," primitive_param)*] ")" "->" primitive_type [primitive_reads]
primitive_default_decl: NAME "(" [primitive_param ("," primitive_param)*] ")" ":" primitive_type [primitive_reads] "=" expr
primitive_param: NAME ":" primitive_type
primitive_type: NAME "?"                       -> primitive_optional_type
              | NAME                           -> primitive_plain_type
              | NAME "<" NAME ">"              -> primitive_collection_type
              | NAME _OF_KW NAME               -> collection_phrase_reject
              | NAME "<" NAME ">" "?"          -> collection_optional_reject
              | NAME "<" NAME ("," NAME)+ ">"  -> collection_arity_reject
              | NAME "<" nested_collection ">" -> collection_nested_reject
              | NAME "<" NAME "?" ">"          -> collection_optional_element_reject
// Any depth of nesting, so the arm names the shape rather than the one level
// someone thought to write.
nested_collection: NAME "<" NAME ">"
                 | NAME "<" nested_collection ">"
primitive_reads: _READS_KW primitive_read ("," primitive_read)*
primitive_read: NAME [index] [_IN_KW NAME]
              | NAME _IN_KW NAME index -> primitive_read_transposed_reject

players: _PLAYERS_KW ":" players_spec
players_spec: INT ".." INT   -> players_range
            | INT            -> players_fixed

direction: _DIRECTION_KW ":" NAME

// Content clauses: each names a COMPONENT_SETS entry ([[component-set]]) of its
// flavor (`cards:` a card deck, `pieces:` a piece set). Exactly one per game —
// both/neither are parse [[owner-guard]]s (parse.py `game()`); a cross-flavor
// name is a resolve Owner Guard.
cards: _CARDS_KW ":" NAME
pieces: _PIECES_KW ":" NAME

// A per-game bound on decision/loop iterations (docs/decisions.md, "Game
// length as a declared contract"): the runtime's non-termination Owner Guard
// and the OpenSpiel adapter's `max_game_length` both read this one number.
max_length: _MAX_LENGTH_KW ":" INT
// Either an explicit strongest-first rank enumeration, or a ranking
// convention the resolver expands against the declared deck (decisions.md,
// "The `ranking:` declaration: enumeration or convention"). The space-form conventions
// (`aces high`, `aces low`, `twos high`) are deliberately NOT grammar
// alternatives: their words lex as ordinary card_rank NAMEs, so a second
// derivation would be a real Earley ambiguity (tests/test_grammar_ambiguity
// budgets the corpus at zero `_ambig` nodes). Instead parse.py's `ranking`
// callback recognizes an enumeration whose space-joined spelling is exactly
// a `RANKING_CONVENTIONS` key — reserving those spellings in ranking
// position, pinned by tests/test_ranking_conventions.py. Only the
// hyphenated `ace-ten` needs a terminal (a hyphen has no card_rank
// derivation, so this arm is unambiguous), anchored like _AS_KW below.
ranking: _RANKING_KW ":" (RANK_CONV | card_rank+)
RANK_CONV: /ace-ten(?![A-Za-z0-9_-])/

// The game's card-point table (decisions.md "Scoring composition"): a block
// clause beside `cards:`, rank-keyed rows in `ranking:`'s key position, values
// static signed integer literals, one optional trailing `else:` row for the
// everything-else value (unlisted ranks read 0 with no else row — the
// `card_points(card)` Builtin's contract). Entry-plus: the empty block is a
// syntax error, like the struct literal's at-least-one-field rule. Rows are
// whitespace-separated like every block clause (`zones`, `state`,
// `positions`) — never comma-separated. The key is its own terminal
// (CARD_POINTS_KEY below): `else` must be excluded there or `else: 1` derives
// both as a rank row and as the else row — a real Earley ambiguity, the
// `q_any_player`-vs-`q_any_domain` class. The value is deliberately NOT
// `expr`: a static table is the contract (the `up to N` literal discipline),
// and an expression slot would also make adjacent rows ambiguous
// (`A: 1 10: 10` — the `1 10` would need a reading). The two aliased
// alternatives are reject-with-replacement spellings (the `==`/`!=`
// mechanism): the colon habit and the pre-rename `card_values` name each get
// a builder rejection naming the one block spelling instead of a bare syntax
// error.
card_points_table: _CARD_POINTS_KW "{" card_points_entry+ [card_points_else] "}"
                 | _CARD_POINTS_KW ":" "{" card_points_entry* [card_points_else] "}"   -> card_points_colon_reject
                 | _CARD_VALUES_KW [":"] "{" card_points_entry* [card_points_else] "}" -> card_values_reject
card_points_entry: card_points_key ":" card_points_value
card_points_else: _ELSE_KW ":" card_points_value
card_points_key: CARD_POINTS_KEY | INT
card_points_value: INT       -> cp_value
                 | "-" INT   -> cp_neg_value

// The game's [[trick-order]] (decisions.md "Trick Order"): the three per-card
// facts a trick's resolution and follow legality derive from — is the card a
// trump, what class does it follow as, how strong is it within its class --
// each an expression over the implicit `card` binder (the card-query and
// filter convention). The language mints the readers `is_trump(card)`,
// `follow_class(card)`, `card_strength(card)` (the `card_points { }` /
// `card_points(card)` precedent) and two Builtins over the declaration:
// `highest_by_trick_order` (the winner: bare in a round's `winner` slot, or
// called over a public pile's [[arrival-record]]) and `follows_lead(card,
// pile)`. Entry-plus (the empty block is a syntax error, the
// `card_points_table` rule). The row key is its own terminal, validated by the
// builder against `TRICK_ORDER_ROWS` — ONE source for the row set, and a
// wrong key gets a rejection naming the rows rather than a bare syntax error.
// Each row at most once, in any order; the reference order BETWEEN rows is the
// language's (trump, follow_class, card_strength), never the textual one. Rows
// are whitespace-separated like every block clause. Three
// reject-with-replacement twins (the `card_points_table` mechanism): the colon
// habit, comma-separated rows, and the assignment habit `trump = ...` /
// `trump := ...` anywhere in the block, including one wrong row among colon
// rows. The comma arm's tail is `row*`, not `row+`, so a TRAILING comma
// (`{ trump: X, }` -- the likeliest single slip, and the one a list habit
// produces) reaches the same designer-voice rejection instead of the lexer's.
trick_order: _TRICK_ORDER_KW "{" trick_order_row+ "}"
           | _TRICK_ORDER_KW ":" "{" trick_order_row* "}"                             -> trick_order_colon_reject
           | _TRICK_ORDER_KW "{" trick_order_row+ ("," trick_order_row*)+ "}"         -> trick_order_comma_reject
           | _TRICK_ORDER_KW "{" trick_order_row* trick_order_eq_row (trick_order_row | trick_order_eq_row)* "}" -> trick_order_eq_reject
trick_order_row: TRICK_ORDER_KEY ":" expr
trick_order_eq_row: TRICK_ORDER_KEY TRICK_ORDER_EQ expr
TRICK_ORDER_EQ: ":=" | "="

// The game-level trump clause: the suit that beats all others in a trick,
// named bare (`trump: spades`) — a suit of the declared deck (resolve,
// `_resolve_trump`), read by a trick round whose winner reads a trump and
// writes no `trump` clause of its own. Refused beside a `trick_order` block
// (the block's `trump:` row is then the trump). A number or a quoted string
// where the bare name belongs gets a builder rejection naming the spelling,
// not the lexer's voice.
trump: _TRUMP_KW ":" NAME
     | _TRUMP_KW ":" INT     -> trump_int_reject
     | _TRUMP_KW ":" STRING  -> trump_string_reject

// Fixed teams, each a bracketed list of seat indices (0-based, clockwise).
// `teams: [[0, 2], [1, 3]]` — partners sit across in a four-hand game. The
// noun is the domain's, so it is the same word the quantifiers range over
// (`all teams where …`), exactly as `players:` is for seats.
teams: _TEAMS_KW ":" "[" team_spec ("," team_spec)* "]"
team_spec: "[" INT ("," INT)* "]"

// Declared position domains (decisions.md "Position domains and positional
// zones"): per-game integer index/parameter domains for positional layouts
// (tableau columns, free cells). The bounds are integer literals — the
// domain must be static, like the `choose` ceiling.
positions: _POSITIONS_KW "{" position_decl* "}"
position_decl: NAME ":" INT ".." INT

// A board selects a family from the BOARDS registry (cardlang/stdlib/boards.py)
// with integer arguments (decisions.md "Boards and cells"): `board: grid(3, 3)`.
// It mints one named-member position domain (`cell`) whose members are the
// board's cells. Unknown family / wrong arity / out-of-bounds args are resolve
// diagnostics (via `board_entry`); `board:` requires `pieces:`.
board: _BOARD_KW ":" NAME ["(" INT ("," INT)* ")"]

zones: _ZONES_KW "{" zone_decl* "}"
zone_decl: NAME [index] ":" type_ref
index: "[" NAME "]"
type_ref: NAME [type_args]
type_args: "<" type_arg ("," type_arg)* ">"
type_arg: NAME

state_block: _STATE_KW "{" state_decl* "}"
state_decl: NAME [index] ":" type_name "=" expr
// The two type productions every declaration outside a `primitives { }` entry
// spells its types with. Each carries the entry-only collection form as a
// reject-with-replacement twin: the spelling is real and the designer's
// mistake is placement, so a bare syntax error would report a placement
// question as a shape one. The twin carries the trailing `?` too — a designer
// who thinks a state row may hold an optional collection has made ONE mistake,
// the placement, and meeting the lexer on the suffix would answer the other
// one. The entry-slot family's other three malformed shapes get no twin here:
// at a non-entry position the sentence worth teaching is the well-formed one,
// and a malformed collection in a slot that has none is loud either way
// (issue #560, which carries that class).
// `require_decl` and the zone `type_ref` get no twin — both already derive
// `<…>` through `type_args`, so a twin there would give one string two
// derivations, and their refusals are the zone registry's.
type_name: NAME "?"              -> optional_type
         | NAME                  -> plain_type
         | NAME "<" NAME ">"     -> collection_type_reject
         | NAME "<" NAME ">" "?" -> collection_type_reject

// User-defined struct type: named fields plus optional computed `derived` fields.
// The name is `STRUCT_TYPE_NAME`, not `NAME`, so declaration and use agree on
// which names a struct type may take: a type `struct_lit` cannot spell would be
// declarable but unusable, which is accepted-but-ignored one step removed.
type_def: _TYPE_KW STRUCT_TYPE_NAME "=" "{" struct_field* "}" [derived_block]
struct_field: NAME ":" type_name
derived_block: _DERIVED_KW "{" derived_field* "}"
derived_field: NAME "=" expr

winner: _WINNER_KW ":" rank_dir NAME
rank_dir: RANK_DIR
RANK_DIR: /(?:lowest|highest)(?![A-Za-z0-9_])/

// An elimination game ends with one player selected directly (the sole player
// still holding cards), not by ranking a score — so `loser:` takes a
// player-valued expression rather than `winner:`'s `rank_dir <var>`.
loser: _LOSER_KW ":" expr

// ----------------------------------------------------------------------------
// Phases
// ----------------------------------------------------------------------------

phase: _PHASE_KW NAME [phase_outcome] [phase_qualifier] "{" phase_item* "}"
// A [[phase]] that can resolve more than one way declares its [[outcome]] type
// here; the enclosing structure pattern-matches on it with `produces:`.
phase_outcome: "->" _OUTCOME_KW outcome_set
// One lexeme for iteration everywhere: the phase qualifier matches the
// statement form (`repeat until`), not third-person `repeats`.
phase_qualifier: _REPEAT_KW _UNTIL_KW expr -> phase_repeats
               | _WHEN_KW expr             -> phase_when

?phase_item: state_block
           | active_rules
           | legal_moves
           | mode_def
           | before_each
           | after_each
           | phase
           | statement

// A [[mode]] is a condition the game is in, existing to change which [[rule]]s
// are active; being in it IS its behavior, so its body is configuration and
// nothing else. That restriction lives here rather than in a resolve
// diagnostic because the grammar is the earliest layer that can own it: a
// statement in a mode body is unreachable code, and `legal_moves:` there is
// read by no consumer. An empty mode is the terminal side of a condition.
mode_def: _MODE_KW NAME "{" mode_item* "}"
?mode_item: active_rules
          | transition_to

// Loop lifecycle hooks on a `repeat until` phase: before_each runs at the
// start of every iteration, after_each at the end — guaranteed even when the
// loop terminates mid-iteration (decisions.md "Loop lifecycle: `before_each` and `after_each`").
before_each: _BEFORE_EACH_KW "{" statement* "}"
after_each: _AFTER_EACH_KW "{" statement* "}"

active_rules: _ACTIVE_RULES_KW ":" "[" [rule_ref ("," rule_ref)*] "]"
// A reference may pass arguments to a parameterized rule (library or local):
// `NoLeadingSuitUntilBroken(hearts)`. The remove/override forms name a rule,
// never instantiate one, so they take no argument list (grammatically
// inexpressible rather than rejected).
rule_ref: "+" NAME [rule_args] -> rule_add
        | "-" NAME             -> rule_remove
        | _OVERRIDE_KW NAME    -> rule_override
        | NAME [rule_args]     -> rule_plain
rule_args: "(" expr ("," expr)* ")"

legal_moves: _LEGAL_MOVES_KW ":" "[" [NAME ("," NAME)*] "]"

transition_to: _TRANSITION_TO_KW ":" NAME _WHEN_KW move_event
// A move-type event with an optional predicate on the move — the same
// event-reference form triggered scoring components use (decisions.md,
// "Triggered scoring components"). There are no ad-hoc event names.
move_event: NAME [_WHERE_KW expr]

// ----------------------------------------------------------------------------
// Statements (phase / mechanic bodies)
// ----------------------------------------------------------------------------

?statement: transfer
          | rotate_stmt
          | epistemic_op
          | each_simultaneous
          | for_each
          | repeat_until
          | if_stmt
          | let_stmt
          | assign_stmt
          | offer
          | round_stmt
          | auction_stmt
          | climb_stmt
          | produce_stmt
          | produces_stmt
          | continue_to
          | skip_stmt
          | run_stmt
          | as_block
          | turns_stmt

// Invoke a named procedure: its body is spliced in at this site, after the
// arguments substitute for the parameters (decisions.md "Named procedures").
// A keyword leads, so statement-hood stays visible — the statement layer has
// no expression-statement form, and that absence is worth preserving.
run_stmt: _RUN_KW NAME "(" [expr ("," expr)*] ")"

// Imperative phase control flow, used in `produces:` arms (decisions.md "Typed
// phase outcomes"): jump forward to a named sibling phase, or abort the rest of
// this hand and continue the enclosing `repeat until` hand loop.
continue_to: _CONTINUE_KW _TO_KW NAME
skip_stmt: _SKIP_KW _TO_KW _NEXT_KW _HAND_KW

// Terminal in a `define` body: sets the outcome result and unwinds the body.
produce_stmt: _PRODUCE_KW NAME ["(" expr ("," expr)* ")"]

// Invoke a param-light `define` by name and dispatch on its outcome result.
// Arm bodies use braces, matching if_stmt/repeat_until.
produces_stmt: NAME _PRODUCES_KW ":" produce_arm+
produce_arm: NAME ["(" NAME ("," NAME)* ")"] "{" statement* "}"

// The built-in operations use prose statement syntax — game actions read as
// rulebook commands, not function calls (decisions.md, on the three operation
// families). Call syntax (`name(args)`) is reserved for
// value-returning functions and named user operations, which appear in
// expression position.

// One [[transfer]], used as a statement or (in some arg positions) a value.
// The verb is sugar over a single IR node; the amount is an expression and the
// item noun covers cards and resources. The "in" form lets muck/burn imply
// their destination.
transfer: TRANSFER_VERB selection _FROM_KW zone_expr [where_clause] [dist_clause] move_dest [vis_clause] -> move_from
        | TRANSFER_VERB selection _IN_KW zone_expr [vis_clause]                                          -> move_in
        | TRANSFER_VERB selection move_dest [vis_clause]                                                 -> move_gather
// A word set spelled as a named terminal rather than as inline literals, so it
// carries its whole-word anchoring itself (`moveall …` must not read as `move
// all …`); same for RANK_DIR above.
TRANSFER_VERB: /(?:deal|transfer|move|burn|muck|draw)(?![A-Za-z0-9_])/
// How a `to each` deal distributes: by default each destination takes the
// stated amount; `as-equally-as-possible` deals the source round-robin so the
// remainder is spread (Getaway deals the whole deck across 3–8 hands).
dist_clause: _AS_EQUALLY_AS_POSSIBLE_KW  -> dist_equally
// Narrows the source pool to the cards matching a predicate before the
// selection draws from it (an ordinary expr with `card` bound per candidate,
// like the card query's `where` — the source-order subset, not a
// reordering). Only the `from` form takes it (any destination shape).
// The `jointly` form instead binds `cards` — the candidate SET — and the
// selection is over the source's subsets satisfying the joint predicate
// (decisions.md "Joint-predicate selection"); requires `chosen` (resolve
// rejects the rest of the matrix).
where_clause: _WHERE_KW _JOINTLY_KW expr -> where_jointly
            | _WHERE_KW expr             -> where_each
selection: [select_mode] amount NAME
select_mode: _CHOSEN_KW -> sel_chosen
           | _RANDOM_KW -> sel_random
// The three quantity words share this position with `expr`, so here a fused
// typo would be a REAL second parse rather than only a misreading (`onecards`
// splitting as `one cards`) — the ambiguity that first forced anchoring, on
// `some` and then swept to `all`/`one`. Every keyword in the grammar carries
// the same anchoring now (see Terminals); this position is where its absence
// showed up as an `_ambig` node rather than as a silent misread.
amount: _ALL_KW                      -> amt_all
      | _ONE_KW                      -> amt_one
      | _SOME_KW                     -> amt_some
      | expr                         -> amt_count
move_dest: _TO_KW _EACH_KW zone_expr -> dest_each
         | _TO_KW zone_expr          -> dest_one
vis_clause: "," _VISIBILITY_KW "=" expr

// Epistemic operations are prose statements like the rest of the built-in
// operations. A closed family: one alternative per op, added corpus-first as a
// game needs it (Hearts needs `shuffle`, Coup needs `reveal`). peek/hide/
// announce/expose_top/forget join here, in prose, as their games are
// formalized. `reveal` publicly identifies one matching card without moving
// it — the card stays in its zone; see cardlang/runtime/execute.py.
epistemic_op: _SHUFFLE_KW zone_expr                                           -> shuffle_op
            | _REVEAL_KW _ONE_KW _CARD_KW _FROM_KW zone_expr [_WHERE_KW expr] -> reveal_op

rotate_stmt: _ROTATE_KW NAME _THROUGH_KW "[" name_list "]"     // state-cycle (orthogonal)
name_list: NAME ("," NAME)*

each_simultaneous: _EACH_KW NAME _SIMULTANEOUSLY_KW ":" statement
for_each: _FOR_KW _EACH_KW NAME NAME ":" statement
repeat_until: _REPEAT_KW _UNTIL_KW expr "{" statement* "}"

// A conditional *statement* (distinct from the `if … then … else …`
// expression). Braced blocks like `repeat_until`, so multi-statement bodies
// need no indentation and the `:` colon-body forms stay unambiguous.
if_stmt: _IF_KW expr "{" statement* "}" [else_block]
else_block: _ELSE_KW "{" statement* "}"

// Bind the acting player to one named player for a braced body (decisions.md
// "Single-actor decisions: the `as` block"). The player expression is evaluated
// in the OUTER context, then the body runs once with the actor rebound — the
// first-class form of the `for each player p: if p is <who>` idiom, which
// captures `actor` and re-reads its guard mid-pass. Braced block like
// `if_stmt`/`repeat_until`, so multi-statement bodies need no colon-body.
as_block: _AS_KW expr "{" statement* "}"

// The turn loop beneath the round forms (decisions.md "The `turns` form"):
// rotate through the participants in game direction, binding each current
// player (binder + acting player) for a braced body of statements, until the
// termination predicate holds at a turn boundary. `again <var>` names a
// declared Boolean state variable; when a turn ends with it true, the same
// player takes the next turn (Go Fish's go-again). Statement-leading, so no
// NAME-EXCLUSION is needed — but ANCHORING still is (the two are separate
// halves): an unanchored inline keyword matches as a prefix under the
// dynamic lexer, so `turnst from …` would silently parse as `turns t` and
// `againgo` as `again go` — the fused-typo misparse class.
turns_stmt: _TURNS_KW NAME _FROM_KW expr _OVER_KW expr _UNTIL_KW expr [_AGAIN_KW NAME] "{" statement* "}"

offer: _OFFER_KW _TO_KW expr _ONE_KW _OF_KW "[" NAME ("," NAME)* "]"
// The [[trick]] [[form]] of `round`: one trick. The `winner` clause names the
// [[winner]] function that picks the player the trick yields, bound as `winner`
// for the statements after it. Distinct from the auction form's `outcome`
// clause below, which names a function producing a tagged `(tag, payloads)`
// [[outcome]] — two senses the glossary keeps apart.
round_stmt: _ROUND_KW NAME _FROM_KW expr _OVER_KW expr _SOURCE_KW NAME _INTO_KW NAME _WINNER_KW NAME [_TRUMP_KW expr] [_EARLY_KW NAME]   -> round_stmt
// The auction/betting form of `round`: a continuous ring over an [[offering]]
// that loops until the termination predicate holds (`until`). The
// `outcome` clause is optional: an auction supplies one and the function produces
// the typed outcome when the ring closes; a betting round omits it — each action
// mutates shared chip/fold state directly, so the closed ring just returns and
// play moves to the next street. No card source/into zones — these moves
// (bids/passes/bets) don't move cards. (decisions.md "Interactive decisions: a kernel and an in-DSL standard library": the
// same `round` kernel, configured along the offering, accumulator, and
// termination axes.)
// The optional `order` clause names the ring-traversal model (the order axis).
// The production admits any NAME; `ROUND_ORDER_MODES` bounds it to one value,
// `ring`, which is also what an absent clause means — the continuous ring, each
// turn advancing the pointer. A clause with one value equal to the default is
// kept deliberately, as the docking point a second traversal arrives at
// (decisions.md, "The auction form of `round`", under Order).
auction_stmt: _ROUND_KW auction_moves _FROM_KW expr _OVER_KW expr [_ORDER_KW NAME] _UNTIL_KW expr [_OUTCOME_KW NAME]   -> auction_stmt
auction_moves: _OFFERING_KW "[" NAME ("," NAME)* "]"
// The climbing form of `round`: one combination-climbing trick (Big Two, Tichu).
// The leader leads a combination from the engine, then each participant in turn
// beats the standing play or passes; the trick ends when action returns to the
// last player who played, or the `until` predicate holds (a player has shed out).
// The engine is named by `combinations` (the lead-options query) and `follows`
// (the legal-follows query) — game-local Primitive queries, since the combination
// rules differ across games. The winning player (the last to play) is bound as
// `winner` for the surrounding body, which routes the pile and the next lead;
// there is no winner *function* — the winner is the loop's last player, not a
// function of the cards. (decisions.md "Interactive decisions: a kernel and an in-DSL standard library": the same `round`
// kernel along the offering / order / termination axes.)
climb_stmt: _ROUND_KW _CLIMB_KW NAME _FROM_KW expr _OVER_KW expr _SOURCE_KW NAME _INTO_KW NAME _COMBINATIONS_KW NAME _FOLLOWS_KW NAME _UNTIL_KW expr   -> climb_stmt
named_arg: NAME "=" arg_value
?arg_value: transfer
          | expr

let_stmt: _LET_KW NAME [index] "=" expr
assign_stmt: lvalue assign_op expr
assign_op: ASSIGN_OP
ASSIGN_OP: ":=" | "+=" | "-="
lvalue: NAME [index_expr]

// ----------------------------------------------------------------------------
// Rules (top-level)
// ----------------------------------------------------------------------------

move_type_def: _MOVE_TYPE_KW NAME ["(" parameter ("," parameter)* ")"] "{" [move_when] move_effect "}"
// An optional, comma-separated parameter list; each parameter is drawn from an
// enumerable domain (Suit/Suit?, Rank, Player) or the state-dependent Card
// domain. Their value-domains flatten into one per-turn candidate list.
parameter: NAME ":" payload_type

// A named function: a parameterized expression callable anywhere an expression
// appears, so a game can factor a predicate it would otherwise repeat. The body
// is hermetic — it reads only its parameters and game/phase state, never the
// caller's binders — and non-recursive.
function_def: _FUNCTION_KW NAME "(" [parameter ("," parameter)*] ")" "=" expr

// A named procedure: a parameterized *statement* block, the definition form the
// expression layer has had all along. Calling one behaves exactly as if the body
// were written inline at the call site, after the arguments substitute for the
// parameters — the expander splices it away before the runtime ever sees it, so
// a procedure can never create an information-set gap. Parameter domains are the
// enumerable payload types; the resolver gates which are supported.
procedure_def: _PROCEDURE_KW NAME "(" [parameter ("," parameter)*] ")" "{" statement* "}"
move_when: _WHEN_KW ":" applies_pred
move_effect: _EFFECT_KW "{" statement* "}"

// A named param-light definition with a typed outcome. Its body runs
// with the enclosing context bound and `produce`s one outcome. Consumed by a
// `produces:` block (see produces_stmt).
define_def: _DEFINE_KW NAME "->" outcome_set "{" statement* "}"
outcome_set: "{" outcome_case ("|" outcome_case)* "}"
outcome_case: NAME ["(" payload_type ("," payload_type)* ")"]
// A payload type, optionally nullable (`Suit?` — Bridge's no-trump strain).
// The collection twin rides here too, so a move type's, a procedure's, a
// rule's, a function's and an outcome case's type slots all teach the same
// placement rather than each meeting the lexer.
payload_type: NAME      -> payload_plain
            | NAME "?"   -> payload_optional
            | NAME "<" NAME ">" -> collection_type_reject
            | NAME "<" NAME ">" "?" -> collection_type_reject

// A rule may declare parameters (`rule NoLeadingSuitUntilBroken(suit: Suit)`),
// making it a template: an `active_rules` reference instantiates it by
// substituting the arguments into the body at resolve time. Parameter domains
// are the enumerable payload types; the resolver gates which are supported.
rule_def: _RULE_KW NAME [rule_params] "{" rule_clause* "}"
rule_params: "(" parameter ("," parameter)* ")"
?rule_clause: constrains
            | applies_when
            | demands
            | if_impossible
            | exempts
constrains: _CONSTRAINS_KW ":" NAME
applies_when: _APPLIES_WHEN_KW ":" applies_pred
?applies_pred: _ALWAYS_KW  -> always
             | expr
demands: _DEMANDS_KW ":" demand_value
?demand_value: actions_where
             | expr
// Cards exempt from this rule: never subject to its obligation, never able to
// satisfy it, and — when the rule constrains a move — offered as candidates
// AFTER every other legal card (rules.legal_cards), regardless of hand
// position. Tarot's Excuse is the corpus's first instance (always playable,
// never bound by follow-suit/trump obligations).
exempts: _EXEMPTS_KW ":" expr
// A predicate over the candidate player move, whose subject is `action`
// (see decisions.md "Rule demand forms"). `action` is the move instance —
// `action.card`, `action.card_count`, `action.amount` — never the zone-transfer
// verb `move`.
actions_where: _ACTIONS_KW _WHERE_KW expr
if_impossible: _IF_IMPOSSIBLE_KW ":" expr

// ----------------------------------------------------------------------------
// Expression sublanguage
// ----------------------------------------------------------------------------

?expr: quantifier
     | if_expr
     | agg_query
     | player_query
     | card_query
     | choose_expr
     | or_expr

// Queries over the player ring. Like the quantifier/comprehension forms, these
// sit at the top of the expression grammar so the `where <pred>` body extends
// as far right as possible (one canonical parse). The predicate is evaluated
// per player with `player` bound to the candidate.
//
// The ring search (`the first player from <seat> where <pred>`) scans one
// inclusive lap of the seat ring from the named start, in the game's
// `direction:`. Its from-slot sits at `sum` level — below the query forms —
// so a query can never absorb the outer `where` (`from players where P`
// reads `players` as a bare NAME); the start expression is evaluated
// OUTSIDE the binder scope, like a comprehension's source.
player_query: _PLAYERS_KW _WHERE_KW expr                          -> players_where
            | _THE_KW _PLAYER_KW _WHERE_KW expr                   -> the_player_where
            | _THE_KW _FIRST_KW _PLAYER_KW _FROM_KW sum _WHERE_KW expr -> the_first_player_from_where
            | _NUMBER_KW _OF_KW _PLAYERS_KW _WHERE_KW expr        -> number_players_where

// Queries over a card zone, the card mirror of the player queries: the
// predicate is evaluated per card with `card` bound to the candidate. The
// bare count form (`number of cards in <zone>`) is the zone-size idiom.
card_query: _CARDS_KW _IN_KW zone_expr _WHERE_KW expr                     -> cq_set
          | _NUMBER_KW _OF_KW _CARDS_KW _IN_KW zone_expr [_WHERE_KW expr] -> cq_count
          | _ANY_KW _CARD_KW _IN_KW zone_expr _WHERE_KW expr              -> cq_any
          | _ALL_KW _CARDS_KW _IN_KW zone_expr _WHERE_KW expr             -> cq_all


// Boolean quantifiers, binder implicit (`player`/`team`/`suit`/`rank` is
// bound per candidate, like `player` in the player queries). Card
// quantification is the card_query `any card in … where` form above.
//
// The `q_*_domain`/`q_*_in` forms are the positional twin (decisions.md
// "Boards and cells"): the BARE forms range a binder over a declared
// position domain (a board's `cell`, an integer `positions {}` name), the
// COLLECTION forms iterate an evaluated `line`/`cell` collection. Their noun
// is the QNOUN terminal, which EXCLUDES the keyword-form nouns
// (player/team/suit/rank) and the card-query nouns (card) with their plurals
// — so `any player where` can only be `q_any_player` and `any card in … where`
// only `cq_any`, never a generic capture (proven at zero ambiguity over the
// corpus in tests/test_grammar_ambiguity.py; the precedence is pinned in
// tests/test_cell_queries.py). Resolve validates the noun against the game's
// declared domains (bare) or the admitted `{line, cell}` set (collection);
// the plural convention (`any` singular, `all`/`number of` plural) is a
// resolve Owner Guard, not a grammar one.
quantifier: _ANY_KW _PLAYER_KW _WHERE_KW expr        -> q_any_player
          | _ALL_KW _PLAYERS_KW _WHERE_KW expr       -> q_all_player
          | _ANY_KW _TEAM_KW _WHERE_KW expr          -> q_any_team
          | _ALL_KW _TEAMS_KW _WHERE_KW expr         -> q_all_team
          | _ANY_KW _SUIT_KW _WHERE_KW expr          -> q_any_suit
          | _ALL_KW _SUITS_KW _WHERE_KW expr         -> q_all_suit
          | _ANY_KW _RANK_KW _WHERE_KW expr          -> q_any_rank
          | _ALL_KW _RANKS_KW _WHERE_KW expr         -> q_all_rank
          | _ANY_KW QNOUN _WHERE_KW expr             -> q_any_domain
          | _ALL_KW QNOUN _WHERE_KW expr             -> q_all_domain
          | _NUMBER_KW _OF_KW QNOUN _WHERE_KW expr   -> q_count_domain
          | _ANY_KW QNOUN _IN_KW expr _WHERE_KW expr -> q_any_in
          | _ALL_KW QNOUN _IN_KW expr _WHERE_KW expr -> q_all_in


// Aggregations in the English register, binder implicitly `card`. The order
// aggregators carry a MANDATORY empty-set default (`or <default>`), so an
// empty (or emptied-by-`where`) zone can never crash the aggregation; the
// default sits below `or_expr` so the `or` unambiguously ends the predicate
// (parenthesize a compound default).
agg_query: _SUM_KW _OF_KW expr _OVER_KW _CARDS_KW _IN_KW zone_expr [_WHERE_KW expr]           -> agg_sum
         | RANK_DIR expr _OVER_KW _CARDS_KW _IN_KW zone_expr [_WHERE_KW expr] _OR_KW and_expr -> agg_order

if_expr: _IF_KW expr _THEN_KW expr elif_clause* _ELSE_KW expr
elif_clause: _ELIF_KW expr _THEN_KW expr

?or_expr: or_expr _OR_KW and_expr   -> or_op
        | and_expr
?and_expr: and_expr _AND_KW not_expr -> and_op
         | not_expr
?not_expr: _NOT_KW not_expr  -> logical_not
         | comparison

// Equality is the word `is` / `is not` (one operator — `a is not b` never
// parses as `a is (not b)`, since `not` sits above the sum level). The
// right-hand keywords `none` and `empty` stay a closed set, dispatched by
// the builder to the absence/emptiness checks; any other operand is plain
// equality. `==`/`!=` are retired: the builder rejects them with the
// replacement spelling.
?comparison: sum _IS_KW _NOT_KW sum -> compare_is_not
           | sum _IS_KW sum         -> compare_is
           | sum comp_op sum        -> compare
           | sum _IN_KW sum         -> membership
           | sum
comp_op: COMP_OP
COMP_OP: "==" | "!=" | ">=" | "<=" | ">" | "<"

?sum: sum "+" term   -> add
    | sum "-" term   -> sub
    | term
// Rounded division (decisions.md "The expression register"): a word-spelled
// term-level operator, the offset_by shape, with the rounding direction
// MANDATORY — there is no bare quotient to misread as exact. Two aliased
// productions rather than one with `(_UP_KW|_DOWN_KW)`: underscore terminals
// are filtered from the tree, so a single production would hand the builder
// identical children for both directions and the direction would be lost.
?term: term _OFFSET_BY_KW factor -> offset_by
     | term _DIVIDED_KW _BY_KW factor _ROUNDED_KW _UP_KW   -> divided_by_rounded_up
     | term _DIVIDED_KW _BY_KW factor _ROUNDED_KW _DOWN_KW -> divided_by_rounded_down
     | factor

// `/` and `%` are retired spellings, the `==`/`!=` mechanism (comparison
// above): the lexer owns the tokens so the builder can reject them with the
// replacement spelling instead of a bare syntax error. `//` is deliberately
// ABSENT: it introduces a comment (LINE_COMMENT below), so under the dynamic
// lexer an operator claim on it either never wins the ambiguity resolution or
// steals genuine comments — `a // b` reads as `a` with the line tail
// commented out, stated in decisions.md and characterized in
// tests/test_divided_by.py.
?factor: factor "*" postfix -> mul
       | factor DIV_OP postfix -> div_symbol
       | postfix
DIV_OP: "/" | "%"

?postfix: postfix "." NAME                     -> member
        | postfix index_expr                   -> subscript
        | primary

arg_list: arg ("," arg)*
?arg: named_arg | expr

?primary: card_literal
        | all_players
        | call
        | struct_lit
        | list_lit
        | INT               -> int_lit
        | "-" INT           -> neg_int_lit
        | STRING            -> str_lit
        | NAME              -> name_ref
        | "(" expr ")"

// A literal collection, for membership tests (`card.suit in [hearts, spades]`).
// At least one element: an empty literal has no use and no element type.
list_lit: "[" expr ("," expr)* "]"

// `TypeName { field: expr, … }` — constructs a user-defined struct value. At
// least one field is required, keeping it distinct from a statement block in
// expression-before-`{` positions (if/repeat/phase).
//
// A struct type may not be spelled with a clause keyword. `NAME "{" NAME ":"
// expr "}"` is token-identical to a single-entry brace clause (`zones { stock :
// Deck }`, `requires { y : Integer }`), so an expression slot left EMPTY —
// `loser:` with no expression, `function f() =` with no body — otherwise reads
// the clause below it as a struct literal, completes, and drops that clause
// with no error and no `_ambig` node for the ambiguity budget to see. Refusing
// the keyword closes every expression slot in the grammar at once, which is why
// this is at the absorbed end rather than at each absorbing one.
//
// The exclusion is in two parts, pinned separately in
// tests/test_game_clause_guards.py:
//
//   1. NAME's OWN lookahead, repeated verbatim. A position-specific terminal
//      may only ever remove spellings: admitting a word NAME refuses would make
//      a type declarable and constructible here but unusable in every type
//      ANNOTATION slot, which is plain NAME
//      (`test_struct_type_name_stays_a_subset_of_name`).
//   2. Every keyword opening a `kw "{" <entry>* "}"` block whose ENTRY begins
//      with NAME — the shape that makes a clause absorbable, wherever in the
//      grammar it is reachable from
//      (`test_struct_type_name_excludes_every_absorbable_clause`). The
//      `?game_item`/`?library_item` keywords beyond that shape are kept as
//      belt-and-braces, not as the completeness argument.
struct_lit: STRUCT_TYPE_NAME "{" field_init ("," field_init)* "}"
field_init: NAME ":" expr
//
// `card_values` — a retired spelling, not a clause — is excluded too: its
// reject production only guards the game_item position, and without the
// exclusion an empty expression slot absorbs `card_values { A: 1 }` as a
// struct literal (the wrong spelling vanishing at parse, resurfacing as a
// wrong-currency unknown-type at resolve). Same absorbable shape, same fix.
STRUCT_TYPE_NAME: /(?!(?:always|all|one|some|jointly|not|is|number|derived|uses|players|direction|cards|card_points|card_values|pieces|board|ranking|trump|trick_order|teams|max_length|positions|zones|state|phase|winner|loser|requires|move_type|rule|type|define|function|procedure|primitives)\b)[a-zA-Z_][a-zA-Z0-9_]*/

card_literal: card_rank _OF_KW NAME
// Ranks and suits are values a game's deck defines, not language keywords: a
// rank is any name or number (A, Q, 10, 2 — or Duke, Mahjong in custom decks),
// checked by the resolver against the deck's Rank enum. Do NOT reserve face
// letters as terminals; that would globally steal A/K/Q/J from every game.
// A rank may not be a game-clause keyword: `card_rank+` is unbounded, so a
// clause spelled as two bare names (`uses <library>`) is otherwise absorbed into
// the enumeration and vanishes silently. Excluded here rather than from NAME so
// `state { uses : Integer }` keeps working. Pinned against `?game_item` by
// tests/test_game_clause_guards.py::test_card_rank_excludes_every_clause_keyword.
card_rank: CARD_RANK_NAME | INT
CARD_RANK_NAME: /(?!(?:always|all|one|some|jointly|not|is|number|uses|players|direction|cards|card_points|card_values|pieces|board|ranking|trump|trick_order|teams|max_length|positions|zones|state|phase|winner|loser|primitives)\b)[a-zA-Z_][a-zA-Z0-9_]*/

// The card-point table's rank-key terminal: `ranking:`'s key position (a NAME
// or a bare INT — the INT arm is on `card_points_key`), carrying NAME's base
// reserved-word exclusions for parity with CARD_RANK_NAME, plus `else` — the
// else row's keyword, which would otherwise also derive as a rank key (a real
// Earley ambiguity; see `card_points_table`). Whole-word: `elsex: 1` stays a
// NAME key and fails as an unknown rank. The clause-keyword exclusions
// CARD_RANK_NAME carries are deliberately absent: the table is brace-bounded,
// so a following clause can never be absorbed into it the way `card_rank+`
// absorbs one.
CARD_POINTS_KEY: /(?!(?:else|always|all|one|some|jointly|not|is|number)\b)[a-zA-Z_][a-zA-Z0-9_]*/

// The Trick Order row-key terminal: NAME's own base reserved-word exclusions
// and nothing else. CARD_POINTS_KEY carries one more -- `else`, because the
// card-point table has an `else:` row that would otherwise derive as a rank
// key too; this block has no such row, so it needs no such exclusion. The
// clause-keyword exclusions CARD_RANK_NAME
// carries are deliberately absent — the block is brace-bounded, so a following
// clause can never be absorbed into it. Which keys are LEGAL is not this
// terminal's question: it matches any identifier and the builder validates
// against `TRICK_ORDER_ROWS`, so the row set is stated once, in the registry,
// and a wrong key gets a rejection that names the rows.
TRICK_ORDER_KEY: /(?!(?:always|all|one|some|jointly|not|is|number)\b)[a-zA-Z_][a-zA-Z0-9_]*/

all_players: _ALL_KW _PLAYERS_KW
call: NAME "(" [arg_list] ")"

// A decision that yields a value (not a card play): pick one element of a
// candidate set via the chooser. The one form the corpus needs so far is an
// integer in an inclusive range (a bid); other domains join corpus-first.
//
// `up to N` declares the static ceiling — the width the OpenSpiel action space
// reserves — for a range whose upper bound is a runtime expression (Oh Hell's
// `0 .. hand_size up to 10`). It is a bare INT literal: a non-literal ceiling
// could never satisfy the static contract. When the upper bound is itself a
// literal (Spades' `0 .. 13`), the ceiling derives from it and the clause is
// omitted; the resolver requires it exactly when it cannot.
//
// `excluding <e>` removes the one value `e` names from the live range before
// the draw (Oh Hell's dealer: `excluding hand_size - total_bid`). It is the
// last clause and takes one `sum`; the clause order is fixed, `up to` before
// `excluding`. One value, not a list: a comma here would collide with the
// call-argument comma.
//
// The form sits at `expr` level beside the query forms, never inside an
// operand chain: its trailing `sum` (the range's `hi`, or the exclusion)
// extends as far right as possible, so `excluding hand_size - total_bid` has
// one derivation, and a choose used as an operator's operand is
// parenthesized — `(choose integer in 0 .. 5) + 1` — the way a bare query is.
choose_expr: _CHOOSE_KW _INTEGER_KW _IN_KW sum ".." sum [_UP_KW _TO_KW INT] [_EXCLUDING_KW sum]  -> choose_integer

index_expr: "[" expr "]"
zone_expr: NAME [index_expr]

// ----------------------------------------------------------------------------
// Terminals
// ----------------------------------------------------------------------------

// EVERY keyword is a whole word. A keyword is written as an anchored `_*_KW`
// terminal rather than a bare string literal in the productions above, because
// the Earley parser runs a DYNAMIC lexer: it matches whichever terminal the
// parser expects at each position, so a bare literal also matches as a PREFIX
// of a longer word and the remainder is absorbed by whatever symbol follows.
// `letx = 3` then parses as `let x = 3` — one parse, no ambiguity node, and a
// reading no reader shares (`=` is not an assignment operator here, and there
// is no expression-statement form, so `letx = 3` cannot mean what it looks
// like). The trailing `(?![A-Za-z0-9_])` refuses that mid-word boundary while
// leaving whole words that merely begin with a keyword — `is_re`, `not_yet`,
// `assets`, `some_var`, `letter` — lexing as single NAMEs. The leading
// underscore keeps Lark's auto-filtering of inline literals from the tree, so
// naming a literal changes nothing else.
//
// The dynamic lexer is not the removable half of that: NAME, QNOUN,
// CARD_RANK_NAME and STRUCT_TYPE_NAME all match the same strings and are
// disambiguated by POSITION, so a context-free lexer — which would take the
// longest match and end the class outright — cannot tokenize this grammar at
// all. Anchoring is the fix that remains.
//
// The property is one line and covers the whole table: no terminal may match a
// word-character-final string when a word character follows. It is pinned over
// Lark's own compiled terminal list by tests/test_keyword_anchoring.py, so a
// literal added to a new production is a red cell rather than a silent member.
// Anchoring is a SEPARATE half from the NAME exclusion below: anchoring stops a
// fused spelling from lexing, exclusion stops a keyword from also reading as a
// value. A keyword needs the first always and the second only where a bare-NAME
// reading would be a real second parse.
_ACTIONS_KW: "actions" /(?![A-Za-z0-9_])/
_ACTIVE_RULES_KW: "active_rules" /(?![A-Za-z0-9_])/
_AFTER_EACH_KW: "after_each" /(?![A-Za-z0-9_])/
_AGAIN_KW: "again" /(?![A-Za-z0-9_])/
_ALL_KW: "all" /(?![A-Za-z0-9_])/
_ALWAYS_KW: "always" /(?![A-Za-z0-9_])/
_AND_KW: "and" /(?![A-Za-z0-9_])/
_ANY_KW: "any" /(?![A-Za-z0-9_])/
_APPLIES_WHEN_KW: "applies_when" /(?![A-Za-z0-9_])/
// `as` excludes `-` as well, which no other keyword needs: without it the `as`
// in `as-equally-as-possible` (dist_clause) matches this keyword. The pair is
// derived rather than listed — tests/test_keyword_anchoring.py scrapes the
// keyword set for a literal that is another's prefix at a hyphen boundary, and
// asserts `as` is the only one.
_AS_KW: "as" /(?![A-Za-z0-9_-])/
_AS_EQUALLY_AS_POSSIBLE_KW: "as-equally-as-possible" /(?![A-Za-z0-9_])/
_BEFORE_EACH_KW: "before_each" /(?![A-Za-z0-9_])/
_BOARD_KW: "board" /(?![A-Za-z0-9_])/
_BY_KW: "by" /(?![A-Za-z0-9_])/
_CARD_KW: "card" /(?![A-Za-z0-9_])/
// The clause keyword and the `card_points(card)` Builtin share one spelling
// deliberately (one name for one concept); the dynamic lexer disambiguates by
// position, the `cards` precedent — so no NAME exclusion, anchoring only.
_CARD_POINTS_KW: "card_points" /(?![A-Za-z0-9_])/
// A retired spelling: exists only for the reject-with-replacement alternative
// of `card_points_table` (never a clause), so the wrong name gets a diagnostic
// naming the fix instead of a bare syntax error.
_CARD_VALUES_KW: "card_values" /(?![A-Za-z0-9_])/
_CARDS_KW: "cards" /(?![A-Za-z0-9_])/
_CHOOSE_KW: "choose" /(?![A-Za-z0-9_])/
_CHOSEN_KW: "chosen" /(?![A-Za-z0-9_])/
_CLIMB_KW: "climb" /(?![A-Za-z0-9_])/
_COMBINATIONS_KW: "combinations" /(?![A-Za-z0-9_])/
_CONSTRAINS_KW: "constrains" /(?![A-Za-z0-9_])/
_CONTINUE_KW: "continue" /(?![A-Za-z0-9_])/
_DEFINE_KW: "define" /(?![A-Za-z0-9_])/
_DEMANDS_KW: "demands" /(?![A-Za-z0-9_])/
_DERIVED_KW: "derived" /(?![A-Za-z0-9_])/
_DIRECTION_KW: "direction" /(?![A-Za-z0-9_])/
_DIVIDED_KW: "divided" /(?![A-Za-z0-9_])/
_DOWN_KW: "down" /(?![A-Za-z0-9_])/
_EACH_KW: "each" /(?![A-Za-z0-9_])/
_EARLY_KW: "early" /(?![A-Za-z0-9_])/
_EFFECT_KW: "effect" /(?![A-Za-z0-9_])/
_ELIF_KW: "elif" /(?![A-Za-z0-9_])/
_ELSE_KW: "else" /(?![A-Za-z0-9_])/
_EXCLUDING_KW: "excluding" /(?![A-Za-z0-9_])/
_EXEMPTS_KW: "exempts" /(?![A-Za-z0-9_])/
_FIRST_KW: "first" /(?![A-Za-z0-9_])/
_FOLLOWS_KW: "follows" /(?![A-Za-z0-9_])/
_FOR_KW: "for" /(?![A-Za-z0-9_])/
_FROM_KW: "from" /(?![A-Za-z0-9_])/
_FUNCTION_KW: "function" /(?![A-Za-z0-9_])/
_GAME_KW: "game" /(?![A-Za-z0-9_])/
_HAND_KW: "hand" /(?![A-Za-z0-9_])/
_IF_KW: "if" /(?![A-Za-z0-9_])/
_IF_IMPOSSIBLE_KW: "if_impossible" /(?![A-Za-z0-9_])/
_IN_KW: "in" /(?![A-Za-z0-9_])/
_INTEGER_KW: "integer" /(?![A-Za-z0-9_])/
_INTO_KW: "into" /(?![A-Za-z0-9_])/
// `is`/`not` were the first two anchored, found as `is_re` lexing as `is` +
// `_re` and `sum is not_ready` as `is not` + `_ready` — the same trap, once as
// a standalone keyword and once as the second word of a keyword pair.
_IS_KW: "is" /(?![A-Za-z0-9_])/
_JOINTLY_KW: "jointly" /(?![A-Za-z0-9_])/
_LEGAL_MOVES_KW: "legal_moves" /(?![A-Za-z0-9_])/
_LET_KW: "let" /(?![A-Za-z0-9_])/
