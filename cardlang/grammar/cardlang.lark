_NOT_KW: "not" /(?![A-Za-z0-9_])/
_NUMBER_KW: "number" /(?![A-Za-z0-9_])/
_OF_KW: "of" /(?![A-Za-z0-9_])/
_OFFER_KW: "offer" /(?![A-Za-z0-9_])/
_OFFERING_KW: "offering" /(?![A-Za-z0-9_])/
_OFFSET_BY_KW: "offset_by" /(?![A-Za-z0-9_])/
