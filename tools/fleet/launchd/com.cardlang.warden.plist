<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cardlang.warden</string>
  <!-- Stub: sync the clone, then exec the freshened wrapper. The exec
       re-reads run-role.sh only after sync, so a wrapper update can
       never corrupt a script mid-run.

       Daily cadence: the operator adds the StartCalendarInterval stanza
       (Hour 8, Minute 10 — the app scheduler's slot, docs/harness.md
       "Standing Roles") before installing; an agent does not install a
       standing schedule on its own authority. Without it the agent is
       kickstart-only:
       launchctl kickstart gui/$UID/com.cardlang.warden -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>cd /Users/benh/Projects/cardlang-fleet &amp;&amp; /usr/bin/git fetch -q origin &amp;&amp; /usr/bin/git checkout -qB main origin/main &amp;&amp; exec ./tools/fleet/run-role.sh warden</string>
  </array>
  <key>StandardOutPath</key><string>/Users/benh/Projects/cardlang-fleet/logs/launchd-warden.out</string>
  <key>StandardErrorPath</key><string>/Users/benh/Projects/cardlang-fleet/logs/launchd-warden.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
